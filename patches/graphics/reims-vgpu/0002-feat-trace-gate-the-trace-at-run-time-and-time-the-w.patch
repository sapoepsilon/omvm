     CLOCK.get().map_or(0, |clock| clock())
 }
 
-/// Whether events are written.
+/// Whether events are written: with the clock and the file, and, where
+/// `REIMS_VGPU_TRACE_GATE` names a path, only while that path exists (looked at every
+/// [`GATE_NS`] at most), so a long-running process can keep the variable set and trace
+/// a window of interest.
 pub fn on() -> bool {
-    CLOCK.get().is_some() && writer().is_some()
+    CLOCK.get().is_some() && writer().is_some() && gate()
+}
+
+/// The environment variable naming the gate file.
+pub const GATE_VAR: &str = "REIMS_VGPU_TRACE_GATE";
+
+/// How often the gate file is looked at, in nanoseconds.
+const GATE_NS: u64 = 200_000_000;
+
+static GATE: OnceLock<Option<std::path::PathBuf>> = OnceLock::new();
+static GATE_OPEN: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static GATE_LOOKED: AtomicU64 = AtomicU64::new(0);
+
+fn gate() -> bool {
+    let Some(path) = GATE
+        .get_or_init(|| std::env::var_os(GATE_VAR).map(Into::into))
+        .as_ref()
+    else {
+        return true;
+    };
+    let t = now();
+    let looked = GATE_LOOKED.load(Ordering::Relaxed);
+    if t.saturating_sub(looked) >= GATE_NS
+        && GATE_LOOKED
+            .compare_exchange(looked, t, Ordering::Relaxed, Ordering::Relaxed)
+            .is_ok()
+    {
+        GATE_OPEN.store(path.exists(), Ordering::Relaxed);
+    }
+    GATE_OPEN.load(Ordering::Relaxed)
+}
+
+/// A setting read at run time from the file `REIMS_VGPU_TUNE` names (`key=value` lines,
+/// read again at most every [`GATE_NS`]): for measuring choices without restarting the
+/// process. `None` without the variable, the file or the key.
+pub fn tune(key: &str) -> Option<String> {
+    static PATH: OnceLock<Option<std::path::PathBuf>> = OnceLock::new();
+    static CACHE: Mutex<(u64, Vec<(String, String)>)> = Mutex::new((0, Vec::new()));
+    let path = PATH
+        .get_or_init(|| std::env::var_os("REIMS_VGPU_TUNE").map(Into::into))
+        .as_ref()?;
+    let t = now();
+    let mut c = CACHE.lock();
+    if c.0 == 0 || t.saturating_sub(c.0) >= GATE_NS {
+        c.0 = t.max(1);
+        c.1 = std::fs::read_to_string(path)
+            .unwrap_or_default()
+            .lines()
+            .filter_map(|l| l.split_once('='))
+            .map(|(k, v)| (k.trim().to_owned(), v.trim().to_owned()))
+            .collect();
+    }
+    c.1.iter().find(|(k, _)| k == key).map(|(_, v)| v.clone())
 }
 
