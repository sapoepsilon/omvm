 /// The present mode of a swapchain over a surface offering `modes` (the module doc): MAILBOX
 /// where offered, else FIFO, which every surface offers.
+/// The present mode `REIMS_VGPU_TUNE`'s `present_mode` names, where the surface offers it.
+fn tuned_present_mode(modes: &[vk::PresentModeKHR]) -> Option<vk::PresentModeKHR> {
+    let mode = match reims_vgpu_core::trace::tune("present_mode")?.as_str() {
+        "mailbox" => vk::PresentModeKHR::MAILBOX,
+        "fifo" => vk::PresentModeKHR::FIFO,
+        "immediate" => vk::PresentModeKHR::IMMEDIATE,
+        "fifo_relaxed" => vk::PresentModeKHR::FIFO_RELAXED,
+        _ => return None,
+    };
+    modes.contains(&mode).then_some(mode)
+}
