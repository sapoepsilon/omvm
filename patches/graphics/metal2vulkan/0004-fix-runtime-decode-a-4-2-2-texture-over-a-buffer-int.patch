diff --git a/crates/metal2vulkan-runtime/src/buffer_texture.rs b/crates/metal2vulkan-runtime/src/buffer_texture.rs
index de542d06..8d8fcb75 100644
--- a/crates/metal2vulkan-runtime/src/buffer_texture.rs
+++ b/crates/metal2vulkan-runtime/src/buffer_texture.rs
@@ -1672,6 +1672,35 @@ pub(super) enum ViewUsage {
     Only { storage: bool },
 }
 
+impl Texels {
+    /// Local (Asahi/Honeykrisp): the texels of a one-slice texture as the buffer's bytes hold
+    /// them now, where the CPU finds them, its rows packed one after another; `None` for bytes
+    /// the CPU does not reach, detached from their pages, or laid out otherwise.
+    pub(super) fn packed_rows(&self) -> Option<Vec<u8>> {
+        let layout = &self.cpu;
+        if self.buffer.detached() || layout.slices != 1 || layout.rows == 0 {
+            return None;
+        }
+        let contents = self.buffer.contents()?;
+        let n = usize::try_from(layout.row_bytes).ok()?;
+        let last = (layout.rows - 1).checked_mul(layout.row_pitch)?;
+        let end = layout.offset.checked_add(last)?.checked_add(layout.row_bytes)?;
+        if end > self.buffer.length() {
+            return None;
+        }
+        let mut packed = vec![0u8; n.checked_mul(usize::try_from(layout.rows).ok()?)?];
+        for (y, row) in packed.chunks_exact_mut(n).enumerate() {
+            let at = (layout.offset + y as u64 * layout.row_pitch) as usize;
+            // SAFETY: the row lies in the buffer's mapped bytes (checked above); a read racing
+            // a write of them is the program's, as through `contents`.
+            unsafe {
+                std::ptr::copy_nonoverlapping(contents.as_ptr().add(at), row.as_mut_ptr(), n);
+            }
+        }
+        Some(packed)
+    }
+}
+
 impl ViewUsage {
     /// The usage a view of [`ViewUsage::Only`] names, or `None` for the buffer's.
     fn named(self) -> Option<vk::BufferUsageFlags2KHR> {
