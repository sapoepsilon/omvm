+            surface: surface.then(|| Mutex::new(None)),
         };
         self.degrade_carried_twin(layout, &decoded, placed(&image));
         image.decoded = Some(Box::new(decoded));
@@ -695,6 +732,52 @@ impl Texture {
         decoded.image.view(&view).map(Some)
     }
 
+    /// Local (Asahi/Honeykrisp): bring the decoded twin of a 4:2:2 texture over a buffer's bytes
+    /// ([`Device::with_surface_twin`]) in step with the bytes, before a sampled view of it is
+    /// bound: the buffer's pairs, read where the CPU finds them, decoded on this thread and
+    /// copied into the twin as its copies go, unless they are the pairs it was last decoded
+    /// from. Nothing for any other texture, nor while the bytes are detached or out of the
+    /// CPU's reach (the twin keeps its texels).
+    pub(super) fn refresh_surface_twin(&self) -> Result<(), Error> {
+        let Storage::Shadow { image, texels, .. } = &self.0.storage else {
+            return Ok(());
+        };
+        let Some(decoded) = image.decoded.as_deref() else {
+            return Ok(());
+        };
+        let Some(last) = decoded.surface.as_ref() else {
+            return Ok(());
+        };
+        let Some(pairs) = texels.packed_rows() else {
+            return Ok(());
+        };
+        let mut last = lock(last);
+        if last.as_deref() == Some(&pairs[..]) {
+            return Ok(());
+        }
+        let plan = image.plan();
+        let region = ImageRegion {
+            aspect: ImageAspectFlags::COLOR,
+            level: 0,
+            layer: 0,
+            layers: 1,
+            origin: [0, 0, 0],
+            size: [plan.extent[0], plan.extent[1], 1],
+        };
+        image.write_decoded(decoded, &region, Some(&pairs))?;
+        static SHOWN: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+        if !SHOWN.swap(true, std::sync::atomic::Ordering::Relaxed) {
+            eprintln!(
+                "metal2vulkan: a {:?} texture of {}x{} over a buffer: its sampled views read a \
+                 decoded twin, decoded on the CPU from the buffer's bytes at each bind that finds \
+                 them changed",
+                plan.pixel_format, plan.extent[0], plan.extent[1]
+            );
+        }
+        *last = Some(pairs);
+        Ok(())
+    }
+
     /// Whether the texture's texels are held in an image with a decoded twin
     /// ([`decoding_image`](Self::decoding_image)).
     pub(crate) fn has_decoded_twin(&self) -> bool {
@@ -1421,6 +1504,7 @@ impl Image {
             started_on_the_cpu: false,
             made_for: (layout, own),
             pairs: None,
+            surface: None,
         };
         let mut viewed = layout;
         viewed.pixel_format = pf;
