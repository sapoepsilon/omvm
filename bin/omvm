#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# omvm: run macOS guest VMs under KVM on Omarchy (Apple Silicon), built on
# aquarat/apple-macos-arm64-vm-guest. Ships no Apple software: the boot ROM
# (AVPBooter), restore image (IPSW) and Xcode come from the user's own Mac.
#
#   omvm helpers status NAME | install-hook  Linux Apple Account helper readiness
#   omvm doctor                 check this host
#   omvm kernel build|install|default|revert
#   omvm qemu build             build the vmapple QEMU fork
#   omvm macos-step             stage the one-time macOS script on the ESP
#   omvm ingest                 import the VM restored in macOS (VMXFER)
#   omvm setup [--xcode]        create account/SSH, headless layer, Xcode
#   omvm run [IMAGE] -- CMD     run CMD in a throwaway guest (SSH)
#   omvm start|stop|restart|pause|resume NAME (virt) | start NAME IMAGE | ssh NAME | list | images
#   omvm gui NAME [IMAGE]       desktop over VNC (paravirtual GPU on the host GPU);
#                               RESOLUTION=WxH[@PPI] picks the first mode
#   omvm virt NAME [IMAGE]      persistent VM managed in virt-manager (libvirt)
#   omvm mode [local|remote] [NAME]  show or switch a virt VM's display: a window on
#                               this screen (local) or VNC + Sunshine (remote, default)
#   omvm perf [always|ac|off]   show or set the CPU governor for local-mode VMs: performance
#                               always (default), only on AC power, or never
#   omvm show [NAME]            bring the VM to the front (its window or a VNC viewer),
#                               starting it if needed; Ctrl+Alt+M and "macOS" in the launcher
#   omvm clip NAME [off]        share the text clipboard with the host (on with gui)
#   omvm res NAME [WxH]         show or change the desktop size (or resize the viewer)
#   omvm remote start|stop|...  control this laptop and its VMs from Moonlight
#   omvm usb list|attach|detach|trust  hot-plug a host USB device (BUS-PORT, VID:PID or
#                               name) into a running VM; trust pairs an attached iPhone
set -euo pipefail

VERSION=0.1.0
UPSTREAM_URL="${OMVM_UPSTREAM_URL:-https://github.com/aquarat/apple-macos-arm64-vm-guest.git}"
UPSTREAM_REF="${OMVM_UPSTREAM_REF:-2ec3cb8745e81c368276852b0a2a8688875e5325}"
PKGS_URL="${OMVM_PKGS_URL:-https://github.com/omacom/omarchy-pkgs.git}"
AURORA_URL="${OMVM_AURORA_URL:-https://github.com/omacom/linux-aurora.git}"
DATA="${OMVM_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/omvm}"
UPSTREAM="${OMVM_UPSTREAM:-$DATA/upstream}"
IMAGES="${OMVM_IMAGES:-$DATA/images}"
KEY="${OMVM_KEY:-$HOME/.ssh/omvm_ed25519}"
# The guest account omvm logs in as. Upstream's create-account.sh names it aquarat
# unless told otherwise; set OMVM_GUEST_USER before `omvm setup` (or after renaming
# the account) and keep it in ~/.config/omvm/gui.env, which services also read.
cfg_env() { sed -n "s/^$1=//p" "${XDG_CONFIG_HOME:-$HOME/.config}/omvm/gui.env" 2>/dev/null | tail -1 || true; }
GUEST_USER="${OMVM_GUEST_USER:-$(cfg_env OMVM_GUEST_USER)}"; GUEST_USER="${GUEST_USER:-aquarat}"
OMVM_VM="${OMVM_VM:-$(cfg_env OMVM_VM)}"
SHARE="${OMVM_SHARE:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../share" && pwd)}"
BUNDLE=tahoe-26.4-25E246
KPKG=linux-aurora-vmapple

c_b=$'\e[1m'; c_g=$'\e[32m'; c_r=$'\e[31m'; c_y=$'\e[33m'; c_0=$'\e[0m'
[ -t 1 ] || { c_b=; c_g=; c_r=; c_y=; c_0=; }
say()  { printf '%s==>%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$c_g" "$c_0" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$c_r" "$c_0" "$*"; }
warn() { printf '  %s!%s %s\n' "$c_y" "$c_0" "$*"; }
die()  { printf '%serror:%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing '$1' (sudo pacman -S --needed $2)"; }

ssh_opts=(-i "$KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=no
          -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)

upstream() {
    if ! test -d "$UPSTREAM/.git"; then
        say "fetching $UPSTREAM_URL"
        git clone -q "$UPSTREAM_URL" "$UPSTREAM"
    fi
    git -C "$UPSTREAM" cat-file -e "$UPSTREAM_REF^{commit}" 2>/dev/null || git -C "$UPSTREAM" fetch -q origin
    git -C "$UPSTREAM" checkout -q "$UPSTREAM_REF"
}

latest_image() { ls -d "$IMAGES/$BUNDLE"-v* 2>/dev/null | sort -V | tail -1; }

guest_env() {
    local booter
    # The 27-era AVPBooter (AVPBooter.vmapple2.macos27*) is only for macOS 27 guests (cmd_virt).
    booter="$(ls "$UPSTREAM"/artifacts/firmware/AVPBooter.vmapple2.*.bin 2>/dev/null | grep -v '/AVPBooter\.vmapple2\.macos27' | head -1 || true)"
    test -n "$booter" || die "no AVPBooter yet: run 'omvm ingest'"
    export AVPBOOTER="$booter" RUNNER_KEY="$KEY" GFX="${GFX:-none}"
}

# ---------------------------------------------------------------- doctor
cmd_doctor() {
    local fails=0
    say "omvm $VERSION host check"
    if [ "$(uname -m)" = aarch64 ] && grep -qs 'apple,arm-platform' /proc/device-tree/compatible; then
        ok "Apple Silicon: $(tr '\0' ' ' </proc/device-tree/compatible | awk '{print $2}')"
    else bad "not an Apple Silicon Mac running Linux"; fails=1; fi
    if pacman -Q linux-aurora >/dev/null 2>&1; then ok "Omarchy kernel: $(pacman -Q linux-aurora)"
    else warn "linux-aurora not installed (non-Omarchy hosts: build the kernel yourself)"; fi
    [ "$(getconf PAGESIZE)" = 16384 ] && ok "16K pages" || { bad "need a 16K-page kernel"; fails=1; }
    { [ -r /dev/kvm ] && [ -w /dev/kvm ]; } && ok "/dev/kvm accessible" || { bad "no /dev/kvm access"; fails=1; }
    if [ -e /sys/module/kvm/parameters/emulate_nisv_ldst ]; then ok "running the patched kernel ($(uname -r))"
    elif pacman -Q "$KPKG" >/dev/null 2>&1; then warn "$KPKG installed but not booted: reboot into it"
    else bad "macOS-guest KVM patches missing: omvm kernel build && omvm kernel install"; fails=1; fi
    local q="$UPSTREAM/build/qemu-fleet/vendor/qemu/build/qemu-system-aarch64"
    [ -x "$q" ] && ok "QEMU fork built" || { bad "QEMU fork missing: omvm qemu build"; fails=1; }
    ls "$UPSTREAM"/artifacts/firmware/AVPBooter.vmapple2.*.bin >/dev/null 2>&1 && ok "AVPBooter present (user-supplied)" \
        || warn "no AVPBooter yet (omvm macos-step, then omvm ingest)"
    local img; img="$(latest_image)"
    [ -n "$img" ] && ok "guest image: $(basename "$img")" || warn "no guest image yet"
    for t in gdb socat python3 zstd; do command -v $t >/dev/null || { bad "missing $t"; fails=1; }; done
    return $fails
}

# ---------------------------------------------------------------- kernel
aurora_commit_for() {   # $1 = installed linux-aurora version, e.g. 7.2.11.aurora14-1
    local rel="${1#*.aurora}"; rel="${rel%%-*}"
    local pk="$DATA/omarchy-pkgs"
    test -d "$pk/.git" || git clone -q "$PKGS_URL" "$pk"
    git -C "$pk" fetch -q origin
    local c
    for c in $(git -C "$pk" log --format=%H origin/HEAD -- pkgbuilds/linux-aurora/PKGBUILD); do
        if git -C "$pk" show "$c:pkgbuilds/linux-aurora/PKGBUILD" | grep -qx "_aurorarel=$rel"; then
            echo "$c"; return 0
        fi
    done
    return 1
}

cmd_kernel() {
    case "${1:-}" in
    build)
        need makepkg base-devel; need git git
        upstream
        local inst pk_commit dir
        inst="$(pacman -Q linux-aurora | awk '{print $2}')" || die "linux-aurora not installed"
        say "matching the installed linux-aurora $inst"
        pk_commit="$(aurora_commit_for "$inst")" || die "cannot find PKGBUILD for $inst in omarchy-pkgs"
        dir="$DATA/kernel"; rm -rf "$dir"; mkdir -p "$dir"
        git -C "$DATA/omarchy-pkgs" archive "$pk_commit" pkgbuilds/linux-aurora | tar -x -C "$dir" --strip-components=2
        cat "$UPSTREAM"/patches/linux-7.1.13-vmapple-pac-vmkey.patch "$UPSTREAM"/patches/linux-7.1.13-kvm-nisv-ldst.patch > "$dir/vmapple-kvm.patch"
        python3 - "$dir/PKGBUILD" "$dir/vmapple-kvm.patch" <<'PY'
import sys, re, hashlib
p, patch = sys.argv[1], sys.argv[2]
s = open(p).read()
sha = hashlib.sha256(open(patch, 'rb').read()).hexdigest()
s = re.sub(r'^_aurorarel=(\S+)$', r'_aurorarel=\1vmapple', s, count=1, flags=re.M)
s = s.replace('pkgbase=linux-aurora\n', 'pkgbase=linux-aurora-vmapple\n', 1)
s = re.sub(r'(source=\([^)]*?)\)', r'\1 vmapple-kvm.patch)', s, count=1, flags=re.S)
s = re.sub(r"(sha256sums=\([^)]*?)\)", r"\1\n            '%s')" % sha, s, count=1, flags=re.S)
s = re.sub(r'  provides=\(WIREGUARD-MODULE linux-asahi=\$\{pkgver\}\)\n  conflicts=\(linux-asahi\)\n',
           '  provides=(WIREGUARD-MODULE)\n', s)
s = s.replace('"$pkgdir/usr/lib/linux-aurora/extract-mesa-calibration"', '"$pkgdir/usr/lib/$pkgbase/extract-mesa-calibration"')
s = s.replace('pkgname=("$pkgbase" "$pkgbase-headers")', 'pkgname=("$pkgbase")')
for must in ('vmapple-kvm.patch)', 'pkgbase=linux-aurora-vmapple', 'vmapple\n'):
    assert must in s, must
open(p, 'w').write(s)
PY
        say "installing build dependencies"
        sudo pacman -S --needed --noconfirm base-devel bc dtc kmod libelf pahole cpio perl rustup clang llvm lld clang18 llvm18 lld18 tar xz xmlto python git patch
        say "building $KPKG (30-60 min)"
        (cd "$dir" && makepkg -f --noconfirm) || die "kernel build failed (see $dir)"
        ls "$dir"/$KPKG-*.pkg.tar.*
        ;;
    install)
        local pkg; pkg="$(ls "$DATA"/kernel/$KPKG-*.pkg.tar.* 2>/dev/null | tail -1)"
        test -n "$pkg" || die "build it first: omvm kernel build"
        say "pinning m1n1 device trees to the stock kernel"
        if ! grep -q 'omvm:' /etc/default/update-m1n1 2>/dev/null; then
            sudo cp /etc/default/update-m1n1 /etc/default/update-m1n1.pre-omvm
            sudo tee -a /etc/default/update-m1n1 >/dev/null <<'EOF'

# omvm: m1n1's device trees always come from the newest stock kernel, never
# linux-aurora-vmapple. Remove this block (and the kernel) to undo.
_stock_mods="$(/bin/ls -d /lib/modules/*-ARCH | grep -v vmapple | sort -rV | head -1)"
if [ -n "$_stock_mods" ]; then DTBS="$_stock_mods/dtbs/*.dtb"; fi
EOF
        fi
        sudo pacman -U --noconfirm "$pkg"
        sudo omarchy-apple-silicon-boot-check || warn "boot check reported a problem (see above)"
        ok "installed; pick '$KPKG' in Limine, or run: omvm kernel default"
        ;;
    default)
        grep -q "^BOOT_ORDER=\"$KPKG," /etc/default/limine && { ok "already default"; return; }
        sudo cp /etc/default/limine /etc/default/limine.pre-omvm
        sudo sed -i "s/^BOOT_ORDER=\"/BOOT_ORDER=\"$KPKG, /" /etc/default/limine
        sudo limine-update >/dev/null && ok "$KPKG is now the default Limine entry (stock kernel stays in the menu)"
        warn "run 'omarchy update' from the stock kernel: its boot check expects linux-aurora"
        ;;
    revert)
        test -f /etc/default/limine.pre-omvm && sudo cp /etc/default/limine.pre-omvm /etc/default/limine && sudo limine-update >/dev/null
        ok "stock linux-aurora is the default again (remove the kernel with: sudo pacman -R $KPKG)"
        ;;
    *) die "usage: omvm kernel build|install|default|revert" ;;
    esac
}

# ---------------------------------------------------------------- qemu
cmd_qemu() {
    [ "${1:-}" = build ] || die "usage: omvm qemu build"
    upstream
    sudo pacman -S --needed --noconfirm git rustup ninja meson glib2 pixman gtk3 vulkan-icd-loader vulkan-headers \
        libslirp dtc zlib libepoxy wayland libxkbcommon gnutls nettle gdb socat python-distlib qemu-img zstd
    rustup default >/dev/null 2>&1 || rustup default stable
    (cd "$UPSTREAM" && scripts/build-qemu.sh) && (cd "$UPSTREAM" && scripts/check-host.sh)
}

# ---------------------------------------------------------------- macOS step
cmd_macos_step() {
    sudo mkdir -p /boot/efi/omvm
    sudo cp "$SHARE/run-on-macos.sh" /boot/efi/omvm/run-on-macos.sh
    local label; label="$(lsblk -rno LABEL "$(findmnt -no SOURCE /boot/efi)" | sed 's/\\x20/ /g')"
    cat <<EOF
${c_b}The one-time macOS step${c_0} (restores the VM with Apple's own Virtualization
framework; Linux cannot do this part, and Linux cannot read macOS's encrypted disk).

1. Boot macOS once:     sudo asahi-bless --set-boot-macos --next -y && sudo systemctl reboot
2. In macOS Terminal:   sudo diskutil mount "$label" && bash "/Volumes/$label/omvm/run-on-macos.sh"
   It shrinks macOS to (used + 100 GB), creates an exFAT partition VMXFER, downloads
   Apple's restore image from Apple, restores the VM, copies your installed Xcode.app,
   then reboots back here (asks before resizing anything).
3. Back in Omarchy:     omvm ingest && omvm setup --xcode
EOF
}

# ---------------------------------------------------------------- ingest
cmd_ingest() {
    upstream
    OMVM_ART="$IMAGES" OMVM_REPO="$UPSTREAM" OMVM_ENVF="$DATA/vm.env" bash "$SHARE/ingest-vmxfer.sh"
}

# ---------------------------------------------------------------- setup
cmd_setup() {
    upstream; guest_env
    test -f "$KEY" || ssh-keygen -q -t ed25519 -N '' -C omvm -f "$KEY"
    local src="$IMAGES/$BUNDLE-restore" v0="$IMAGES/$BUNDLE-v0" v1="$IMAGES/$BUNDLE-v1" v2="$IMAGES/$BUNDLE-v2"
    test -d "$src" || die "no restored bundle: run 'omvm ingest' first"
    test -e /sys/module/kvm/parameters/emulate_nisv_ldst || die "boot the patched kernel first (omvm doctor)"
    if ! test -d "$v0"; then
        local pwf="$DATA/guest-password"
        (umask 077; test -f "$pwf" || python3 -c 'import secrets;print(secrets.token_urlsafe(18))' > "$pwf")
        say "creating guest account '$GUEST_USER' + SSH (single-user boot, ~3 min); password in $pwf"
        (cd "$UPSTREAM" && GUEST_USER="$GUEST_USER" GUEST_PASSWORD="$(cat "$pwf")" images/host/create-account.sh "$src" "$v0" "$KEY.pub")
    fi
    if ! test -d "$v1"; then
        say "headless settings + Command Line Tools (~5 min)"
        local tz; tz="$(timedatectl show -p Timezone --value 2>/dev/null || echo UTC)"
        (cd "$UPSTREAM" && scripts/bake-golden.sh "$v0" "$v1" "headless settings, CLT, TZ $tz" \
            "env CLT_VERSION=any GUEST_TZ=$tz bash -s" < images/10-headless-clt.sh)
    fi
    if [ "${1:-}" = --xcode ] && ! test -d "$v2"; then
        test -f "$IMAGES/Xcode.dmg" || die "no Xcode.dmg (the macOS step copies your installed Xcode.app)"
        say "installing Xcode (~15 min)"
        OMVM_REPO="$UPSTREAM" GUEST_USER="$GUEST_USER" bash "$SHARE/bake-xcode-dmg.sh" "$v1" "$v2" "$IMAGES/Xcode.dmg"
    fi
    ok "ready: omvm run -- 'sw_vers; xcodebuild -version'"
}

# ---------------------------------------------------------------- run/start/ssh/stop
resolve_image() { local i="${1:-}"; [ -z "$i" ] && i="$(latest_image)"; [ -d "$i" ] || i="$IMAGES/$i"; [ -d "$i" ] || die "no such image: ${1:-<none>}"; echo "$i"; }

cmd_run() {
    upstream; guest_env
    local img=""; [ "${1:-}" != -- ] && { img="$1"; shift; }; [ "${1:-}" = -- ] && shift
    [ $# -gt 0 ] || die "usage: omvm run [IMAGE] -- COMMAND"
    img="$(resolve_image "$img")"
    (cd "$UPSTREAM" && GOLDEN="$img" CPUS="${CPUS:-8}" RAM="${RAM:-16G}" scripts/vm-job.sh "$*")
}

port_of() { cat "$UPSTREAM/artifacts/runs/$1/ssh_port" 2>/dev/null || cat "$IMAGES/vms/$1/ssh_port" 2>/dev/null || die "no VM '$1'"; }

cmd_start() {
    if [ $# = 1 ] && is_virt "$1"; then cmd_power start "$1"; return; fi
    upstream; guest_env
    local name="${1:?usage: omvm start NAME [IMAGE]}" img; img="$(resolve_image "${2:-}")"
    local port; port="$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1])')"
    (cd "$UPSTREAM" && GOLDEN="$img" SSH_PORT="$port" INJECT=0 CPUS="${CPUS:-8}" RAM="${RAM:-16G}" scripts/vm-run.sh start "$name")
    echo "$port" > "$UPSTREAM/artifacts/runs/$name/ssh_port"
    for _ in $(seq 1 90); do timeout 5 ssh -n "${ssh_opts[@]}" -p "$port" "$GUEST_USER@127.0.0.1" true 2>/dev/null && break; sleep 2; done
    ok "$name is up: omvm ssh $name   (stop: omvm stop $name; changes are discarded on stop)"
}

cmd_ssh()  { local n="${1:?usage: omvm ssh NAME}"; shift; exec ssh "${ssh_opts[@]}" -p "$(port_of "$n")" "$GUEST_USER@127.0.0.1" "$@"; }

cmd_stop() {
    if [ $# = 1 ] && is_virt "$1"; then cmd_power stop "$1"; return; fi
    local n="${1:?usage: omvm stop NAME}" run="$UPSTREAM/artifacts/runs/$1"
    clip_stop "$n"
    ssh -n "${ssh_opts[@]}" -p "$(port_of "$n")" "$GUEST_USER@127.0.0.1" 'sudo -n shutdown -h now' >/dev/null 2>&1 || true
    for _ in $(seq 1 60); do kill -0 "$(cat "$run/launcher.pid" 2>/dev/null)" 2>/dev/null || break; sleep 1; done
    (cd "$UPSTREAM" && scripts/vm-run.sh quit "$n") >/dev/null 2>&1 || true
    rm -rf "$run"; ok "stopped $n"
}

# ---------------------------------------------------------------- virt power
# start|stop|restart|pause|resume for libvirt VMs (omvm virt). Stop holds off the
# watchdog (omvm-vm@NAME.timer), which would start the VM again within a minute;
# start turns it back on. Pause keeps the guest in memory (virsh suspend).
is_virt() { [ ! -d "$UPSTREAM/artifacts/runs/$1" ] && command -v virsh >/dev/null &&
            virsh -q -c qemu:///session dominfo "$1" >/dev/null 2>&1; }
cmd_power() { # start|stop|restart|pause|resume NAME
    local verb="$1" n="${2:-${OMVM_VM:-macos}}" s
    is_virt "$n" || die "no libvirt VM '$n' (omvm virt $n)"
    s="$("${VIRSH[@]}" domstate "$n")"
    case "$verb" in
    start)
        case "$s" in
        running) ok "$n is already running" ;;
        paused) "${VIRSH[@]}" resume "$n" >/dev/null; ok "$n resumed" ;;
        *) "${VIRSH[@]}" start "$n" >/dev/null; ok "$n started ($(vm_mode "$n") mode)" ;;
        esac
        systemctl --user start "omvm-vm@$n.timer" 2>/dev/null || true ;;
    stop)
        systemctl --user stop "omvm-vm@$n.timer" "omvm-vm@$n.service" 2>/dev/null || true
        if [ "$s" = paused ]; then "${VIRSH[@]}" resume "$n" >/dev/null; fi  # paused guests can't shut down
        vm_shutdown "$n"
        ok "$n: watchdog off until omvm start $n" ;;
    restart) cmd_power stop "$n"; cmd_power start "$n" ;;
    pause)
        [ "$s" = running ] || die "$n is $s, not running"
        "${VIRSH[@]}" suspend "$n" >/dev/null; ok "$n paused (omvm resume $n)" ;;
    resume)
        [ "$s" = paused ] || die "$n is $s, not paused"
        "${VIRSH[@]}" resume "$n" >/dev/null; ok "$n resumed" ;;
    *) die "usage: omvm start|stop|restart|pause|resume NAME" ;;
    esac
}

cmd_gui() {
    # Paravirtual GPU (Reims, out of process) on the host GPU + QEMU VNC.
    upstream
    local name="${1:?usage: omvm gui NAME [IMAGE]}" img; img="$(resolve_image "${2:-}")"
    local oop="$UPSTREAM/build/qemu-oop"
    if ! test -x "$oop/qemu/build/qemu-system-aarch64" || ! test -x "$oop/reims/target/release/reims-vgpu-backend"; then
        say "building the GPU-path QEMU + Reims backend (once, ~15 min)"
        (cd "$UPSTREAM" && MODE=oop scripts/build-qemu.sh) >/dev/null
    fi
    local icd="${VK_DRIVER_FILES:-}"
    if [ -z "$icd" ]; then
        icd="$HOME/opt/mesa-honeykrisp/share/vulkan/icd.d/asahi_icd.aarch64.json"   # patched Mesa (best)
        [ -f "$icd" ] || icd=/usr/share/vulkan/icd.d/asahi_icd.aarch64.json       # Omarchy's Mesa
    fi
    local disp="${VNC_DISPLAY:-}"
    if [ -z "$disp" ]; then for disp in $(seq 10 40); do ss -ltn | grep -q ":$((5900+disp)) " || break; done; fi
    local port; port="$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1])')"
    export GFX=reims; guest_env
    # Upstream reims-vgpu stack (in-process apple-gfx-mmio + interlock-patched Honeykrisp):
    # renders the desktop without artifacts. See docs/graphics.md.
    local sb="$UPSTREAM/build/qemu-sb/build" sbicd="$HOME/opt/mesa-honeykrisp-sb/share/vulkan/icd.d/asahi_icd.aarch64.json"
    if [ "${OMVM_GFX_STACK:-sb}" = sb ] && [ -x "$sb/qemu-system-aarch64" ] && [ -f "$sbicd" ]; then
        # OMVM_MODE=local: reims-vgpu's own window on this screen instead of VNC (see omvm mode)
        local window=0 view="-vnc 127.0.0.1:$disp" res="${RESOLUTION:-}"
        if [ "${OMVM_MODE:-remote}" = local ]; then
            window=1 view=""; [ -n "$res" ] || res="$(local_screen | cut -d' ' -f1)"
            export REIMS_VGPU_WINDOW_REFRESH="${REIMS_VGPU_WINDOW_REFRESH:-$(local_screen | cut -d' ' -f2)}" REIMS_VGPU_WINDOW_BORDERLESS=1
        fi
        (cd "$UPSTREAM" && GOLDEN="$img" SSH_PORT="$port" INJECT=0 CPUS="${CPUS:-8}" RAM="${RAM:-16G}" \
            REIMS_VGPU_WINDOW=$window VK_DRIVER_FILES="${VK_DRIVER_FILES:-$sbicd}" QEMU_BIN="$sb/qemu-system-aarch64" \
            QEMU_EXTRA_ARGS="-L $sb/qemu-bundle/usr/local/share/qemu -machine aux-ram-share=on $view${res:+ -global apple-gfx-mmio.resolution=$res}" \
            scripts/vm-run.sh start "$name")
        echo "$port" > "$UPSTREAM/artifacts/runs/$name/ssh_port"
        if [ "$window" = 1 ]; then
            ok "$name: window on this screen at $res (login window in ~40 s), SSH: omvm ssh $name"
            return
        fi
        echo "$disp" > "$UPSTREAM/artifacts/runs/$name/vnc_display"
        ok "$name: VNC on 127.0.0.1:$((5900+disp)) at ${RESOLUTION:-1920x1080} (login window in ~40 s), SSH: omvm ssh $name"
        echo "    viewer:  vncviewer -Shared=1 127.0.0.1:$((5900+disp))   (the desktop follows its window, or: omvm res $name WxH)"
        follow_start "$name"
        return
    fi
    (cd "$UPSTREAM" && GOLDEN="$img" SSH_PORT="$port" INJECT=0 CPUS="${CPUS:-8}" RAM="${RAM:-16G}" \
        VK_DRIVER_FILES="$icd" QEMU_BIN="$oop/qemu/build/qemu-system-aarch64" \
        GPU_BACKEND_BIN="$oop/reims/target/release/reims-vgpu-backend" \
        QEMU_EXTRA_ARGS="-L $oop/qemu/build/qemu-bundle/usr/local/share/qemu -vnc 127.0.0.1:$disp" \
        scripts/vm-run.sh start "$name")
    echo "$port" > "$UPSTREAM/artifacts/runs/$name/ssh_port"
    echo "$disp" > "$UPSTREAM/artifacts/runs/$name/vnc_display"
    ok "$name: VNC on 127.0.0.1:$((5900+disp)) (login window in ~40 s), SSH: omvm ssh $name"
    echo "    viewer:  vncviewer 127.0.0.1:$((5900+disp))   (stop: omvm stop $name)"
}

# The guest's LaunchAgent that keeps the desktop at the size the VNC viewer asks for
# (share/omvm-display-follow.*): installed over SSH once the guest is up, in the background.
# A VM's state directory: a throwaway run, or a persistent (virt) VM.
run_dir() {
    local d="$UPSTREAM/artifacts/runs/$1"
    [ -d "$d" ] || d="$IMAGES/vms/$1"
    mkdir -p "$d/logs"; echo "$d"
}

follow_start() {
    [ "${OMVM_DISPLAY_FOLLOW:-1}" = 1 ] || return 0
    local n="$1" run port; run="$(run_dir "$1")"; port="$(port_of "$1")"
    setsid nohup bash -c '
        ssh=(ssh "${@:4}" -p "$1" "$3@127.0.0.1")
        for _ in $(seq 120); do "${ssh[@]}" true 2>/dev/null && break; sleep 5; done
        "${ssh[@]}" "mkdir -p ~/Library/omvm && cat > ~/Library/omvm/omvm-display-follow.swift.new &&
            { cmp -s ~/Library/omvm/omvm-display-follow.swift.new ~/Library/omvm/omvm-display-follow.swift &&
              rm ~/Library/omvm/omvm-display-follow.swift.new ||
              mv ~/Library/omvm/omvm-display-follow.swift.new ~/Library/omvm/omvm-display-follow.swift; }" \
            < "$2/omvm-display-follow.swift" &&
        "${ssh[@]}" bash -s < "$2/omvm-display-follow.sh"
    ' _ "$port" "$SHARE" "$GUEST_USER" "${ssh_opts[@]}" >"$run/logs/display-follow.log" 2>&1 </dev/null &
}

# Two-way text clipboard with the host (Wayland), over SSH; runs until the VM stops.
clip_start() {
    local n="$1" run; run="$(run_dir "$1")"
    command -v wl-paste >/dev/null || { warn "no wl-clipboard: clipboard sharing off"; return 0; }
    clip_stop "$n"
    setsid nohup python3 "$SHARE/omvm-clip.py" "$(port_of "$n")" "$KEY" "$GUEST_USER" >"$run/logs/clip.log" 2>&1 </dev/null &
    echo $! > "$run/clip.pid"
}
clip_stop() {
    local f pid; f="$(run_dir "$1")/clip.pid"
    pid="$(cat "$f" 2>/dev/null)" || return 0
    # Only our bridge: after a host reboot the PID may belong to something else.
    if { tr '\0' ' ' < "/proc/$pid/cmdline"; } 2>/dev/null | grep -q omvm-clip; then kill "$pid" 2>/dev/null || true; fi
    rm -f "$f"
}
cmd_clip() {
    local n="${1:?usage: omvm clip NAME [off]}"
    if [ "${2:-}" = off ]; then clip_stop "$n"; ok "$n: clipboard sharing off"; else clip_start "$n"; ok "$n: clipboard shared with the host"; fi
}

# A persistent VM managed by libvirt (qemu:///session): shows up in virt-manager,
# which starts/stops it and shows its screen. Disk lives in $IMAGES/vms/NAME.
cmd_virt() {
    upstream
    local name="${1:?usage: omvm virt NAME [IMAGE] | omvm virt rm NAME}" img
    if [ "$name" = rm ]; then
        name="${2:?usage: omvm virt rm NAME}"
        virsh -q -c qemu:///session destroy "$name" >/dev/null 2>&1 || true
        virsh -q -c qemu:///session undefine "$name" >/dev/null && ok "removed $name from libvirt (disk kept in $IMAGES/vms/$name)"
        return
    fi
    command -v virsh >/dev/null || die "install libvirt and virt-manager first: omarchy pkg add libvirt virt-manager"
    img="$(resolve_image "${2:-}")"
    local qemu="$UPSTREAM/build/qemu-sb/build/qemu-system-aarch64" dir="$IMAGES/vms/$name" port major
    # macOS 27 guests ($dir/guest_major >= 27) need the 27-patched QEMU (0005-0007) and
    # the 27-era AVPBooter; see docs/graphics.md "macOS 27 updates".
    major="$(cat "$dir/guest_major" 2>/dev/null || echo 0)"
    [ "${major:-0}" -ge 27 ] 2>/dev/null && qemu="${OMVM_QEMU27:-$UPSTREAM/build/qemu-sb-bdifw/build/qemu-system-aarch64}"
    [ -x "$qemu" ] || die "build the graphics stack first (docs/graphics.md): no $qemu"
    if [ ! -f "$dir/disk.img" ]; then
        mkdir -p "$dir"
        for f in disk.img aux.img.trimmed vm.json; do cp --reflink=auto "$img/guest/$f" "$dir/$f"; chmod u+w "$dir/$f"; done
        ok "$name: disk cloned from $(basename "$img")"
    fi
    port="$(cat "$dir/ssh_port" 2>/dev/null || python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1])')"
    echo "$port" > "$dir/ssh_port"
    guest_env
    if [ "${major:-0}" -ge 27 ] 2>/dev/null; then
        AVPBOOTER="${OMVM_AVPBOOTER27:-$UPSTREAM/artifacts/firmware/AVPBooter.vmapple2.macos27.2-26B123.bin}"
        [ -f "$AVPBOOTER" ] || die "macOS $major guest needs the 27-era AVPBooter: no $AVPBOOTER"
    fi
    local was; was="$(vm_mode "$name" 2>/dev/null || echo remote)"
    python3 "$SHARE/libvirt-domain.py" "$name" "$dir" "$qemu" "$AVPBOOTER" \
        "$("$UPSTREAM/scripts/extract-ecid.py" "$dir/vm.json")" "$port" "${CPUS:-8}" "${RAM_GIB:-16}" > "$dir/domain.xml"
    virsh -q -c qemu:///session define "$dir/domain.xml" >/dev/null
    [ "$was" = local ] && define_mode "$name" local
    # Clipboard + display-follow start/stop with the VM, however it is started.
    mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/libvirt/hooks"
    {
        echo '#!/bin/sh'
        echo '# omvm: clipboard + display follow for omvm VMs started by libvirt (virt-manager)'
        echo "case \"\$2/\$3\" in prepare/begin|release/end) ;; *) [ -f \"$IMAGES/vms/\$1/ssh_port\" ] || exit 0 ;; esac"
        echo "export OMVM_UPSTREAM='$UPSTREAM' OMVM_IMAGES='$IMAGES' OMVM_KEY='$KEY' OMVM_GUEST_USER='$GUEST_USER'"
        echo "export XDG_RUNTIME_DIR='${XDG_RUNTIME_DIR:-/run/user/$(id -u)}' WAYLAND_DISPLAY='${WAYLAND_DISPLAY:-wayland-1}'"
        echo "exec '$(readlink -f "$0")' virt-hook \"\$1\" \"\$2\" \"\$3\""
    } > "${XDG_CONFIG_HOME:-$HOME/.config}/libvirt/hooks/qemu"
    chmod +x "${XDG_CONFIG_HOME:-$HOME/.config}/libvirt/hooks/qemu"
    # libvirt reads hooks only from /etc/libvirt/hooks, also for per-user daemons:
    # a system hook that hands the event to the user's own hook (once, needs sudo).
    if ! grep -qs omvm /etc/libvirt/hooks/qemu; then
        say "installing /etc/libvirt/hooks/qemu (hands VM start/stop to your own hook)"
        sudo install -Dm755 /dev/stdin /etc/libvirt/hooks/qemu <<'HOOK'
#!/bin/sh
# omvm: hand libvirt QEMU events to the per-user hook (session daemons run as the user).
h="${XDG_CONFIG_HOME:-$HOME/.config}/libvirt/hooks/qemu"
[ "$(id -u)" != 0 ] && [ -x "$h" ] && exec "$h" "$@"
exit 0
HOOK
    fi
    # Let virt-manager show the per-user connection.
    gsettings set org.virt-manager.virt-manager.connections uris "['qemu:///session']" 2>/dev/null || true
    gsettings set org.virt-manager.virt-manager.connections autoconnect "['qemu:///session']" 2>/dev/null || true
    ok "$name: in virt-manager (QEMU/KVM User session). Start it there or: virsh -c qemu:///session start $name"
    echo "    SSH: omvm ssh $name   clipboard: omvm clip $name"
}

# ---------------------------------------------------------------- mode
# local:  reims-vgpu's SDL3/Vulkan window on this laptop's screen (zero-copy, at the
#         panel's refresh rate); no VNC, so no Moonlight for this VM.
# remote: QEMU VNC (127.0.0.1) + Sunshine, as `omvm virt` defines it (the default).
# The mode lives in the libvirt definition itself, so it survives reboots.
VIRSH=(virsh -q -c qemu:///session)
vm_mode() { "${VIRSH[@]}" dumpxml --inactive "$1" 2>/dev/null | python3 "$SHARE/libvirt-mode.py" get; }

# "WxH@PPI HZ" of the laptop's built-in screen, for the guest's mode.
local_screen() {
    local j
    j="$(hyprctl monitors -j 2>/dev/null | jq -c '[.[] | select(.name | test("^eDP"))][0] // .[0]' 2>/dev/null || true)"
    if [ -n "$j" ] && [ "$j" != null ]; then
        jq -r '"\(.width)x\(.height)@\((.width * 25.4 / .physicalWidth) | floor) \(.refreshRate | round)"' <<<"$j"
    else
        echo "3024x1964@254 120"   # MacBook Pro 14"
    fi
}

# CPU governor while a local-mode VM runs (omvm perf). With schedutil the cores idle at
# low clocks between the guest's bursts, and every pointer move waits for them to ramp
# up: on the M1 Max a move took 51 ms to reach the screen (10 ms to reach the guest),
# with the performance governor 18 ms (1.4 ms). docs/graphics.md, "Pointer latency".
#   always  performance while a local VM runs, on AC and on battery (the default)
#   ac      performance only on AC power; a udev rule re-applies on plug/unplug
#   off     leave the governor alone
# Kept in ~/.config/omvm/perf; OMVM_LOCAL_GOVERNOR overrides it (keep = off, a governor
# name = always with that governor). Needs passwordless sudo.
GOV_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omvm-governor"
PERF_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omvm/perf"
PERF_RULE=/etc/udev/rules.d/90-omvm-power.rules
PERF_UNIT="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/omvm-power.service"
perf_setting() { # always|ac|off
    case "${OMVM_LOCAL_GOVERNOR:-}" in keep) echo off; return ;; ?*) echo always; return ;; esac
    local v; v="$(cat "$PERF_FILE" 2>/dev/null || true)"
    case "$v" in always|ac|off) echo "$v" ;; *) echo always ;; esac
}
on_ac() { # any Mains supply online (none at all: treat as AC); OMVM_AC_ONLINE=0|1 simulates
    [ -n "${OMVM_AC_ONLINE:-}" ] && { [ "$OMVM_AC_ONLINE" = 1 ]; return; }
    local d seen=0
    for d in /sys/class/power_supply/*; do
        [ "$(cat "$d/type" 2>/dev/null)" = Mains ] || continue
        seen=1; [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && return 0
    done
    [ "$seen" = 0 ]
}
vm_is_local_running() { # NAME: its QEMU runs reims-vgpu's window (no virsh: libvirt hooks must not call libvirt)
    local pid; pid="$(cat "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/libvirt/qemu/run/$1.pid" 2>/dev/null)" || return 1
    tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -qx 'REIMS_VGPU_WINDOW=1'
}
local_vms() { # the local-mode VMs running now, from the hook's markers (stale ones dropped)
    local f n
    for f in "$GOV_DIR"/vm.*; do
        [ -e "$f" ] || continue; n="${f##*/vm.}"
        if vm_is_local_running "$n"; then echo "$n"; else rm -f "$f"; fi
    done
}
set_governors() { # GOVERNOR
    local p
    for p in /sys/devices/system/cpu/cpufreq/policy*; do
        [ "$(cat "$p/scaling_governor")" = "$1" ] && continue
        echo "$1" | sudo -n tee "$p/scaling_governor" >/dev/null 2>&1 || { warn "cpufreq: no passwordless sudo, governor left as is"; return 1; }
    done
}
governor_apply() { # performance or the saved governors, from the setting, AC and the running local VMs
    local want=0 p g
    if [ -n "$(local_vms)" ]; then
        case "$(perf_setting)" in always) want=1 ;; ac) on_ac && want=1 ;; esac
    fi
    if [ "$want" = 1 ]; then
        mkdir -p "$GOV_DIR"
        [ -f "$GOV_DIR/saved" ] || for p in /sys/devices/system/cpu/cpufreq/policy*; do
            echo "$p $(cat "$p/scaling_governor")"; done > "$GOV_DIR/saved"
        g="${OMVM_LOCAL_GOVERNOR:-performance}"; [ "$g" = keep ] && g=performance
        set_governors "$g" || true
    elif [ -f "$GOV_DIR/saved" ]; then
        while read -r p g; do echo "$g" | sudo -n tee "$p/scaling_governor" >/dev/null 2>&1 || true; done < "$GOV_DIR/saved"
        rm -f "$GOV_DIR/saved"
    fi
}
governor_start() { # NAME (libvirt hook: started)
    vm_is_local_running "$1" || return 0
    mkdir -p "$GOV_DIR"; touch "$GOV_DIR/vm.$1"
    governor_apply
}
governor_stop() { rm -f "$GOV_DIR/vm.$1"; governor_apply; }  # NAME (libvirt hook: stopped)
perf_install_ac() { # the plug/unplug trigger: udev runs the user unit, which runs `omvm perf apply`
    mkdir -p "$(dirname "$PERF_UNIT")"
    cat > "$PERF_UNIT" <<EOF
# omvm: re-apply the CPU governor setting (omvm perf) when AC power comes or goes
[Unit]
Description=omvm: CPU governor for local-mode VMs after a power change
[Service]
Type=oneshot
ExecStart=$(readlink -f "$0") perf apply
EOF
    systemctl --user daemon-reload
    local rule="SUBSYSTEM==\"power_supply\", ATTR{type}==\"Mains\", ACTION==\"change\", RUN+=\"/usr/bin/systemctl --no-block --user -M $(id -un)@ start omvm-power.service\""
    if [ "$(cat "$PERF_RULE" 2>/dev/null)" != "# omvm perf ac: re-apply the governor on plug/unplug
$rule" ]; then
        printf '# omvm perf ac: re-apply the governor on plug/unplug\n%s\n' "$rule" | sudo -n tee "$PERF_RULE" >/dev/null &&
            sudo -n udevadm control --reload || warn "no passwordless sudo: $PERF_RULE not installed, plug/unplug won't switch"
    fi
}
cmd_perf() {
    local v="${1:-}" vms
    case "$v" in
    "")
        vms="$(local_vms | tr '\n' ' ')"
        echo "$(perf_setting)"
        echo "  governor $(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null || echo ?)," \
             "power $(on_ac && echo AC || echo battery), local VMs: ${vms:-none}" \
             "$([ -n "${OMVM_LOCAL_GOVERNOR:-}" ] && echo "(OMVM_LOCAL_GOVERNOR=$OMVM_LOCAL_GOVERNOR overrides $PERF_FILE)")" ;;
    always|ac|off)
        mkdir -p "$(dirname "$PERF_FILE")"; echo "$v" > "$PERF_FILE"
        [ "$v" = ac ] && perf_install_ac
        governor_apply
        ok "perf: $v (governor now $(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor))" ;;
    apply) governor_apply ;;
    *) die "usage: omvm perf [always|ac|off]" ;;
    esac
}

# The window needs a Vulkan driver with Wayland WSI: the graphics stack's Mesa is
# built with -Dplatforms= (docs/graphics.md), so local mode uses a second build of
# the same tree with -Dplatforms=wayland.
local_icd() { echo "${OMVM_LOCAL_ICD:-$HOME/opt/mesa-honeykrisp-sb-wl/share/vulkan/icd.d/asahi_icd.aarch64.json}"; }

define_mode() { # NAME local|remote
    local n="$1" m="$2" xml new wl="${WAYLAND_DISPLAY:-wayland-1}" xdg="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" scr
    xml="$(mktemp)"; new="$(mktemp)"
    "${VIRSH[@]}" dumpxml --inactive "$n" > "$xml"
    if [ "$m" = local ]; then
        scr="$(local_screen)"
        python3 "$SHARE/libvirt-mode.py" local "${OMVM_LOCAL_RESOLUTION:-${scr% *}}" \
            "${OMVM_LOCAL_REFRESH:-${scr#* }}" "$wl" "$xdg" "$(local_icd)" "${OMVM_STATS:-0}" < "$xml" > "$new"
    else
        python3 "$SHARE/libvirt-mode.py" remote < "$xml" > "$new"
    fi
    "${VIRSH[@]}" define "$new" >/dev/null
    rm -f "$xml" "$new"
    # libvirt autostart runs at boot, before any Wayland session: local leaves
    # starting to omvm-vm@NAME (which waits for the session).
    if [ "$m" = local ]; then "${VIRSH[@]}" autostart --disable "$n" >/dev/null
    else "${VIRSH[@]}" autostart "$n" >/dev/null; fi
}

vm_shutdown() { # NAME: clean guest shutdown, at most ~4 minutes
    local n="$1" i
    vm_on() { case "$("${VIRSH[@]}" domstate "$1" 2>&1)" in "shut off"|crashed) return 1 ;; esac; }
    vm_on "$n" || return 0
    say "shutting $n down"
    "${VIRSH[@]}" shutdown "$n" >/dev/null 2>&1 || true
    for i in $(seq 1 120); do
        vm_on "$n" || { ok "$n is off ($((2 * i - 2))s)"; return 0; }
        # vmapple ignores libvirt's power button: ask macOS itself after 10 s
        if [ "$i" = 6 ]; then
            ssh -n "${ssh_opts[@]}" -p "$(port_of "$n")" "$GUEST_USER@127.0.0.1" 'sudo -n shutdown -h now' >/dev/null 2>&1 || true
        fi
        sleep 2
    done
    die "$n still running after 4 min (force it with: virsh -c qemu:///session destroy $n)"
}

cmd_mode() {
    local m="" n="${OMVM_VM:-macos}" cur
    case "${1:-}" in local|remote) m="$1"; n="${2:-$n}" ;; "") ;; *) n="$1" ;; esac
    command -v virsh >/dev/null || die "no libvirt (omvm virt first)"
    cur="$(vm_mode "$n")" || die "no libvirt VM '$n' (omvm virt $n)"
    if [ -z "$m" ]; then echo "$cur"; return; fi
    if [ "$m" = "$cur" ]; then ok "$n is already in $m mode"; return; fi
    if [ "$m" = local ]; then
        local wl="${WAYLAND_DISPLAY:-wayland-1}" xdg="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        [ -S "$xdg/$wl" ] || die "no Wayland session at $xdg/$wl: log in to Hyprland first"
        [ -f "$(local_icd)" ] || die "no Mesa with Wayland WSI at $(local_icd) (docs/graphics.md, \"Local window\")"
        export WAYLAND_DISPLAY="$wl" XDG_RUNTIME_DIR="$xdg"
        export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -t "$xdg/hypr" 2>/dev/null | head -1)}"
    fi
    local backup="$IMAGES/vms/$n/domain-$cur-$(date +%Y%m%d-%H%M%S).xml"
    mkdir -p "$(dirname "$backup")"; "${VIRSH[@]}" dumpxml --inactive "$n" > "$backup"
    # the watchdog would restart the VM half-way
    systemctl --user stop "omvm-vm@$n.timer" 2>/dev/null || true
    vm_shutdown "$n"
    define_mode "$n" "$m"
    "${VIRSH[@]}" start "$n" >/dev/null
    systemctl --user start "omvm-vm@$n.timer" 2>/dev/null || true
    if [ "$m" = local ]; then
        ok "$n: local mode, window on this screen ($(vm_mode_res "$n")); Moonlight tiles for $n are off"
    else
        ok "$n: remote mode, VNC on 127.0.0.1:$(vnc_port_of "$n" 2>/dev/null || echo 59xx) + Sunshine"
    fi
    echo "    previous definition: $backup"
}
vm_mode_res() { "${VIRSH[@]}" dumpxml --inactive "$1" | grep -o 'apple-gfx-mmio.resolution=[^"'"'"']*' | cut -d= -f2; }

# ---------------------------------------------------------------- show
# Bring a virt VM to the front: reims-vgpu's window in local mode, a VNC viewer in
# remote mode (opened if there is none), starting the VM first if it is off.
# The "macOS" launcher entry and Ctrl+Alt+M (share/hypr-macos-vm.lua) run this.
hypr_env() {
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)}"
}
window_of() { # CLASS-REGEX -> address of the first window whose class matches
    hyprctl clients -j 2>/dev/null | jq -r --arg re "$1" 'first(.[] | select(.class | test($re; "i")) | .address) // empty'
}
cmd_show() {
    local n="${1:-${OMVM_VM:-macos}}" m a="" port="" i
    command -v virsh >/dev/null || die "no libvirt (omvm virt first)"
    hypr_env
    m="$(vm_mode "$n")" || die "no libvirt VM '$n' (omvm virt $n)"
    if [ "$("${VIRSH[@]}" domstate "$n" 2>/dev/null)" != running ]; then
        "${VIRSH[@]}" start "$n" >/dev/null; ok "$n: starting ($m mode)"
    fi
    if [ "$m" = local ]; then
        for i in $(seq 1 90); do a="$(window_of '^reims-vgpu$')"; [ -n "$a" ] && break; sleep 1; done
        [ -n "$a" ] || die "$n: its window did not appear"
    else
        a="$(window_of vncviewer)"
        if [ -z "$a" ]; then
            for i in $(seq 1 30); do port="$(vnc_port_of "$n" 2>/dev/null)" && break; sleep 1; done
            [ -n "$port" ] || die "$n: no VNC display"
            setsid -f vncviewer -Shared=1 "127.0.0.1:$port" >/dev/null 2>&1 </dev/null
            for i in $(seq 1 30); do a="$(window_of vncviewer)"; [ -n "$a" ] && break; sleep 0.5; done
            [ -n "$a" ] || die "$n: the VNC viewer did not open"
        fi
    fi
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$a\" })" >/dev/null
    ok "$n: in front ($m mode); Ctrl+Alt+M switches back to Omarchy"
}

vnc_port_of() { # NAME -> QEMU VNC port (omvm gui run or libvirt domain)
    local n="$1" f="$UPSTREAM/artifacts/runs/$1/vnc_display" d
    if [[ -f $f ]]; then echo $((5900 + $(cat "$f"))); return; fi
    d=$(virsh -c qemu:///session vncdisplay "$n" 2>/dev/null | head -1) || true
    [[ $d == *:* ]] && { echo $((5900 + ${d##*:})); return; }
    die "$n: no VNC display (is it running?)"
}

cmd_res() {
    local n="${1:?usage: omvm res NAME [WxH]}" port
    port=$(vnc_port_of "$n")
    if [[ -z ${2:-} ]]; then python3 "$SHARE/vnc-setsize.py" "$port" 0 0 0 | head -1; return; fi
    [[ $2 =~ ^([0-9]+)x([0-9]+)$ ]] || die "size must be WxH, e.g. 2560x1440"
    python3 "$SHARE/vnc-setsize.py" "$port" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" 3 | sed -n 2p
    ok "$n: asked for $2 (macOS switches in about a second; a VNC viewer with remote resize may change it back when its window resizes)"
}

# ---------------------------------------------------------------- usb passthrough
# Hot-plugs a host USB device into a running libvirt VM (no restart): QEMU's monitor
# `device_add usb-host` on the qemu-xhci the domain already has (libvirt-domain.py,
# id omvm-usb). The device is matched by host bus + port, so it follows the
# re-enumerations an iPhone does when the guest switches its configuration (new
# device number, same port). The attachment lasts until detach, unplug or VM stop.
# QEMU runs as this user (qemu:///session), so a udev rule gives the user the
# device node. Docs: docs/usb.md.
USB_RULE=/etc/udev/rules.d/70-omvm-usb.rules
usb_host_devices() { # one line per host device (no hubs): BUS-PORT VID:PID SPEED PRODUCT
    local d
    for d in /sys/bus/usb/devices/[0-9]*-[0-9]*; do
        [ -e "$d/idVendor" ] || continue
        case "${d##*/}" in *:*) continue ;; esac
        [ "$(cat "$d/bDeviceClass" 2>/dev/null)" = 09 ] && continue
        printf '%s\t%s:%s\t%s\t%s\n' "${d##*/}" "$(cat "$d/idVendor")" "$(cat "$d/idProduct")" \
            "$(cat "$d/speed" 2>/dev/null)M" "$(cat "$d/manufacturer" 2>/dev/null) $(cat "$d/product" 2>/dev/null)"
    done
}
usb_resolve() { # BUS-PORT | VID:PID | name substring -> the one matching line
    local id="$1" m
    m="$(usb_host_devices | awk -F'\t' -v id="$id" '$1 == id')"
    [ -n "$m" ] || m="$(usb_host_devices | awk -F'\t' -v id="${id,,}" '$2 == id')"
    [ -n "$m" ] || m="$(usb_host_devices | awk -F'\t' -v id="${id,,}" 'index(tolower($4), id)')"
    [ -n "$m" ] || die "no host USB device matches '$id' (omvm usb list)"
    [ "$(wc -l <<<"$m")" = 1 ] || die "'$id' matches several devices, use BUS-PORT:"$'\n'"$m"
    echo "$m"
}
usb_hmp() { "${VIRSH[@]}" qemu-monitor-command "$1" --hmp "$2" | tr -d '\r'; }
usb_attached() { usb_hmp "$1" "info usb" | sed -n 's/.*ID: \(omvm-usb-[^ ,]*\).*/\1/p'; }  # VM -> device ids
usb_rule() { # VID PID: the user owns the node; QEMU (this user) opens it in any session or mode
    local line="SUBSYSTEM==\"usb\", ENV{DEVTYPE}==\"usb_device\", ATTR{idVendor}==\"$1\", ATTR{idProduct}==\"$2\", OWNER=\"$(id -un)\", MODE=\"0660\""
    grep -qxF "$line" "$USB_RULE" 2>/dev/null && return 0
    { [ -s "$USB_RULE" ] || echo "# omvm usb: host devices passed to VMs (omvm usb attach)"; echo "$line"; } |
        sudo -n tee -a "$USB_RULE" >/dev/null && sudo -n udevadm control --reload &&
        sudo -n udevadm trigger --action=change --subsystem-match=usb --attr-match=idVendor="$1" --attr-match=idProduct="$2" &&
        sudo -n udevadm settle || warn "no passwordless sudo: $USB_RULE not written (QEMU may not open the device)"
}
usb_guest() { # VM CMD...: run in the guest (its guest_user, its SSH port)
    local n="$1" u="$GUEST_USER"; shift
    [ -f "$IMAGES/vms/$n/guest_user" ] && u="$(cat "$IMAGES/vms/$n/guest_user")"
    ssh "${ssh_opts[@]}" -o ConnectTimeout=10 -p "$(port_of "$n")" "$u@127.0.0.1" "$@"
}
usb_ios_state() { # VM -> per wired iOS device: PAIRING-STATE UDID MODEL IOS NAME (CoreDevice's view)
    usb_guest "$1" 'python3 -I -' <<'EOF'
import json, os, subprocess, tempfile
fd, f = tempfile.mkstemp(suffix=".json"); os.close(fd)
subprocess.run(["xcrun", "devicectl", "list", "devices", "--json-output", f], capture_output=True, timeout=90)
try:
    devs = json.load(open(f))["result"]["devices"]
finally:
    os.unlink(f)
for x in devs:
    c, p, h = x.get("connectionProperties", {}), x.get("deviceProperties", {}), x.get("hardwareProperties", {})
    if h.get("reality") == "simulated" or c.get("transportType") != "wired":
        continue
    print("\t".join(str(v) for v in (c.get("pairingState", "?"), h.get("udid", "?"), h.get("productType", "?"),
                                     p.get("osVersionNumber", "?"), p.get("name", "?"))))
EOF
}
usb_alert() { # VM: one round of "tap Trust" noise: host sound + notification, guest speech
    local env=(XDG_RUNTIME_DIR="/run/user/$(id -u)" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus")
    env "${env[@]}" notify-send -u critical -t 6000 -a omvm "iPhone" "Unlock it and tap Trust" 2>/dev/null || true
    env "${env[@]}" pw-play /usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga 2>/dev/null ||
        env "${env[@]}" paplay /usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga 2>/dev/null || printf '\a'
    usb_guest "$1" 'say "Tap trust on your iPhone"' </dev/null >/dev/null 2>&1 &
}
usb_trust() { # VM [SECONDS]: ask the wired iPhone to pair, make noise until the owner taps Trust
    local n="$1" limit="${2:-300}" st udid rest end vol
    st="$(usb_ios_state "$n")" || die "can't ask $n's CoreDevice (omvm ssh $n)"
    [ -n "$st" ] || die "no wired iOS device in $n yet (omvm usb attach iphone $n, then wait ~20 s)"
    IFS=$'\t' read -r st udid rest <<<"$(head -1 <<<"$st")"
    if [ "$st" = paired ]; then ok "paired: ${rest//$'\t'/ }"; return 0; fi
    say "$n: ${rest//$'\t'/ } is $st: unlock the iPhone and tap Trust (enter its passcode)"
    # Nothing may re-attach or reset the phone while it shows Trust and the passcode
    # screen: that dismisses them. The watcher is paused until pairing settles.
    local bp watched=()
    for bp in $(usb_attached "$n" | sed 's/^omvm-usb-//'); do
        systemctl --user is-active -q "omvm-usb-watch-$n-$bp" 2>/dev/null &&
            { systemctl --user stop "omvm-usb-watch-$n-$bp"; watched+=("$bp"); }
    done
    # devicectl's pair request is what puts "Trust This Computer?" on the phone; it waits for the tap.
    usb_guest "$n" "nohup xcrun devicectl manage pair --device $udid >/tmp/omvm-pair.log 2>&1 &" </dev/null
    vol="$(XDG_RUNTIME_DIR="/run/user/$(id -u)" wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
    restore_vol() {
        [ -n "$vol" ] || return 0
        XDG_RUNTIME_DIR="/run/user/$(id -u)" wpctl set-volume @DEFAULT_AUDIO_SINK@ "$(awk '{print $2}' <<<"$vol")"
        case "$vol" in *MUTED*) XDG_RUNTIME_DIR="/run/user/$(id -u)" wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 ;; esac
    }
    trap restore_vol EXIT
    XDG_RUNTIME_DIR="/run/user/$(id -u)" wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 2>/dev/null || true
    XDG_RUNTIME_DIR="/run/user/$(id -u)" wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.9 2>/dev/null || true
    end=$((SECONDS + limit))
    while [ $SECONDS -lt $end ]; do
        usb_alert "$n"
        sleep 5
        st="$(usb_ios_state "$n" | head -1 | cut -f1)"
        [ "$st" = paired ] && break
    done
    restore_vol; trap - EXIT
    [ "$st" = paired ] && sleep 90   # passcode entry and the phone's re-enumeration after it
    for bp in "${watched[@]}"; do usb_watch_start "$n" "$bp"; done
    if [ "$st" = paired ]; then
        ok "trusted: ${rest//$'\t'/ } is paired with $n"
    else
        bad "still ${st:-gone} after ${limit}s; guest log: omvm ssh $n cat /tmp/omvm-pair.log"; return 1
    fi
}
# An iPhone comes up in its charging mode (configuration 1). macOS reads its mode
# (vendor request 0x45) and switches it (0x52); a real Mac then sees the phone drop
# off and come back in Mac mode. Passed through, the host never sees that drop: the
# phone answers every later request with EPROTO and stays in configuration 1. So
# the switch is done on the host before QEMU gets the phone (share/usb-apple-mode.py);
# the phone re-enumerates normally and the guest finds nothing to switch.
usb_apple_prepare() { # BUS-PORT: iPhone/iPad into Mac mode on the host
    local m
    m="$(python3 "$SHARE/usb-apple-mode.py" ensure "$1")" || { warn "could not switch $1's USB mode: $m"; return 0; }
    ok "$1 in Mac mode ($m)"
}
usb_add() { # VM BUS-PORT VID:PID: device_add and wait for it
    local n="$1" bp="$2" vp="$3" id="omvm-usb-$2" extra="" out
    # Apple devices: no guest-driven port reset (QEMU's libusb_reset_device puts the
    # phone back in its charging mode).
    [ "${vp%%:*}" = 05ac ] && extra=",guest-reset=off"
    out="$(usb_hmp "$n" "device_add usb-host,id=$id,bus=omvm-usb.0,hostbus=${bp%%-*},hostport=${bp#*-}$extra")"
    [ -z "$(tr -d '[:space:]' <<<"$out")" ] || die "device_add: $out"
    for _ in $(seq 1 10); do grep -q "ID: $id" <<<"$(usb_hmp "$n" "info usb")" && return 0; sleep 1; done
    die "QEMU did not attach $bp (QEMU log: ~/.cache/libvirt/qemu/log/$n.log)"
}
# The phone also re-enumerates on its own (after "Trust", after a reboot) and comes
# back in charging mode, which the guest then switches and gets stuck on. The
# watcher (attach starts it; trust pauses it so nothing interrupts the passcode
# entry) notices configuration 1 for 15 s and re-attaches: device_del, host-side
# switch, device_add. At most once a minute, five times.
usb_watch() { # BUS-PORT VM
    local bp="$1" n="$2" stuck=0 last=-60 tries=0 cfg vp
    while [ "$("${VIRSH[@]}" domstate "$n" 2>/dev/null)" = running ] &&
          grep -qx "omvm-usb-$bp" <<<"$(usb_attached "$n")"; do
        cfg="$(cat "/sys/bus/usb/devices/$bp/bConfigurationValue" 2>/dev/null)"
        if [ "$cfg" = 1 ]; then stuck=$((stuck + 3)); else stuck=0; fi
        if [ $stuck -ge 15 ] && [ $((SECONDS - last)) -ge 60 ] && [ $tries -lt 5 ]; then
            echo "$bp in configuration 1 for ${stuck}s: re-attaching in Mac mode"
            vp="$(cat "/sys/bus/usb/devices/$bp/idVendor"):$(cat "/sys/bus/usb/devices/$bp/idProduct")"
            usb_hmp "$n" "device_del omvm-usb-$bp" >/dev/null
            for _ in $(seq 1 10); do grep -qx "omvm-usb-$bp" <<<"$(usb_attached "$n")" || break; sleep 1; done
            sleep 3; usb_apple_prepare "$bp"; usb_add "$n" "$bp" "$vp"
            last=$SECONDS; tries=$((tries + 1)); stuck=0
        fi
        sleep 3
    done
    echo "$bp no longer attached to $n: watcher done"
}
usb_watch_start() { # VM BUS-PORT
    systemctl --user stop "omvm-usb-watch-$1-$2" 2>/dev/null || true
    systemd-run --user --quiet --collect --unit "omvm-usb-watch-$1-$2" \
        "$(readlink -f "$0")" usb watch "$2" "$1"
}
cmd_usb() {
    local verb="${1:-list}" n line bp vp id
    case "$verb" in
    list)
        n="${2:-${OMVM_VM:-macos}}"
        local att=""; [ "$("${VIRSH[@]}" domstate "$n" 2>/dev/null)" = running ] && att="$(usb_attached "$n")"
        usb_host_devices | while IFS=$'\t' read -r bp vp sp desc; do
            printf '%-8s %s %7s  %-40s %s\n' "$bp" "$vp" "$sp" "$desc" \
                "$(grep -qx "omvm-usb-$bp" <<<"$att" && echo "-> $n")"
        done
        [ -n "$(usb_host_devices)" ] || echo "(no USB devices on this host)"
        for id in $att; do  # attached, but gone from the host (unplugged or re-enumerating)
            [ -e "/sys/bus/usb/devices/${id#omvm-usb-}/idVendor" ] || echo "${id#omvm-usb-}  (not on the host now) -> $n"
        done ;;
    attach|detach)
        n="${3:-${OMVM_VM:-macos}}"
        [ "$("${VIRSH[@]}" domstate "$n" 2>/dev/null)" = running ] || die "VM '$n' is not running"
        if [ "$verb" = detach ] && grep -qx "omvm-usb-${2:-}" <<<"$(usb_attached "$n")"; then
            bp="$2"   # by BUS-PORT even when the device is already unplugged
        else
            line="$(usb_resolve "${2:?usage: omvm usb $verb BUS-PORT|VID:PID|NAME [VM]}")"
            IFS=$'\t' read -r bp vp _ _ <<<"$line"
        fi
        id="omvm-usb-$bp"
        if [ "$verb" = detach ]; then
            grep -qx "$id" <<<"$(usb_attached "$n")" || { ok "$bp is not attached to $n"; return 0; }
            systemctl --user stop "omvm-usb-watch-$n-$bp" 2>/dev/null || true
            usb_hmp "$n" "device_del $id" >/dev/null; ok "detached $bp from $n"; return 0
        fi
        grep -qx "$id" <<<"$(usb_attached "$n")" && { ok "$bp is already attached to $n"; return 0; }
        grep -q 'id "omvm-usb"' <<<"$(usb_hmp "$n" "info qtree")" ||
            die "$n has no omvm-usb controller (domains from libvirt-domain.py have one: omvm virt $n)"
        usb_rule "${vp%%:*}" "${vp##*:}"
        case "$vp" in 05ac:12[ab]?) usb_apple_prepare "$bp" ;; esac
        usb_add "$n" "$bp" "$vp"
        usb_hmp "$n" "info usb" | grep "ID: $id"
        ok "attached $bp ($vp) to $n"
        case "$vp" in 05ac:12[ab]?) usb_watch_start "$n" "$bp" && ok "watching $bp (journalctl --user -u omvm-usb-watch-$n-$bp)" ;; esac
        case "$vp" in 05ac:12[ab]?) say "iPhone/iPad: run 'omvm usb trust $n' to pair it (tap Trust on the phone)" ;; esac ;;
    trust) usb_trust "${2:-${OMVM_VM:-macos}}" "${3:-300}" ;;
    watch) usb_watch "${2:?BUS-PORT}" "${3:-${OMVM_VM:-macos}}" ;;
    *) die "usage: omvm usb list [VM] | attach|detach BUS-PORT|VID:PID|NAME [VM] | trust [VM] [SECONDS]" ;;
    esac
}

cmd_list()   { ls "$UPSTREAM/artifacts/runs" 2>/dev/null || true; }
cmd_images() { ls -d "$IMAGES"/*/ 2>/dev/null | xargs -rn1 basename; }

# Per-VM guest account: IMAGES/vms/NAME/guest_user overrides OMVM_GUEST_USER.
case "${1:-}" in ssh|clip|res|stop|virt-hook|show|gui|start) [ -n "${2:-}" ] && [ -f "$IMAGES/vms/$2/guest_user" ] && GUEST_USER="$(cat "$IMAGES/vms/$2/guest_user")" ;; esac
case "${1:-help}" in
doctor) shift; cmd_doctor "$@" ;;
kernel) shift; cmd_kernel "$@" ;;
qemu) shift; cmd_qemu "$@" ;;
macos-step) shift; cmd_macos_step "$@" ;;
ingest) shift; cmd_ingest "$@" ;;
setup) shift; cmd_setup "$@" ;;
run) shift; cmd_run "$@" ;;
start) shift; cmd_start "$@" ;;
restart|pause|resume) cmd_power "$@" ;;
gui) shift; cmd_gui "$@"; clip_start "$1" ;;
clip) shift; cmd_clip "$@" ;;
res) shift; upstream; cmd_res "$@" ;;
remote) shift; exec "$SHARE/stream-host.sh" "$@" ;;
virt) shift; cmd_virt "$@" ;;
mode) shift; cmd_mode "$@" ;;
perf) shift; cmd_perf "$@" ;;
usb) shift; cmd_usb "$@" ;;
show) shift; cmd_show "$@" ;;
helpers) shift; case "${1:-}" in
    status) sudo -n /usr/local/libexec/omvm-apple-helpers status "${2:?usage: omvm helpers status NAME}" ;;
    install-hook) python3 "$SHARE/apple-helpers-hook.py" ;;
    *) die "usage: omvm helpers status NAME | install-hook" ;;
    esac ;;
virt-hook) shift
    # prepare/begin and release/end need the original XML on stdin. No libvirt
    # calls (including upstream checkout) may occur inside this hook.
    if [ -x /usr/local/libexec/omvm-apple-helpers ]; then
        case "${2:-}/${3:-}" in
        prepare/begin|release/end)
            sudo -n /usr/local/libexec/omvm-apple-helpers gate "$1" "$2" "$3" ;;
        esac
    fi
    case "${2:-}" in
    started) { clip_start "$1"; follow_start "$1"; governor_start "$1"; } >/dev/null 2>&1 </dev/null ;;
    stopped) { clip_stop "$1"; governor_stop "$1"; } >/dev/null 2>&1 </dev/null ;;
    esac ;;
ssh) shift; cmd_ssh "$@" ;;
stop) shift; cmd_stop "$@" ;;
list) cmd_list ;;
images) cmd_images ;;
version|--version) echo "omvm $VERSION" ;;
help|-h|--help) sed -n '3,/^set -euo/{/^#/p}' "$0" | sed 's/^# \{0,1\}//' ;;
*) die "unknown command '$1' (omvm help)" ;;
esac
