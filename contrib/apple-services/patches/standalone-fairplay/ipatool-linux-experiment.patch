@@ -0,0 +1,104 @@
+package machine
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"testing"
+)
+
+func TestIOAESSupportedOptionsExplicitProvider(t *testing.T) {
+	for _, test := range []struct {
+		name          string
+		ordinary, dsb bool
+	}{
+		{"absent", false, false}, {"ordinary only", true, false}, {"DSB only", false, true}, {"both", true, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			calls := 0
+			options := shimOptions{}
+			if test.ordinary {
+				options.deviceAESProvider = deviceAESFixtureProvider(func(DeviceAESRequest) (DeviceAESResult, error) {
+					calls++
+					return DeviceAESResult{}, errors.New("fixture transform must not run")
+				})
+			}
+			if test.dsb {
+				options.deviceAESDSBProvider = deviceAESDSBFixture(func(DeviceAESDSBRequest) (DeviceAESResult, error) {
+					calls++
+					return DeviceAESResult{}, errors.New("fixture DSB must not run")
+				})
+			}
+			m := newDeviceAESOptionsTestMachine(t, options)
+			const nameAddress, sentinelAddress = scratchBase, scratchBase + 0x100
+			if err := m.engine.MemWrite(nameAddress, []byte("IOAESAccelerator\x00")); err != nil {
+				t.Fatal(err)
+			}
+			entry := m.services.symbols["__ZN9IOService14waitForServiceEP12OSDictionaryP13mach_timespec"]
+			service, err := m.invoke(entry, nameAddress, 0)
+			if err != nil || service == 0 {
+				t.Fatalf("service lookup failed: %v", err)
+			}
+			table, err := m.services.readUint64(service)
+			if err != nil {
+				t.Fatal(err)
+			}
+			vtable, err := m.engine.MemRead(table, ioAESVtableSize)
+			if err != nil {
+				t.Fatal(err)
+			}
+			getter := binary.LittleEndian.Uint64(vtable[0x8a0:0x8a8])
+			wantName := "$IOAESAccelerator.unhandled.slot_8a0"
+			if test.ordinary {
+				wantName = "$IOAESAccelerator.getSupportedOptions"
+			}
+			if m.services.entries[getter].name != wantName {
+				t.Fatal("getter was selected without the ordinary explicit provider")
+			}
+			before := bytes.Repeat([]byte{0xa7}, 64)
+			if err := m.engine.MemWrite(sentinelAddress, before); err != nil {
+				t.Fatal(err)
+			}
+			// Extra synthetic arguments are deliberately invalid pointers. A native
+			// getter returns only w0; it must not read/write a guessed output pointer.
+			value, err := m.invoke(getter, service, 0xdeadbeef, sentinelAddress, 0xcafebabe)
+			if test.ordinary {
+				if err != nil || value != 1 {
+					t.Fatalf("restricted uint32 result=%#x error=%v", value, err)
+				}
+				if value&^uint64(1) != 0 {
+					t.Fatal("unsupported native capability bits advertised")
+				}
+			} else {
+				var method *IOAESUnsupportedMethodError
+				if !errors.As(err, &method) {
+					t.Fatal("absent provider gained getter support")
+				}
+				offset, ok := method.MetadataSlot()
+				if !ok || offset != 0x8a0 {
+					t.Fatal("absent-provider slot diagnostic was suppressed")
+				}
+			}
+			after, err := m.engine.MemRead(sentinelAddress, uint64(len(before)))
+			if err != nil || !bytes.Equal(after, before) {
+				t.Fatal("getter changed caller memory")
+			}
+			if calls != 0 {
+				t.Fatal("getter ran provider work")
+			}
+			// Capability reporting must not install semantics for neighboring key
+			// queries, mutations or generation methods.
+			for _, offset := range []uint32{0x898, 0x8a8, 0x8c0, 0x8c8} {
+				methodEntry := binary.LittleEndian.Uint64(vtable[offset : offset+8])
+				_, err := m.invoke(methodEntry, service, 0xdeadbeef)
+				var method *IOAESUnsupportedMethodError
+				if !errors.As(err, &method) || method.SlotOffset != offset {
+					t.Fatal("unrelated method gained semantics")
+				}
+			}
+			if calls != 0 {
+				t.Fatal("unsupported neighbor ran provider work")
+			}
+		})
+	}
+}
diff --git a/internal/sap/machine/ioaes_provider_test.go b/internal/sap/machine/ioaes_provider_test.go
