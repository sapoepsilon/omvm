diff --git a/internal/sap/machine/extended_descriptor_error.go b/internal/sap/machine/extended_descriptor_error.go
new file mode 100644
index 0000000..fbd17ac
--- /dev/null
+++ b/internal/sap/machine/extended_descriptor_error.go
@@ -0,0 +1,75 @@
+package machine
+
+import (
+	"encoding/binary"
+	"errors"
+	"math"
+
+	"github.com/majd/ipatool/v2/internal/sap/unicorn"
+)
+
+const extendedDescriptorHandle = uint32(3000)
+const extendedDescriptorMinimum = uint64(76)
+
+type DescriptorReadStatus uint8
+
+const (
+	DescriptorReadUnavailable DescriptorReadStatus = iota
+	DescriptorReadComplete
+	DescriptorReadAddressOverflow
+)
+
+func (s DescriptorReadStatus) String() string {
+	switch s {
+	case DescriptorReadComplete:
+		return "minimum_readable"
+	case DescriptorReadAddressOverflow:
+		return "address_overflow"
+	default:
+		return "unavailable"
+	}
+}
+
+// ExtendedDescriptorUnsupportedError is diagnostic only. It retains no guest
+// pointer, key-storage bytes or DSB bytes; its cause is the existing rejection.
+type ExtendedDescriptorUnsupportedError struct {
+	Err                error
+	KeyWord            uint32
+	ExtensionLength    uint32
+	HasExtensionLength bool
+	IVPresent          bool
+	Descriptor1Offset  uint64
+	Descriptor2Offset  uint64
+	ReadStatus         DescriptorReadStatus
+	ReadNativeCode     int32
+	HasReadNativeCode  bool
+}
+
+func (e *ExtendedDescriptorUnsupportedError) Error() string { return e.Err.Error() }
+func (e *ExtendedDescriptorUnsupportedError) Unwrap() error { return e.Err }
+
+// Called only after the exact raw handle 3000 has been rejected, before any
+// provider call. This proves readability of only the native minimum extension;
+// it neither validates the descriptor's meaning nor accepts its operation.
+func (s *shims) diagnoseExtendedDescriptor(address uint64, keyWord uint32, ivPresent bool, firstOffset, secondOffset uint64, cause error) *ExtendedDescriptorUnsupportedError {
+	metadata := &ExtendedDescriptorUnsupportedError{Err: cause, KeyWord: keyWord, IVPresent: ivPresent, Descriptor1Offset: firstOffset, Descriptor2Offset: secondOffset}
+	if address > math.MaxUint64-extendedDescriptorMinimum {
+		metadata.ReadStatus = DescriptorReadAddressOverflow
+		return metadata
+	}
+	var descriptor [extendedDescriptorMinimum]byte
+	defer clear(descriptor[:])
+	// MemReadInto applies the engine's capability/memory guard and reports
+	// unmapped ranges. Never follow the untrusted extension length.
+	if err := s.engine.MemReadInto(descriptor[:], address); err != nil {
+		var native *unicorn.NativeError
+		if errors.As(err, &native) && native != nil {
+			metadata.ReadNativeCode, metadata.HasReadNativeCode = native.Code, true
+		}
+		return metadata
+	}
+	metadata.ReadStatus = DescriptorReadComplete
+	metadata.ExtensionLength = binary.LittleEndian.Uint32(descriptor[40:44])
+	metadata.HasExtensionLength = true
+	return metadata
+}
