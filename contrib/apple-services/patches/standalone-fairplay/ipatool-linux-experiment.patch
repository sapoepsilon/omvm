+package unicorn
+
+import "fmt"
+
+// NativeError retains the original Unicorn error text while exposing its
+// numeric API code separately. Diagnostic logs must never serialize Error().
+type NativeError struct {
+	Code        int32
+	description string
+}
+
+func (e *NativeError) Error() string {
+	return fmt.Sprintf("unicorn error %d: %s", e.Code, e.description)
+}
diff --git a/internal/sap/unicorn/native_error_test.go b/internal/sap/unicorn/native_error_test.go
new file mode 100644
