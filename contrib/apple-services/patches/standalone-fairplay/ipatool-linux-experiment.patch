+package machine
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"strings"
+	"syscall"
+	"testing"
+
+	"github.com/majd/ipatool/v2/internal/sap/unicorn"
+)
+
+func TestFailureMetadataPureBoundaries(t *testing.T) {
+	var adi *ModernADI
+	_, _, err := adi.ExchangeKernelBuffer(nil)
+	var kernel *KernelExchangeError
+	if !errors.As(err, &kernel) || kernel.Phase != PhaseKernelSession || err.Error() != "modern FairPlay kernel session is unavailable" {
+		t.Fatal("session boundary changed")
+	}
+	adi = &ModernADI{kernel: &Machine{}, kernelContext: 1}
+	_, _, err = adi.ExchangeKernelBuffer(nil)
+	if !errors.As(err, &kernel) || kernel.Phase != PhaseKernelInput || err.Error() != "modern FairPlay kernel message is invalid" {
+		t.Fatal("input boundary changed")
+	}
+
+	key := make([]byte, 40)
+	binary.LittleEndian.PutUint32(key[:4], 128)
+	binary.LittleEndian.PutUint32(key[36:], DeviceAESPurpose89C)
+	provider := deviceAESFixtureProvider(func(DeviceAESRequest) (DeviceAESResult, error) { return DeviceAESResult{}, syscall.EIO })
+	output, iv, err := emulateIOAESWithProvider(provider, make([]byte, 32), make([]byte, 16), 1, key, false)
+	var aes *DeviceAESError
+	if output != nil || iv != nil || !errors.Is(err, syscall.EIO) || !errors.As(err, &aes) || aes.Phase != PhaseAESProviderCall || !aes.HasPurpose || aes.Purpose != DeviceAESPurpose89C || aes.Operation != 1 || aes.InputBytes != 32 {
+		t.Fatal("AES failure lost original cause or safe metadata")
+	}
+	_, _, err = emulateIOAESWithProvider(nil, make([]byte, 32), make([]byte, 16), 2, key, false)
+	if !errors.As(err, &aes) || aes.Phase != PhaseAESOperation || err.Error() != "unsupported IOAES operation 0x2" {
+		t.Fatal("operation rejection changed")
+	}
+	if FailurePhase(255).String() != "unknown" {
+		t.Fatal("unknown phase exposed dynamic content")
+	}
+	for _, name := range []string{"", "unsafe\nvalue", "payload/path", strings.Repeat("a", 257)} {
+		if (&ShimError{Symbol: name, registered: true}).MetadataSymbol() != "unavailable" {
+			t.Fatal("unsafe shim label was exposed")
+		}
+	}
+}
+
+func TestFailureMetadataRealShimMemoryCodes(t *testing.T) {
+	for _, test := range []struct {
+		name                string
+		source, destination uint64
+		code                int32
+	}{
+		{"read", 0x6000000, scratchBase, 6},
+		{"write", scratchBase, 0x6000000, 7},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			m := newServiceTestMachine(t)
+			_, err := m.invoke(m.services.symbols["_memcpy"], test.destination, test.source, 16)
+			var shim *ShimError
+			var execution *ExecutionError
+			var native *unicorn.NativeError
+			if !errors.As(err, &shim) || shim.Symbol != "_memcpy" || shim.MetadataSymbol() != "_memcpy" || !errors.As(err, &execution) || execution.Phase != PhaseInvokeEmulate || !errors.As(err, &native) || native.Code != test.code {
+				t.Fatal("real failing shim lost its name, execution phase or native code")
+			}
+			if !strings.HasPrefix(err.Error(), "_memcpy: ") {
+				t.Fatal("original symbol prefix changed")
+			}
+		})
+	}
+}
+
+func TestFailureMetadataRealExecutionAndErrorChain(t *testing.T) {
+	m := newServiceTestMachine(t)
+	_, err := m.invoke(0x6000000)
+	var execution *ExecutionError
+	var native *unicorn.NativeError
+	if !errors.As(err, &execution) || execution.Phase != PhaseInvokeEmulate || !errors.As(err, &native) || native.Code != 8 {
+		t.Fatal("instruction fetch failure lost phase/code")
+	}
+	want := errors.New("fixture cause")
+	entry, err := m.services.addFunction("test.failure", func() error { return want })
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = m.invoke(entry)
+	if !errors.Is(err, want) || err.Error() != "test.failure: fixture cause" {
+		t.Fatal("original error text or identity changed")
+	}
+	var shim *ShimError
+	if !errors.As(fmt.Errorf("outer: %w", err), &shim) || shim.MetadataSymbol() != "test.failure" {
+		t.Fatal("outer wrapping lost the registered symbol")
+	}
+	entry, err = m.services.addFunction("test.stopped", func() error { return m.engine.Stop() })
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = m.invoke(entry)
+	if !errors.As(err, &execution) || execution.Phase != PhaseInvokeUnexpectedStop {
+		t.Fatal("early stop did not identify completion failure")
+	}
+}
