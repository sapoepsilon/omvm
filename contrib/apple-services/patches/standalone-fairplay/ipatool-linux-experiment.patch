index 0000000..a4d87f3
--- /dev/null
+++ b/internal/sap/machine/ioaes_provider_test.go
@@ -0,0 +1,217 @@
+package machine
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"strings"
+	"testing"
+)
+
+// This provider exists only in tests. Its fixed buffers are ABI fixtures, not a
+// device-key implementation, software-key substitute, or cryptographic oracle.
+type deviceAESFixtureProvider func(DeviceAESRequest) (DeviceAESResult, error)
+
+func (p deviceAESFixtureProvider) TransformDeviceAES(request DeviceAESRequest) (DeviceAESResult, error) {
+	return p(request)
+}
+
+func newDeviceAESProviderTestMachine(t *testing.T, provider DeviceAESProvider) *Machine {
+	t.Helper()
+	return newDeviceAESOptionsTestMachine(t, shimOptions{deviceAESProvider: provider})
+}
+
+func newDeviceAESOptionsTestMachine(t *testing.T, options shimOptions) *Machine {
+	t.Helper()
+	machine := newServiceTestMachine(t)
+	// Replace only the test service area so this exercises the real options
+	// constructor and real ARM64 shim instead of setting its provider field.
+	if err := machine.services.close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := machine.engine.MemUnmap(shimBase, shimSize); err != nil {
+		t.Fatal(err)
+	}
+	services, err := newShimsWithOptions(machine.engine, map[string]uint64{}, nil, options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	machine.services = services
+	return machine
+}
+
+func TestDeviceAESProviderDescriptorShim(t *testing.T) {
+	providerFailure := errors.New("fixture provider failure")
+	for _, test := range []struct {
+		name        string
+		purpose     uint32
+		operation   uint32
+		keyBits     uint32
+		nullIV      bool
+		result      func(*DeviceAESResult)
+		providerErr error
+		err         string
+		calls       int
+	}{
+		{name: "purpose 899 non-null IV and offsets", purpose: DeviceAESPurpose899, keyBits: 128, calls: 1},
+		{name: "purpose 89c non-null IV and offsets", purpose: DeviceAESPurpose89C, keyBits: 128, calls: 1},
+		{name: "null IV supplies zeros without copyback", purpose: DeviceAESPurpose89C, keyBits: 128, nullIV: true, calls: 1},
+		{name: "decrypt purpose 899 copies output and final ciphertext IV", purpose: DeviceAESPurpose899, operation: 1, keyBits: 128, calls: 1},
+		{name: "decrypt purpose 89c copies output and final ciphertext IV", purpose: DeviceAESPurpose89C, operation: 1, keyBits: 128, calls: 1},
+		{name: "decrypt null IV supplies zeros without copyback", purpose: DeviceAESPurpose89C, operation: 1, keyBits: 128, nullIV: true, calls: 1},
+		{name: "decrypt failure preserves destination and IV", purpose: DeviceAESPurpose89C, operation: 1, keyBits: 128, providerErr: providerFailure, err: "fixture provider failure", calls: 1},
+		{name: "decrypt incomplete result preserves destination and IV", purpose: DeviceAESPurpose89C, operation: 1, keyBits: 128, result: func(r *DeviceAESResult) { r.Completed = false }, err: "did not complete", calls: 1},
+		{name: "decrypt short output discarded", purpose: DeviceAESPurpose89C, operation: 1, keyBits: 128, result: func(r *DeviceAESResult) { r.Output = r.Output[:16] }, err: "invalid output", calls: 1},
+		{name: "decrypt short IV discarded", purpose: DeviceAESPurpose89C, operation: 1, keyBits: 128, result: func(r *DeviceAESResult) { r.IV = r.IV[:15] }, err: "invalid output", calls: 1},
+		{name: "provider error discards complete buffers", purpose: DeviceAESPurpose89C, keyBits: 128, providerErr: providerFailure, err: "fixture provider failure", calls: 1},
+		{name: "accepted work is not completion", purpose: DeviceAESPurpose89C, keyBits: 128, result: func(r *DeviceAESResult) { r.Completed = false }, err: "did not complete", calls: 1},
+		{name: "short output discarded", purpose: DeviceAESPurpose89C, keyBits: 128, result: func(r *DeviceAESResult) { r.Output = r.Output[:16] }, err: "invalid output", calls: 1},
+		{name: "long output discarded", purpose: DeviceAESPurpose89C, keyBits: 128, result: func(r *DeviceAESResult) { r.Output = append(r.Output, make([]byte, 16)...) }, err: "invalid output", calls: 1},
+		{name: "short IV discarded", purpose: DeviceAESPurpose89C, keyBits: 128, result: func(r *DeviceAESResult) { r.IV = r.IV[:15] }, err: "invalid output", calls: 1},
+		{name: "long IV discarded", purpose: DeviceAESPurpose89C, keyBits: 128, result: func(r *DeviceAESResult) { r.IV = append(r.IV, 1) }, err: "invalid output", calls: 1},
+		{name: "unobserved purpose rejected before provider", purpose: 0x89b, keyBits: 128, err: "unsupported IOAES key handle"},
+		{name: "unobserved operation rejected before provider", purpose: DeviceAESPurpose89C, operation: 2, keyBits: 128, err: "unsupported IOAES operation"},
+		{name: "non-AES128 descriptor rejected before provider", purpose: DeviceAESPurpose89C, keyBits: 256, err: "unsupported IOAES key size"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			const srcDesc, dstDesc = scratchBase, scratchBase + 0x100
+			const srcData, dstData, keyAddress, ivAddress = scratchBase + 0x200, scratchBase + 0x300, scratchBase + 0x400, scratchBase + 0x500
+			const length, sourceOffset, destinationOffset = 32, 16, 32
+			source := make([]byte, 96)
+			for i := range source {
+				source[i] = byte(i)
+			}
+			beforeDestination := bytes.Repeat([]byte{0x5a}, 96)
+			beforeIV := bytes.Repeat([]byte{0xa5}, 16)
+			fixtureOutput := bytes.Repeat([]byte{0x91}, length)
+			fixtureIV := bytes.Repeat([]byte{0x7b}, 16)
+			if test.operation == 1 {
+				// Model the provider's completed CBC-decrypt state with the
+				// final input ciphertext, deliberately unlike plaintext output.
+				fixtureIV = bytes.Clone(source[sourceOffset+length-16 : sourceOffset+length])
+			}
+			calls := 0
+			provider := deviceAESFixtureProvider(func(request DeviceAESRequest) (DeviceAESResult, error) {
+				calls++
+				if request.Purpose != test.purpose || request.Operation != test.operation || request.KeyBits != 128 || !bytes.Equal(request.Input, source[sourceOffset:sourceOffset+length]) {
+					t.Fatal("provider received incorrect purpose, operation, width, or source-offset bytes")
+				}
+				wantIV := beforeIV
+				if test.nullIV {
+					wantIV = make([]byte, 16)
+				}
+				if request.IVPresent != !test.nullIV || !bytes.Equal(request.IV, wantIV) {
+					t.Fatal("provider received incorrect IV bytes or presence flag")
+				}
+				// Deliberately mutate only the provider's defensive request copies.
+				request.Input[0], request.IV[0] = 0xee, 0xee
+				result := DeviceAESResult{Completed: true, Output: bytes.Clone(fixtureOutput), IV: bytes.Clone(fixtureIV)}
+				if test.result != nil {
+					test.result(&result)
+				}
+				return result, test.providerErr
+			})
+			machine := newDeviceAESProviderTestMachine(t, provider)
+			shim, err := machine.services.addFunction("test.ioaes.provider", machine.services.ioAESPerform)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, item := range []struct{ address, value uint64 }{
+				{srcDesc + 8, srcData}, {srcDesc + 16, uint64(len(source))},
+				{dstDesc + 8, dstData}, {dstDesc + 16, uint64(len(beforeDestination))},
+			} {
+				if err := machine.services.writeUint64(item.address, item.value); err != nil {
+					t.Fatal(err)
+				}
+			}
+			// Nonzero incoming key storage is ignored for valid special-key
+			// purposes. It must neither reach the provider nor cause rejection.
+			key := bytes.Repeat([]byte{0x77}, 40)
+			binary.LittleEndian.PutUint32(key[:4], test.keyBits)
+			binary.LittleEndian.PutUint32(key[36:], test.purpose)
+			for _, item := range []struct {
+				address uint64
+				value   []byte
+			}{
+				{srcData, source}, {dstData, beforeDestination}, {keyAddress, key}, {ivAddress, beforeIV},
+			} {
+				if err := machine.engine.MemWrite(item.address, item.value); err != nil {
+					t.Fatal(err)
+				}
+			}
+			ivPointer := uint64(ivAddress)
+			if test.nullIV {
+				ivPointer = 0
+			}
+			firstDesc, secondDesc := uint64(srcDesc), uint64(dstDesc)
+			firstOffset, secondOffset := uint64(sourceOffset), uint64(destinationOffset)
+			if test.operation == 1 {
+				// Native decrypt reads descriptor2 and writes descriptor1; each
+				// unequal offset remains attached to its own descriptor.
+				firstDesc, secondDesc = secondDesc, firstDesc
+				firstOffset, secondOffset = secondOffset, firstOffset
+			}
+			status, err := machine.invoke(shim, 1, firstDesc, secondDesc, length, ivPointer, uint64(test.operation), keyAddress, firstOffset, secondOffset, 0, 0)
+			if test.err != "" {
+				if err == nil || !strings.Contains(err.Error(), test.err) {
+					t.Fatalf("error = %v, want containing %q", err, test.err)
+				}
+			} else if err != nil || status != 0 {
+				t.Fatalf("completed provider returned status %#x, error %v", status, err)
+			}
+			if test.providerErr != nil && !errors.Is(err, test.providerErr) {
+				t.Fatal("provider error identity was not preserved")
+			}
+			if calls != test.calls {
+				t.Fatalf("provider calls = %d, want %d", calls, test.calls)
+			}
+			wantDestination, wantIV := bytes.Clone(beforeDestination), bytes.Clone(beforeIV)
+			if test.err == "" {
+				copy(wantDestination[destinationOffset:destinationOffset+length], fixtureOutput)
+				if !test.nullIV {
+					wantIV = fixtureIV
+				}
+			}
+			for _, item := range []struct {
+				name    string
+				address uint64
+				want    []byte
+			}{
+				{"source", srcData, source}, {"destination", dstData, wantDestination}, {"IV", ivAddress, wantIV}, {"key descriptor", keyAddress, key},
+			} {
+				got, err := machine.engine.MemRead(item.address, uint64(len(item.want)))
+				if err != nil || !bytes.Equal(got, item.want) {
+					t.Fatalf("unexpected %s copyback; read error %v", item.name, err)
+				}
+			}
+		})
+	}
+}
+
+func TestDeviceAESProviderDefaultAndBufferOwnership(t *testing.T) {
+	for _, purpose := range []uint32{DeviceAESPurpose899, DeviceAESPurpose89C} {
+		key := make([]byte, 40)
+		binary.LittleEndian.PutUint32(key[:4], 128)
+		binary.LittleEndian.PutUint32(key[36:], purpose)
+		input, iv := bytes.Repeat([]byte{1}, 16), bytes.Repeat([]byte{2}, 16)
+		for _, operation := range []uint32{0, 1} {
+			output, outputIV, err := emulateIOAES(input, iv, operation, key)
+			if err == nil || !strings.Contains(err.Error(), "unavailable") || output != nil || outputIV != nil {
+				t.Fatal("default device-AES provider did not remain unavailable")
+			}
+			providerOutput, providerIV := bytes.Repeat([]byte{3}, 16), bytes.Repeat([]byte{4}, 16)
+			provider := deviceAESFixtureProvider(func(request DeviceAESRequest) (DeviceAESResult, error) {
+				request.Input[0], request.IV[0] = 0xee, 0xee
+				return DeviceAESResult{Completed: true, Output: providerOutput, IV: providerIV}, nil
+			})
+			output, outputIV, err = emulateIOAESWithProvider(provider, input, iv, operation, key, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			providerOutput[0], providerIV[0] = 0xff, 0xff
+			if input[0] != 1 || iv[0] != 2 || output[0] != 3 || outputIV[0] != 4 {
+				t.Fatal("provider buffers alias caller or returned buffers")
+			}
