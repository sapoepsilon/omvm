@@ -0,0 +1,258 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type testBackend struct {
+	xpc    func([]byte) ([]byte, error)
+	kernel func([]byte) ([]byte, int32, error)
+}
+
+func (b testBackend) ExchangeXPC(p []byte) ([]byte, error)                 { return b.xpc(p) }
+func (b testBackend) ExchangeKernelBuffer(p []byte) ([]byte, int32, error) { return b.kernel(p) }
+
+func frame(magic string, queue, capacity uint32, body []byte) []byte {
+	header := 12
+	if magic == "OFP2" {
+		header = 16
+	}
+	out := make([]byte, header+len(body))
+	copy(out, magic)
+	binary.LittleEndian.PutUint32(out[4:], uint32(len(body)))
+	binary.LittleEndian.PutUint32(out[8:], capacity)
+	if header == 16 {
+		binary.LittleEndian.PutUint32(out[12:], queue)
+	}
+	copy(out[header:], body)
+	return out
+}
+func adiReply(status uint32, length uint32, body []byte) []byte {
+	out := make([]byte, 8+len(body))
+	binary.BigEndian.PutUint32(out, status)
+	binary.BigEndian.PutUint32(out[4:], length)
+	copy(out[8:], body)
+	return out
+}
+
+func TestNativeReplyBoundsAndRawFailure(t *testing.T) {
+	negative := int32(-43006)
+	for _, tc := range []struct {
+		name     string
+		reply    []byte
+		input    int
+		capacity uint32
+		status   uint32
+		valid    bool
+		body     []byte
+	}{
+		{"negative four bytes", adiReply(uint32(negative), 0, nil)[:4], 4, 4, uint32(negative), true, nil},
+		{"short status", []byte{0, 0, 0}, 4, 4, 0, false, nil},
+		{"short success", make([]byte, 4), 4, 4, 0, false, nil},
+		{"success", adiReply(0, 4, []byte{1, 2, 3, 4}), 4, 4, 0, true, []byte{1, 2, 3, 4}},
+		{"native trailing bytes", adiReply(0, 4, []byte{1, 2, 3, 4, 5}), 4, 4, 0, true, []byte{1, 2, 3, 4}},
+		{"too short output", adiReply(0, 3, []byte{1, 2, 3}), 4, 4, 0, false, nil},
+		{"truncated output", adiReply(0, 4, []byte{1, 2, 3}), 4, 4, 0, false, nil},
+		{"capacity overrun", adiReply(0, 5, []byte{1, 2, 3, 4, 5}), 4, 4, 0, false, nil},
+		{"u32 overflow", adiReply(0, ^uint32(0), nil), 4, ^uint32(0), 0, false, nil},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := parseADIReply(tc.reply, tc.input, tc.capacity)
+			if tc.valid {
+				if got.kind != responseOFR1 || got.stage != 0 || got.status != tc.status || !bytes.Equal(got.body, tc.body) {
+					t.Fatalf("unexpected parsed response: stage=%d status=%d length=%d", got.stage, got.status, len(got.body))
+				}
+			} else if got.stage == 0 || len(got.body) != 0 {
+				t.Fatal("invalid reply became successful output")
+			}
+		})
+	}
+}
+
+func TestRoutingAndErrorOutput(t *testing.T) {
+	var calls int
+	b := testBackend{
+		xpc: func(p []byte) ([]byte, error) {
+			calls++
+			want := []byte{0, 0, 0, 1, 0xa8, 0x47, 0x1c, 0xad, 0, 0, 0, 1, 0, 0, 0, 4, 1, 2, 3, 4}
+			if !bytes.Equal(p, want) {
+				t.Fatal("wrong queue-3 wrapper")
+			}
+			return adiReply(0, 4, []byte{4, 3, 2, 1}), nil
+		},
+		kernel: func(p []byte) ([]byte, int32, error) {
+			calls++
+			if !bytes.Equal(p, []byte{1, 2, 3, 4}) {
+				t.Fatal("queue-0 transformed buffer")
+			}
+			return []byte{9, 9, 9, 9}, -12345, nil
+		},
+	}
+	resp := exchange(b, request{queue: 3, capacity: 4, body: []byte{1, 2, 3, 4}})
+	if resp.kind != responseOFR1 || resp.stage != 0 || !bytes.Equal(resp.body, []byte{4, 3, 2, 1}) {
+		t.Fatal("valid queue-3 failed")
+	}
+	resp = exchange(b, request{queue: 0, capacity: 4, body: []byte{1, 2, 3, 4}})
+	if resp.kind != responseKernelOFR2 || resp.stage != 0 || int32(resp.status) != -12345 || !bytes.Equal(resp.body, []byte{9, 9, 9, 9}) {
+		t.Fatal("kernel completion lost raw status or modified buffer")
+	}
+	var wire bytes.Buffer
+	if err := writeResponse(&wire, resp); err != nil {
+		t.Fatal(err)
+	}
+	if wire.Len() != 20 || string(wire.Bytes()[:4]) != "OFR2" || int32(binary.LittleEndian.Uint32(wire.Bytes()[8:12])) != -12345 || binary.LittleEndian.Uint32(wire.Bytes()[12:16]) != 4 || !bytes.Equal(wire.Bytes()[16:], []byte{9, 9, 9, 9}) {
+		t.Fatal("wrong kernel completion wire frame")
+	}
+	resp = exchange(b, request{queue: 0, capacity: 3, body: []byte{1, 2, 3, 4}})
+	if resp.kind != responseOFR1 || resp.stage == 0 || len(resp.body) != 0 || calls != 2 {
+		t.Fatal("capacity rejection invoked backend")
+	}
+	b.kernel = func([]byte) ([]byte, int32, error) { return nil, 0, errors.New("private backend detail") }
+	resp = exchange(b, request{queue: 0, capacity: 4, body: []byte{1, 2, 3, 4}})
+	if resp.kind != responseOFR1 || resp.stage == 0 || resp.status == 0 || len(resp.body) != 0 || resp.reason != "kernel_error" {
+		t.Fatal("backend fault became success")
+	}
+}
+
+func TestResponseTypesDoNotRelaxOFR1Errors(t *testing.T) {
+	for _, resp := range []response{
+		{kind: responseOFR1, status: 1, body: []byte{1}},
+		{kind: responseOFR1, stage: stageInternal, body: []byte{1}},
+		{kind: responseKernelOFR2, queue: 3, inputLength: 1, body: []byte{1}},
+		{kind: responseKernelOFR2, queue: 0, stage: stageInternal, inputLength: 1, body: []byte{1}},
+		{kind: responseKernelOFR2, queue: 0, inputLength: 2, body: []byte{1}},
+		{kind: responseKernelOFR2, queue: 0},
+		{kind: responseKind(99)},
+	} {
+		var wire bytes.Buffer
+		if err := writeResponse(&wire, resp); err == nil || wire.Len() != 0 {
+			t.Fatal("invalid response type emitted bytes")
+		}
+	}
+	for _, status := range []int32{0, -12345} {
+		b := testBackend{kernel: func([]byte) ([]byte, int32, error) { return []byte{1, 2, 3}, status, nil }}
+		resp := exchange(b, request{queue: 0, capacity: 4, body: []byte{1, 2, 3, 4}})
+		if resp.kind != responseOFR1 || resp.stage == 0 || len(resp.body) != 0 {
+			t.Fatal("wrong-length kernel output became a completion")
+		}
+	}
+}
+
+func TestRequestFramingRejectsAmbiguity(t *testing.T) {
+	valid := frame("OFP2", 0, 4, []byte{1, 2, 3, 4})
+	for _, p := range [][]byte{valid[:10], valid[:len(valid)-1], append(append([]byte(nil), valid...), 0), frame("OFP2", 2, 4, []byte{1, 2, 3, 4}), frame("OFP1", 3, 0, []byte{1}), frame("NOPE", 3, 4, []byte{1}), frame("OFP1", 3, 4, nil)} {
+		if _, err := readRequest(bytes.NewReader(p)); err == nil {
+			t.Fatal("malformed request accepted")
+		}
+	}
+	for _, p := range [][]byte{valid, frame("OFP1", 3, 4, []byte{1, 2, 3, 4})} {
+		if _, err := readRequest(bytes.NewReader(p)); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func shortDirectory(t *testing.T) string {
+	t.Helper()
+	p, err := os.MkdirTemp("/tmp", "ofp-test-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(p) })
+	if err := os.Chmod(p, 0700); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func TestUnixSocketSessionAndPermissions(t *testing.T) {
+	dir := shortDirectory(t)
+	path := filepath.Join(dir, "relay.sock")
+	listener, cleanup, err := privateListener(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cleanup()
+	info, err := os.Stat(path)
+	if err != nil || info.Mode().Perm() != 0600 {
+		t.Fatal("socket is not private")
+	}
+	if _, _, err := privateListener(path); err == nil {
+		t.Fatal("existing socket replaced")
+	}
+	var calls atomic.Int32
+	b := testBackend{xpc: func(p []byte) ([]byte, error) { calls.Add(1); return adiReply(0, 4, p[len(p)-4:]), nil }, kernel: func(p []byte) ([]byte, int32, error) { calls.Add(1); return p, 0, nil }}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		done <- serve(ctx, listener, b, time.Second, func(string) { t.Error("unexpected backend timeout") })
+	}()
+	for _, queue := range []uint32{0, 3, 0} {
+		conn, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: path, Net: "unix"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+		if _, err = conn.Write(frame("OFP2", queue, 4, []byte{1, 2, 3, 4})); err != nil {
+			t.Fatal(err)
+		}
+		_ = conn.CloseWrite()
+		out, err := io.ReadAll(conn)
+		_ = conn.Close()
+		if err != nil {
+			t.Fatal(err)
+		}
+		magic := "OFR1"
+		if queue == 0 {
+			magic = "OFR2"
+		}
+		if len(out) != 20 || string(out[:4]) != magic || !bytes.Equal(out[16:], []byte{1, 2, 3, 4}) || binary.LittleEndian.Uint32(out[4:]) != 0 || binary.LittleEndian.Uint32(out[8:]) != 0 {
+			t.Fatal("invalid socket response")
+		}
+	}
+	if calls.Load() != 3 {
+		t.Fatal("persistent backend not reused")
+	}
+	cancel()
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	cleanup()
+	if _, err := os.Lstat(path); !os.IsNotExist(err) {
+		t.Fatal("owned socket not cleaned")
+	}
+}
+
+func TestUnterminatedRequestNeverReachesBackend(t *testing.T) {
+	server, client := net.Pipe()
+	defer client.Close()
+	var called atomic.Bool
+	b := testBackend{xpc: func([]byte) ([]byte, error) { called.Store(true); return nil, nil }}
+	done := make(chan struct{})
+	go func() {
+		serveConnection(server, b, 20*time.Millisecond, func(string) { t.Error("framing timeout is not backend timeout") })
+		close(done)
+	}()
+	if _, err := client.Write(frame("OFP1", 3, 4, []byte{1, 2, 3, 4})); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("unterminated request did not time out")
+	}
+	if called.Load() {
+		t.Fatal("backend saw request before EOF")
+	}
+}
diff --git a/tools/omvm-fairplay-linux/state.go b/tools/omvm-fairplay-linux/state.go
new file mode 100644
index 0000000..5d302f8
--- /dev/null
+++ b/tools/omvm-fairplay-linux/state.go
@@ -0,0 +1,234 @@
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+
+	"golang.org/x/sys/unix"
+)
+
+const maxStateSize = 1 << 20
+const stateHeaderSize = 64
+
+// A checkpoint is the daemon's virtual adi.pb, not a snapshot of emulator
+// memory. Kernel sessions are recreated by a cold guest boot. Missing and
+// present-but-empty files are distinct, including after a native deletion.
+type adiCheckpoint struct {
+	present bool
+	data    []byte
+}
+
+type stateStore struct {
+	dir      *os.File
+	lock     *os.File
+	name     string
+	identity []byte
+	last     adiCheckpoint
+}
+
+func stateError() error {
+	return errors.New("durable ADI state unavailable; inspect the private store without resetting it")
+}
+
+func privateStateFile(fd int, flags int, name string) (*os.File, error) {
+	n, err := unix.Openat(fd, name, flags|unix.O_NOFOLLOW|unix.O_CLOEXEC|unix.O_NONBLOCK, 0600)
+	if err != nil {
+		return nil, stateError()
+	}
+	f := os.NewFile(uintptr(n), name)
+	var st unix.Stat_t
+	if err := unix.Fstat(n, &st); err != nil || st.Mode&unix.S_IFMT != unix.S_IFREG || st.Mode&07777 != 0600 || st.Uid != 0 || st.Nlink != 1 {
+		_ = f.Close()
+		return nil, stateError()
+	}
+	return f, nil
+}
+
+func openStateStore(path string, identity []byte, initialize bool) (*stateStore, error) {
+	if os.Geteuid() != 0 || !filepath.IsAbs(path) || len(identity) != 16 || filepath.Base(path) == "." || filepath.Base(path) == string(os.PathSeparator) {
+		return nil, stateError()
+	}
+	fd, err := unix.Open(filepath.Dir(path), unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, stateError()
+	}
+	dir := os.NewFile(uintptr(fd), filepath.Dir(path))
+	s := &stateStore{dir: dir, name: filepath.Base(path), identity: append([]byte(nil), identity...)}
+	ok := false
+	defer func() {
+		if !ok {
+			s.close()
+		}
+	}()
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil || st.Uid != 0 || st.Mode&07777 != 0700 || st.Mode&unix.S_IFMT != unix.S_IFDIR {
+		return nil, stateError()
+	}
+	s.lock, err = privateStateFile(fd, unix.O_RDWR|unix.O_CREAT, s.name+".lock")
+	if err != nil {
+		return nil, err
+	}
+	if err := unix.Flock(int(s.lock.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		return nil, stateError()
+	}
+	// Neither a pending request nor an interrupted atomic write is repaired
+	// automatically. Either could represent an unacknowledged native mutation.
+	for _, suffix := range []string{".dirty", ".next"} {
+		if err := unix.Fstatat(fd, s.name+suffix, &st, unix.AT_SYMLINK_NOFOLLOW); err != unix.ENOENT {
+			return nil, stateError()
+		}
+	}
+	if initialize {
+		if err := unix.Fstatat(fd, s.name, &st, unix.AT_SYMLINK_NOFOLLOW); err != unix.ENOENT {
+			return nil, stateError()
+		}
+		if err := s.write(adiCheckpoint{}); err != nil {
+			return nil, err
+		}
+	} else {
+		f, err := privateStateFile(fd, unix.O_RDONLY, s.name)
+		if err != nil {
+			return nil, err
+		}
+		encoded, readErr := io.ReadAll(io.LimitReader(f, stateHeaderSize+maxStateSize+1))
+		closeErr := f.Close()
+		if readErr != nil || closeErr != nil {
+			return nil, stateError()
+		}
+		s.last, err = s.decode(encoded)
+		if err != nil {
+			return nil, err
+		}
+	}
+	ok = true
+	return s, nil
+}
+
+func (s *stateStore) close() {
+	if s.lock != nil {
+		_ = s.lock.Close()
+	}
+	if s.dir != nil {
+		_ = s.dir.Close()
+	}
+}
+
+func (s *stateStore) encode(c adiCheckpoint) ([]byte, error) {
+	if len(c.data) > maxStateSize || (!c.present && len(c.data) != 0) {
+		return nil, stateError()
+	}
+	b := make([]byte, stateHeaderSize+len(c.data))
+	copy(b, "OMVMADI1")
+	copy(b[8:24], s.identity)
+	if c.present {
+		b[24] = 1
+	}
+	binary.LittleEndian.PutUint32(b[28:32], uint32(len(c.data)))
+	copy(b[stateHeaderSize:], c.data)
+	h := sha256.New()
+	_, _ = h.Write(b[:32])
+	_, _ = h.Write(c.data)
+	copy(b[32:64], h.Sum(nil))
+	return b, nil
+}
+
+func (s *stateStore) decode(b []byte) (adiCheckpoint, error) {
+	if len(b) < stateHeaderSize || len(b) > stateHeaderSize+maxStateSize || string(b[:8]) != "OMVMADI1" || !bytes.Equal(b[8:24], s.identity) || b[24] > 1 || !bytes.Equal(b[25:28], []byte{0, 0, 0}) || int(binary.LittleEndian.Uint32(b[28:32])) != len(b)-stateHeaderSize {
+		return adiCheckpoint{}, stateError()
+	}
+	c := adiCheckpoint{present: b[24] == 1, data: append([]byte(nil), b[stateHeaderSize:]...)}
+	want, err := s.encode(c)
+	if err != nil || !bytes.Equal(want, b) {
+		return adiCheckpoint{}, stateError()
+	}
+	return c, nil
+}
+
+// write persists a whole identity-bound checkpoint before replacing the last
+// committed name. Every operation is relative to the pinned private directory.
+func (s *stateStore) write(c adiCheckpoint) error {
+	b, err := s.encode(c)
+	if err != nil {
+		return err
+	}
+	fd := int(s.dir.Fd())
+	f, err := privateStateFile(fd, unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL, s.name+".next")
+	if err != nil {
+		return err
+	}
+	writeErr := writeAll(f, b)
+	syncErr := f.Sync()
+	closeErr := f.Close()
+	if writeErr != nil || syncErr != nil || closeErr != nil {
+		return stateError()
+	}
+	if err := unix.Renameat(fd, s.name+".next", fd, s.name); err != nil {
+		return stateError()
+	}
+	if err := s.dir.Sync(); err != nil {
+		return stateError()
+	}
+	s.last = adiCheckpoint{present: c.present, data: append([]byte(nil), c.data...)}
+	return nil
+}
+
+func (s *stateStore) begin() error {
+	f, err := privateStateFile(int(s.dir.Fd()), unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL, s.name+".dirty")
+	if err != nil {
+		return err
+	}
+	writeErr := writeAll(f, []byte("native request pending\n"))
+	syncErr := f.Sync()
+	closeErr := f.Close()
+	if writeErr != nil || syncErr != nil || closeErr != nil || s.dir.Sync() != nil {
+		return stateError()
+	}
+	return nil
+}
+
+func (s *stateStore) commit(c adiCheckpoint, success bool) error {
+	changed := c.present != s.last.present || !bytes.Equal(c.data, s.last.data)
+	// A native error is not proof that a mutation can be rolled back. Preserve
+	// the dirty marker and stop if an unsuccessful call changed persisted data.
+	if changed && !success {
+		return stateError()
+	}
+	if changed {
+		if err := s.write(c); err != nil {
+			return err
+		}
+	}
+	if err := unix.Unlinkat(int(s.dir.Fd()), s.name+".dirty", 0); err != nil {
+		return stateError()
+	}
+	if err := s.dir.Sync(); err != nil {
+		return stateError()
+	}
+	return nil
+}
+
+type checkpointBackend struct {
+	backend
+	store    *stateStore
+	snapshot func() ([]byte, bool, error)
+}
+
+func (b *checkpointBackend) beginCheckpoint() error { return b.store.begin() }
+
+func (b *checkpointBackend) commitCheckpoint(success bool) error {
+	data, present, err := b.snapshot()
+	if err != nil {
+		return stateError()
+	}
+	return b.store.commit(adiCheckpoint{present: present, data: data}, success)
+}
+
+type checkpointBoundary interface {
+	beginCheckpoint() error
+	commitCheckpoint(bool) error
+}
diff --git a/tools/omvm-fairplay-linux/state_test.go b/tools/omvm-fairplay-linux/state_test.go
new file mode 100644
index 0000000..46b0823
--- /dev/null
+++ b/tools/omvm-fairplay-linux/state_test.go
@@ -0,0 +1,340 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"os/signal"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+var testStateIdentity = bytes.Repeat([]byte{0x41}, 16)
+
+func newTestState(t *testing.T) (*stateStore, string) {
+	t.Helper()
+	if os.Geteuid() != 0 {
+		t.Skip("durable state file tests require an isolated root process")
+	}
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "state.bin")
+	s, err := openStateStore(path, testStateIdentity, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(s.close)
+	return s, path
+}
+
+func TestStateRoundTripMissingEmptyAndPopulated(t *testing.T) {
+	for _, c := range []adiCheckpoint{{}, {present: true}, {present: true, data: []byte("synthetic provisioning bytes")}} {
+		s, path := newTestState(t)
+		if err := s.begin(); err != nil {
+			t.Fatal(err)
+		}
+		if err := s.commit(c, true); err != nil {
+			t.Fatal(err)
+		}
+		s.close()
+		reopened, err := openStateStore(path, testStateIdentity, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if reopened.last.present != c.present || !bytes.Equal(reopened.last.data, c.data) {
+			t.Fatal("restart changed the committed native file state")
+		}
+		reopened.close()
+	}
+}
+
+func TestStateRejectsUnsafeOrAmbiguousRecovery(t *testing.T) {
+	for _, scenario := range []string{"missing", "truncated", "corrupt", "wrong_identity", "oversize", "permissions", "wrong_owner", "parent_permissions", "parent_owner", "parent_symlink", "symlink", "hardlink", "dirty", "interrupted_write"} {
+		t.Run(scenario, func(t *testing.T) {
+			s, path := newTestState(t)
+			s.close()
+			identity := append([]byte(nil), testStateIdentity...)
+			var err error
+			switch scenario {
+			case "missing":
+				err = os.Remove(path)
+			case "truncated":
+				err = os.Truncate(path, 63)
+			case "corrupt":
+				b, e := os.ReadFile(path)
+				if e != nil {
+					t.Fatal(e)
+				}
+				b[32] ^= 1
+				err = os.WriteFile(path, b, 0600)
+			case "wrong_identity":
+				identity[0] ^= 1
+			case "oversize":
+				err = os.Truncate(path, maxStateSize+stateHeaderSize+1)
+			case "permissions":
+				err = os.Chmod(path, 0640)
+			case "wrong_owner":
+				err = os.Chown(path, 65534, -1)
+			case "parent_permissions":
+				err = os.Chmod(filepath.Dir(path), 0750)
+			case "parent_owner":
+				err = os.Chown(filepath.Dir(path), 65534, -1)
+			case "parent_symlink":
+				link := filepath.Join(t.TempDir(), "state-directory")
+				err = os.Symlink(filepath.Dir(path), link)
+				path = filepath.Join(link, "state.bin")
+			case "symlink":
+				if e := os.Rename(path, path+".original"); e != nil {
+					t.Fatal(e)
+				}
+				err = os.Symlink(path+".original", path)
+			case "hardlink":
+				err = os.Link(path, path+".other")
+			case "dirty":
+				err = os.WriteFile(path+".dirty", []byte("pending"), 0600)
+			case "interrupted_write":
+				err = os.WriteFile(path+".next", []byte("partial checkpoint"), 0600)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if recovered, err := openStateStore(path, identity, false); err == nil {
+				recovered.close()
+				t.Fatal("unsafe state silently recovered")
+			}
+		})
+	}
+}
+
+func TestStateNeverReinitializesOrSharesLiveStore(t *testing.T) {
+	s, path := newTestState(t)
+	if other, err := openStateStore(path, testStateIdentity, false); err == nil {
+		other.close()
+		t.Fatal("two backends acquired the same state")
+	}
+	s.close()
+	if other, err := openStateStore(path, testStateIdentity, true); err == nil {
+		other.close()
+		t.Fatal("explicit initialization overwrote existing state")
+	}
+}
+
+func TestStateAtomicWriteFailure(t *testing.T) {
+	if path := os.Getenv("OMVM_STATE_FAILURE_CHILD"); path != "" {
+		s, err := openStateStore(path, testStateIdentity, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer s.close()
+		if err := s.begin(); err != nil {
+			t.Fatal(err)
+		}
+		// Exercise an actual short file write without a production fault hook.
+		signal.Ignore(syscall.SIGXFSZ)
+		if err := unix.Setrlimit(unix.RLIMIT_FSIZE, &unix.Rlimit{Cur: 128, Max: 128}); err != nil {
+			t.Fatal(err)
+		}
+		if err := s.commit(adiCheckpoint{present: true, data: bytes.Repeat([]byte{0x52}, 4096)}, true); err == nil {
+			t.Fatal("failed disk write was accepted")
+		}
+		return
+	}
+	s, path := newTestState(t)
+	original, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.close()
+	cmd := exec.Command(os.Args[0], "-test.run=^TestStateAtomicWriteFailure$")
+	cmd.Env = append(os.Environ(), "OMVM_STATE_FAILURE_CHILD="+path)
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("child failed: %v %s", err, out)
+	}
+	after, err := os.ReadFile(path)
+	if err != nil || !bytes.Equal(original, after) {
+		t.Fatal("partial write replaced the old complete checkpoint")
+	}
+	if recovered, err := openStateStore(path, testStateIdentity, false); err == nil {
+		recovered.close()
+		t.Fatal("uncertain partial write allowed rollback to an older checkpoint")
+	}
+}
+
+func TestDurableReplyBeforeAcknowledgement(t *testing.T) {
+	s, path := newTestState(t)
+	newData := []byte("independent synthetic native state")
+	listener, cleanup, err := privateListener(filepath.Join(shortDirectory(t), "s"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cleanup()
+	b := &checkpointBackend{backend: testBackend{xpc: func([]byte) ([]byte, error) {
+		if _, err := os.Stat(path + ".dirty"); err != nil {
+			t.Error("native mutation began without a durable dirty marker")
+		}
+		return adiReply(0, 4, []byte{4, 3, 2, 1}), nil
+	}}, store: s, snapshot: func() ([]byte, bool, error) { return newData, true, nil }}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		conn, err := listener.Accept()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		serveConnection(conn, b, time.Second, func(reason string) { t.Error(reason) })
+	}()
+	conn, err := net.DialUnix("unix", nil, listener.Addr().(*net.UnixAddr))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+	_, err = conn.Write(frame("OFP2", 3, 4, []byte{1, 2, 3, 4}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.CloseWrite()
+	wire, err := io.ReadAll(conn)
+	_ = conn.Close()
+	<-done
+	if err != nil || len(wire) != 20 || binary.LittleEndian.Uint32(wire[4:8]) != 0 || binary.LittleEndian.Uint32(wire[8:12]) != 0 {
+		t.Fatal("successful native response was not acknowledged")
+	}
+	onDisk, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := s.decode(onDisk)
+	if err != nil || !c.present || !bytes.Equal(c.data, newData) {
+		t.Fatal("guest received success before state was durable")
+	}
+	if _, err := os.Stat(path + ".dirty"); !os.IsNotExist(err) {
+		t.Fatal("completed transaction remained dirty")
+	}
+}
+
+func TestDurableFailuresNeverReturnSuccessOrRollback(t *testing.T) {
+	for _, scenario := range []string{"native_error", "malformed_reply", "snapshot_error", "failed_mutation", "disk_failure"} {
+		t.Run(scenario, func(t *testing.T) {
+			s, path := newTestState(t)
+			b := &checkpointBackend{backend: testBackend{xpc: func([]byte) ([]byte, error) {
+				switch scenario {
+				case "native_error":
+					return nil, errors.New("synthetic private failure")
+				case "malformed_reply":
+					return []byte{1}, nil
+				case "failed_mutation":
+					return adiReply(42, 0, nil)[:4], nil
+				case "disk_failure":
+					if err := os.WriteFile(path+".next", []byte("interrupted"), 0600); err != nil {
+						t.Fatal(err)
+					}
+				}
+				return adiReply(0, 4, []byte{4, 3, 2, 1}), nil
+			}}, store: s, snapshot: func() ([]byte, bool, error) {
+				if scenario == "snapshot_error" {
+					return nil, false, errors.New("synthetic snapshot unavailable")
+				}
+				return []byte("new synthetic state"), true, nil
+			}}
+			resp := exchange(b, request{queue: 3, capacity: 4, body: []byte{1, 2, 3, 4}})
+			if resp.stage != stageInternal || resp.status == 0 || len(resp.body) != 0 {
+				t.Fatal("uncertain state produced success or payload")
+			}
+			s.close()
+			if recovered, err := openStateStore(path, testStateIdentity, false); err == nil {
+				recovered.close()
+				t.Fatal("uncertain native state silently rolled back")
+			}
+		})
+	}
+}
+
+func TestDurableNegativeStatusWithoutMutationRemainsUsable(t *testing.T) {
+	s, path := newTestState(t)
+	b := &checkpointBackend{backend: testBackend{xpc: func([]byte) ([]byte, error) { return adiReply(42, 0, nil)[:4], nil }}, store: s, snapshot: func() ([]byte, bool, error) { return nil, false, nil }}
+	resp := exchange(b, request{queue: 3, capacity: 4, body: []byte{1, 2, 3, 4}})
+	if resp.stage != stageCall || resp.status != 42 {
+		t.Fatal("clean native error changed semantics")
+	}
+	s.close()
+	recovered, err := openStateStore(path, testStateIdentity, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	recovered.close()
+}
+
+func TestGracefulShutdownDrainsDurableRequest(t *testing.T) {
+	s, path := newTestState(t)
+	listener, cleanup, err := privateListener(filepath.Join(shortDirectory(t), "s"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cleanup()
+	entered, finish := make(chan struct{}), make(chan struct{})
+	b := &checkpointBackend{backend: testBackend{xpc: func([]byte) ([]byte, error) {
+		close(entered)
+		<-finish
+		return adiReply(0, 4, []byte{4, 3, 2, 1}), nil
+	}}, store: s, snapshot: func() ([]byte, bool, error) { return []byte("completed during shutdown"), true, nil }}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- serve(ctx, listener, b, time.Second, func(reason string) { t.Error(reason) }) }()
+	conn, err := net.DialUnix("unix", nil, listener.Addr().(*net.UnixAddr))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+	if _, err = conn.Write(frame("OFP2", 3, 4, []byte{1, 2, 3, 4})); err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.CloseWrite()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("native call did not start")
+	}
+	// signal.NotifyContext in main uses this same cancellation path.
+	cancel()
+	select {
+	case err := <-done:
+		t.Fatalf("shutdown discarded in-flight native request: %v", err)
+	default:
+	}
+	close(finish)
+	wire, err := io.ReadAll(conn)
+	_ = conn.Close()
+	if err != nil || len(wire) != 20 || binary.LittleEndian.Uint32(wire[4:8]) != 0 || binary.LittleEndian.Uint32(wire[8:12]) != 0 {
+		t.Fatal("graceful shutdown lost completed reply")
+	}
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("shutdown did not finish after request drained")
+	}
+	s.close()
+	recovered, err := openStateStore(path, testStateIdentity, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer recovered.close()
+	if !recovered.last.present || string(recovered.last.data) != "completed during shutdown" {
+		t.Fatal("clean shutdown lost committed native state")
+	}
+}
diff --git a/tools/omvm-uid1-diagnostic/main.go b/tools/omvm-uid1-diagnostic/main.go
new file mode 100644
index 0000000..89b7162
--- /dev/null
+++ b/tools/omvm-uid1-diagnostic/main.go
@@ -0,0 +1,60 @@
+// Explicit root-only control for the frozen experimental device-AES provider.
+// It never runs a transform, chains administrative actions, or prints secrets.
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"flag"
+	"os"
+
+	"github.com/majd/ipatool/v2/internal/sap/deviceaes"
+)
+
+func run() error {
+	device := flag.String("device", "", "explicit /dev/omvm-uid1-provider path")
+	action := flag.String("action", "", "one explicit action: status, capability, selftest, or init")
+	seedFile := flag.String("seed-file", "", "private pinned 32-byte seed file; required only for init")
+	flag.Parse()
+	if *device == "" || flag.NArg() != 0 || (*action != "status" && *action != "capability" && *action != "selftest" && *action != "init") || ((*action == "init") != (*seedFile != "")) {
+		return errors.New("require an explicit device/action and a seed file only for init")
+	}
+	controller, err := deviceaes.OpenController(*device)
+	if err != nil {
+		return err
+	}
+	defer controller.Close()
+	if *action == "capability" {
+		capability, err := controller.Capability()
+		if err != nil {
+			return err
+		}
+		return json.NewEncoder(os.Stdout).Encode(struct {
+			Action     string               `json:"action"`
+			Capability deviceaes.Capability `json:"capability"`
+		}{Action: *action, Capability: capability})
+	}
+	var status deviceaes.Status
+	switch *action {
+	case "status":
+		status, err = controller.Status()
+	case "selftest":
+		status, err = controller.SelfTest()
+	case "init":
+		status, err = controller.InitializeFromFile(*seedFile)
+	}
+	if err != nil {
+		return err
+	}
+	return json.NewEncoder(os.Stdout).Encode(struct {
+		Action string           `json:"action"`
+		Status deviceaes.Status `json:"status"`
+	}{Action: *action, Status: status})
+}
+
+func main() {
+	if err := run(); err != nil {
+		_ = json.NewEncoder(os.Stderr).Encode(map[string]string{"error": err.Error()})
+		os.Exit(1)
+	}
+}
