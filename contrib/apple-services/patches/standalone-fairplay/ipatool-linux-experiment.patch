+package machine
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"math"
+	"strings"
+	"testing"
+)
+
+// Fixed test-only fixtures prove copy/ABI behavior, not hardware cryptography.
+type deviceAESDSBFixture func(DeviceAESDSBRequest) (DeviceAESResult, error)
+
+func (p deviceAESDSBFixture) TransformDeviceAESDSB(r DeviceAESDSBRequest) (DeviceAESResult, error) {
+	return p(r)
+}
+
+func TestDeviceAESDSBDescriptorShim(t *testing.T) {
+	providerErr := errors.New("fixture DSB failure")
+	for _, test := range []struct {
+		name                 string
+		change               func([]uint64, []byte)
+		result               func(*DeviceAESResult)
+		providerErr          error
+		inPlace, unavailable bool
+		truncated, guarded   bool
+		err                  string
+		calls                int
+	}{
+		{name: "decrypt reads second writes first", calls: 1},
+		{name: "observed in-place", inPlace: true, calls: 1},
+		{name: "default rejected", unavailable: true, err: "unsupported IOAES key handle"},
+		{name: "extension unmapped", truncated: true, err: "read extended IOAES descriptor"},
+		{name: "extension capability denied", guarded: true, err: "read extended IOAES descriptor"},
+		{name: "neighbor handle rejected", change: func(_ []uint64, k []byte) { binary.LittleEndian.PutUint32(k[36:], 3001) }, err: "unsupported IOAES key handle"},
+		{name: "flagged handle rejected", change: func(_ []uint64, k []byte) { binary.LittleEndian.PutUint32(k[36:], 0x80000bb8) }, err: "unsupported IOAES key handle"},
+		{name: "provider failure", providerErr: providerErr, calls: 1, err: "fixture DSB failure"},
+		{name: "incomplete", result: func(r *DeviceAESResult) { r.Completed = false }, calls: 1, err: "did not complete"},
+		{name: "short output", result: func(r *DeviceAESResult) { r.Output = r.Output[:15] }, calls: 1, err: "invalid output"},
+		{name: "long IV", result: func(r *DeviceAESResult) { r.IV = append(r.IV, 1) }, calls: 1, err: "invalid output"},
+		{name: "encrypt rejected", change: func(a []uint64, _ []byte) { a[5] = 0 }, err: "observed operation bounds"},
+		{name: "operation2 rejected", change: func(a []uint64, _ []byte) { a[5] = 2 }, err: "observed operation bounds"},
+		{name: "width rejected", change: func(_ []uint64, k []byte) { binary.LittleEndian.PutUint32(k, 256) }, err: "observed operation bounds"},
+		{name: "flags rejected", change: func(_ []uint64, k []byte) { binary.LittleEndian.PutUint32(k, 0x80000080) }, err: "observed operation bounds"},
+		{name: "two blocks rejected", change: func(a []uint64, _ []byte) { a[3] = 32 }, err: "observed operation bounds"},
+		{name: "NULL IV rejected", change: func(a []uint64, _ []byte) { a[4] = 0 }, err: "observed operation bounds"},
+		{name: "first offset rejected", change: func(a []uint64, _ []byte) { a[7] = 16 }, err: "observed operation bounds"},
+		{name: "second offset rejected", change: func(a []uint64, _ []byte) { a[8] = 16 }, err: "observed operation bounds"},
+		{name: "extension zero rejected", change: func(_ []uint64, k []byte) { binary.LittleEndian.PutUint32(k[40:], 0) }, err: "observed field bounds"},
+		{name: "extension too large rejected", change: func(_ []uint64, k []byte) { binary.LittleEndian.PutUint32(k[40:], 0xffffffff) }, err: "observed field bounds"},
+		{name: "async rejected", change: func(a []uint64, _ []byte) { a[9] = 1 }, err: "asynchronous IOAES"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			const firstDesc, secondDesc = scratchBase, scratchBase + 0x100
+			const firstData, secondData, ivAddress = scratchBase + 0x200, scratchBase + 0x300, scratchBase + 0x500
+			keyAddress := uint64(scratchBase + 0x400)
+			first := bytes.Repeat([]byte{0x5a}, 64)
+			second := bytes.Repeat([]byte{0xc3}, 64)
+			key := make([]byte, 76)
+			for i := range key {
+				key[i] = byte(i + 1)
+			} // ignored second key-storage half deliberately nonzero
+			binary.LittleEndian.PutUint32(key, 128)
+			binary.LittleEndian.PutUint32(key[36:], 3000)
+			binary.LittleEndian.PutUint32(key[40:], 32)
+			iv := bytes.Repeat([]byte{0xa5}, 16)
+			args := []uint64{1, firstDesc, secondDesc, 16, ivAddress, 1, keyAddress, 0, 0, 0, 0}
+			if test.inPlace {
+				args[1] = secondDesc
+			}
+			if test.change != nil {
+				test.change(args, key)
+			}
+			out := bytes.Repeat([]byte{0x91}, 16)
+			calls := 0
+			provider := deviceAESDSBFixture(func(r DeviceAESDSBRequest) (DeviceAESResult, error) {
+				calls++
+				if !bytes.Equal(r.Input[:], second[:16]) || !bytes.Equal(r.IV[:], iv) || !bytes.Equal(r.DSBContext[:], key[44:76]) || !bytes.Equal(r.KeyField[:], key[4:20]) {
+					t.Fatal("incorrect fixed operands or decrypt input direction")
+				}
+				clear(r.Input[:])
+				clear(r.IV[:])
+				clear(r.KeyField[:])
+				clear(r.DSBContext[:])
+				result := DeviceAESResult{Completed: true, Output: bytes.Clone(out), IV: bytes.Clone(second[:16])}
+				if test.result != nil {
+					test.result(&result)
+				}
+				return result, test.providerErr
+			})
+			options := shimOptions{}
+			if !test.unavailable {
+				options.deviceAESDSBProvider = provider
+			}
+			m := newDeviceAESOptionsTestMachine(t, options)
+			if test.truncated {
+				if err := m.engine.MemMap(0x6000000, pageSize); err != nil {
+					t.Fatal(err)
+				}
+				keyAddress = 0x6000000 + pageSize - 40
+				args[6] = keyAddress
+				key = key[:40]
+			}
+			guardActive := false
+			if err := m.engine.GuardMemory(func(address, size uint64) error {
+				if guardActive && address == keyAddress && size == 76 {
+					return errors.New("fixture capability denial")
+				}
+				return nil
+			}); err != nil {
+				t.Fatal(err)
+			}
+			shim, err := m.services.addFunction("test.ioaes.dsb", m.services.ioAESPerform)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, item := range []struct{ address, value uint64 }{{firstDesc + 8, firstData}, {firstDesc + 16, 64}, {secondDesc + 8, secondData}, {secondDesc + 16, 64}} {
+				if err := m.services.writeUint64(item.address, item.value); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for _, item := range []struct {
+				address uint64
+				value   []byte
+			}{{firstData, first}, {secondData, second}, {keyAddress, key}, {ivAddress, iv}} {
+				if err := m.engine.MemWrite(item.address, item.value); err != nil {
+					t.Fatal(err)
+				}
+			}
+			guardActive = test.guarded
+			status, err := m.invoke(shim, args...)
+			guardActive = false
+			if test.err != "" {
+				if err == nil || !strings.Contains(err.Error(), test.err) {
+					t.Fatalf("error=%v, want %s", err, test.err)
+				}
+			} else if err != nil || status != 0 {
+				t.Fatalf("status=%d error=%v", status, err)
+			}
+			if test.providerErr != nil && !errors.Is(err, test.providerErr) {
+				t.Fatal("lost provider cause")
+			}
+			if calls != test.calls {
+				t.Fatalf("calls=%d want%d", calls, test.calls)
+			}
+			wantFirst, wantSecond, wantIV := bytes.Clone(first), bytes.Clone(second), bytes.Clone(iv)
+			if test.err == "" {
+				if test.inPlace {
+					copy(wantSecond, out)
+				} else {
+					copy(wantFirst, out)
+				}
+				copy(wantIV, second[:16])
+			}
+			for _, item := range []struct {
+				address uint64
+				want    []byte
+			}{{firstData, wantFirst}, {secondData, wantSecond}, {keyAddress, key}, {ivAddress, wantIV}} {
+				got, readErr := m.engine.MemRead(item.address, uint64(len(item.want)))
+				if readErr != nil || !bytes.Equal(got, item.want) {
+					t.Fatal("unexpected copyback or mutated request operands")
+				}
+			}
+		})
+	}
+}
+
+func TestDeviceAESDSBOverflowBeforeRead(t *testing.T) {
+	output, iv, err := (&shims{}).emulateIOAESDSB(make([]byte, 16), make([]byte, 16), 1, math.MaxUint64-40, 128, true, 0, 0)
+	var metadata *DeviceAESError
+	if output != nil || iv != nil || !errors.As(err, &metadata) || metadata.Phase != PhaseAESParameters || metadata.Purpose != 3000 || !strings.Contains(err.Error(), "address wraps") {
+		t.Fatal("overflow did not fail before engine/provider access")
+	}
+}
diff --git a/internal/sap/machine/ioaes_method_error.go b/internal/sap/machine/ioaes_method_error.go
new file mode 100644
index 0000000..65340de
--- /dev/null
+++ b/internal/sap/machine/ioaes_method_error.go
@@ -0,0 +1,26 @@
+package machine
+
+const ioAESVtableSize = 0x900
+
+// IOAESUnsupportedMethodError identifies only a fixed, registered table offset.
+// It carries no guest address, argument, register, caller or opaque input.
+type IOAESUnsupportedMethodError struct {
+	SlotOffset uint32
+}
+
+func (*IOAESUnsupportedMethodError) Error() string {
+	return "unsupported IOAESAccelerator virtual method"
+}
+
+// MetadataSlot validates the bounded scalar again at the logging boundary.
+// These three existing implemented entries cannot be unsupported-method slots.
+func (e *IOAESUnsupportedMethodError) MetadataSlot() (uint16, bool) {
+	if e == nil || e.SlotOffset >= ioAESVtableSize || e.SlotOffset%8 != 0 || e.SlotOffset == 0x20 || e.SlotOffset == 0x550 || e.SlotOffset == 0x890 {
+		return 0, false
+	}
+	return uint16(e.SlotOffset), true
+}
+
+func unsupportedIOAESMethodAt(offset uint32) shimHandler {
+	return func() error { return &IOAESUnsupportedMethodError{SlotOffset: offset} }
+}
diff --git a/internal/sap/machine/ioaes_method_error_test.go b/internal/sap/machine/ioaes_method_error_test.go
new file mode 100644
index 0000000..8d5a02c
--- /dev/null
+++ b/internal/sap/machine/ioaes_method_error_test.go
@@ -0,0 +1,118 @@
+package machine
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func TestIOAESUnsupportedMethodMetadataBounds(t *testing.T) {
+	for _, offset := range []uint32{0, 0x18, 0x28, 0x548, 0x558, 0x888, 0x898, 0x8f8} {
+		err := unsupportedIOAESMethodAt(offset)()
+		var method *IOAESUnsupportedMethodError
+		if !errors.As(fmt.Errorf("wrapper: %w", err), &method) {
+			t.Fatal("lost typed method cause")
+		}
+		value, ok := method.MetadataSlot()
+		if !ok || uint32(value) != offset || err.Error() != "unsupported IOAESAccelerator virtual method" {
+			t.Fatal("wrong fixed slot metadata/error")
+		}
+	}
+	for _, offset := range []uint32{1, 0x20, 0x550, 0x890, 0x900, 0xfffffff8} {
+		if _, ok := (&IOAESUnsupportedMethodError{SlotOffset: offset}).MetadataSlot(); ok {
+			t.Fatal("invalid offset reached metadata")
+		}
+	}
+	var missing *IOAESUnsupportedMethodError
+	if _, ok := missing.MetadataSlot(); ok {
+		t.Fatal("nil error exposed metadata")
+	}
+}
+
+func TestIOAESUnsupportedRealVtableSlots(t *testing.T) {
+	m := newServiceTestMachine(t)
+	const nameAddress, sentinelAddress = scratchBase, scratchBase + 0x100
+	if err := m.engine.MemWrite(nameAddress, []byte("IOAESAccelerator\x00")); err != nil {
+		t.Fatal(err)
+	}
+	entry := m.services.symbols["__ZN9IOService14waitForServiceEP12OSDictionaryP13mach_timespec"]
+	service, err := m.invoke(entry, nameAddress, 0)
+	if err != nil || service == 0 {
+		t.Fatalf("create service: %v", err)
+	}
+	table, err := m.services.readUint64(service)
+	if err != nil {
+		t.Fatal(err)
+	}
+	vtable, err := m.engine.MemRead(table, ioAESVtableSize)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := make(map[uint64]bool)
+	for offset := 0; offset < ioAESVtableSize; offset += 8 {
+		address := binary.LittleEndian.Uint64(vtable[offset : offset+8])
+		want := ""
+		switch offset {
+		case 0x20:
+			want = "$IOAESAccelerator.retain"
+		case 0x550, 0x890:
+			want = "$IOAESAccelerator.performAES"
+		default:
+			if seen[address] {
+				t.Fatal("unsupported table slots share a stub")
+			}
+			seen[address] = true
+			want = fmt.Sprintf("$IOAESAccelerator.unhandled.slot_%03x", offset)
+		}
+		if m.services.entries[address].name != want {
+			t.Fatal("wrong registered table entry")
+		}
+	}
+	if len(seen) != 285 {
+		t.Fatal("wrong unsupported-slot count")
+	}
+	before := bytes.Repeat([]byte{0xa7}, 96)
+	if err := m.engine.MemWrite(sentinelAddress, before); err != nil {
+		t.Fatal(err)
+	}
+	for _, offset := range []uint32{0, 0x18, 0x28, 0x548, 0x558, 0x888, 0x898, 0x8f8} {
+		address := binary.LittleEndian.Uint64(vtable[offset : offset+8])
+		_, err := m.invoke(address, service, sentinelAddress, 0xdeadbeef, 0xcafebabe)
+		var method *IOAESUnsupportedMethodError
+		var shim *ShimError
+		if !errors.As(err, &method) || !errors.As(err, &shim) {
+			t.Fatal("unsupported entry did not retain failure chain")
+		}
+		got, ok := method.MetadataSlot()
+		if !ok || uint32(got) != offset || shim.MetadataSymbol() != fmt.Sprintf("$IOAESAccelerator.unhandled.slot_%03x", offset) {
+			t.Fatal("wrong distinct slot diagnostic")
+		}
+		for _, private := range []string{"deadbeef", "cafebabe", "from 0x"} {
+			if strings.Contains(err.Error(), private) {
+				t.Fatal("unsupported error exposed guest data")
+			}
+		}
+		after, readErr := m.engine.MemRead(sentinelAddress, uint64(len(before)))
+		if readErr != nil || !bytes.Equal(after, before) {
+			t.Fatal("unsupported method changed guest memory")
+		}
+	}
+	// Existing supported entries still behave identically; no new semantics.
+	retain := binary.LittleEndian.Uint64(vtable[0x20:0x28])
+	if result, err := m.invoke(retain, service); err != nil || result != service {
+		t.Fatal("retain behavior changed")
+	}
+	for _, offset := range []int{0x550, 0x890} {
+		perform := binary.LittleEndian.Uint64(vtable[offset : offset+8])
+		if result, err := m.invoke(perform, service, 0, 0, 0, 0, 0, 0, 0); err != nil || result != 0xe00002c2 {
+			t.Fatal("existing perform early-error behavior changed")
+		}
+	}
+	codeCursor := m.services.codeCursor
+	if again, err := m.invoke(entry, nameAddress, 0); err != nil || again != service || m.services.codeCursor != codeCursor {
+		t.Fatal("service lookup duplicated slots")
+	}
+}
diff --git a/internal/sap/machine/ioaes_options.go b/internal/sap/machine/ioaes_options.go
new file mode 100644
index 0000000..ee39402
--- /dev/null
+++ b/internal/sap/machine/ioaes_options.go
@@ -0,0 +1,17 @@
+package machine
+
+const ioAESBaselineOptions = uint32(1)
+
+// ioAESGetSupportedOptions reports a restricted shim bitmap, not the full
+// physical AppleS8000AES bitmap. Baseline 1 occurs in every pinned native getter
+// branch; higher bits gate operations/handles this shim does not implement.
+// The resolved FairPlay consumer distinguishes bit5, which remains clear just
+// as on the physical M1 host. No unproved meaning is assigned to the low bits.
+// The native virtual method returns uint32; its caller owns any output pointer
+// and separate status. This method performs no provider/device query or work.
+func (s *shims) ioAESGetSupportedOptions() error {
+	if s.deviceAESProvider == nil {
+		return &IOAESUnsupportedMethodError{SlotOffset: 0x8a0}
+	}
+	return s.setResult(uint64(ioAESBaselineOptions))
+}
diff --git a/internal/sap/machine/ioaes_options_test.go b/internal/sap/machine/ioaes_options_test.go
new file mode 100644
index 0000000..4e6e82a
--- /dev/null
