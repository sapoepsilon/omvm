index 0000000..33ca737
--- /dev/null
+++ b/tools/omvm-fairplay-linux/diagnostics_test.go
@@ -0,0 +1,182 @@
+package main
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"syscall"
+	"testing"
+
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+	"github.com/majd/ipatool/v2/internal/sap/unicorn"
+)
+
+// Error must never be called by the metadata path, even on wrapping errors.
+type opaqueDiagnosticError struct{ cause error }
+
+func (opaqueDiagnosticError) Error() string   { panic("backend error text must not be inspected") }
+func (e opaqueDiagnosticError) Unwrap() error { return e.cause }
+
+func TestKernelFailureDiagnosticsNeverExposeErrorTextOrChangeWire(t *testing.T) {
+	for _, test := range []struct {
+		name  string
+		err   error
+		class string
+		id    bool
+		rpc   bool
+	}{
+		{"wrapped unsupported", opaqueDiagnosticError{&machine.MachRPCUnsupportedError{RequestBytes: 88, ReceiveCapacity: 400, MessageID: 502, HasMessageID: true}}, "mach_rpc_unsupported", true, true},
+		{"short unsupported", &machine.MachRPCUnsupportedError{RequestBytes: 16, ReceiveCapacity: 400}, "mach_rpc_unsupported", false, true},
+		{"opaque unknown", opaqueDiagnosticError{}, "kernel_unclassified", false, false},
+		{"unknown private detail", errors.New("private register=0xdeadbeef payload=PRIVATE-FIXTURE"), "kernel_unclassified", false, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			req := request{queue: 0, capacity: 4, body: []byte{1, 2, 3, 4}}
+			resp := exchange(testBackend{kernel: func([]byte) ([]byte, int32, error) {
+				return []byte("PRIVATE-FIXTURE"), -7, test.err
+			}}, req)
+			if resp.kind != responseOFR1 || resp.stage != stageInternal || resp.status != statusIO || resp.reason != "kernel_error" || len(resp.body) != 0 {
+				t.Fatal("metadata changed backend-failure semantics")
+			}
+			fields := responseMetadata(req, resp, true)
+			if fields["error_class"] != test.class {
+				t.Fatal("wrong fixed error class")
+			}
+			rpc, ok := fields["mach_rpc"].(*machRPCMetadata)
+			if ok != test.rpc || ok && (rpc.ReceiveCapacity != 400 || (rpc.MessageID != nil) != test.id) {
+				t.Fatal("wrong optional RPC metadata")
+			}
+			if test.id && (*rpc.MessageID != 502 || rpc.RequestBytes != 88) {
+				t.Fatal("wrong RPC framing scalars")
+			}
+			encoded, err := json.Marshal(fields)
+			if err != nil || bytes.Contains(encoded, []byte("PRIVATE")) || bytes.Contains(encoded, []byte("deadbeef")) || bytes.Contains(encoded, []byte("nested kernel")) {
+				t.Fatal("metadata included upstream error or payload")
+			}
+			var wire bytes.Buffer
+			if err := writeResponse(&wire, resp); err != nil {
+				t.Fatal(err)
+			}
+			if wire.Len() != 16 || string(wire.Bytes()[:4]) != "OFR1" || binary.LittleEndian.Uint32(wire.Bytes()[4:8]) != 4 || binary.LittleEndian.Uint32(wire.Bytes()[8:12]) != 5 || binary.LittleEndian.Uint32(wire.Bytes()[12:]) != 0 {
+				t.Fatal("diagnostic changed the existing empty OFR1 stage-4 EIO frame")
+			}
+		})
+	}
+}
+
+func TestSuccessfulKernelCompletionHasNoFailureMetadata(t *testing.T) {
+	req := request{queue: 0, capacity: 4, body: []byte{1, 2, 3, 4}}
+	resp := exchange(testBackend{kernel: func(p []byte) ([]byte, int32, error) { return p, -7, nil }}, req)
+	fields := responseMetadata(req, resp, true)
+	if _, ok := fields["error_class"]; ok {
+		t.Fatal("raw core status was misclassified as emulator failure")
+	}
+	if _, ok := fields["mach_rpc"]; ok {
+		t.Fatal("completion received RPC failure metadata")
+	}
+}
+
+func TestStructuredKernelFailureMetadataNeverFormatsCauses(t *testing.T) {
+	// Every wrapper's Error would reach the panic sentinel if the logger
+	// formatted errors instead of using only the reviewed scalar fields.
+	cause := opaqueDiagnosticError{cause: &unicorn.NativeError{Code: 6}}
+	shim := &machine.ShimError{Symbol: "_memcpy", Err: cause}
+	execution := &machine.ExecutionError{FailureCause: machine.FailureCause{Phase: machine.PhaseInvokeEmulate, Err: shim}}
+	kernel := &machine.KernelExchangeError{FailureCause: machine.FailureCause{Phase: machine.PhaseKernelInvoke, Err: execution}}
+	metadata := kernelFailureMetadata(kernel)
+	// A fabricated ShimError cannot assert registered-symbol provenance.
+	// The real dispatch test independently verifies _memcpy's trusted label.
+	if metadata.class != "guest_shim" || metadata.shim != "unavailable" || metadata.kernelPhase != "invoke" || metadata.executionPhase != "emulate" || metadata.unicornCode == nil || *metadata.unicornCode != 6 {
+		t.Fatal("layered failure did not identify shim and native code")
+	}
+	fields := responseMetadata(request{}, response{errorMetadata: metadata}, false)
+	encoded, err := json.Marshal(fields)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, forbidden := range []string{"address", "pointer", "register", "pc", "lr", "Error"} {
+		if bytes.Contains(encoded, []byte(forbidden)) {
+			t.Fatal("unexpected field in diagnostic metadata")
+		}
+	}
+	metadata = kernelFailureMetadata(&machine.ShimError{Symbol: "unsafe\nPRIVATE", Err: opaqueDiagnosticError{}})
+	if metadata.shim != "unavailable" {
+		t.Fatal("unreviewed symbol text leaked")
+	}
+	aes := &machine.DeviceAESError{FailureCause: machine.FailureCause{Phase: machine.PhaseAESProviderCall, Err: opaqueDiagnosticError{cause: syscall.EIO}}, Purpose: machine.DeviceAESPurpose89C, HasPurpose: true, Operation: 1, InputBytes: 592}
+	metadata = kernelFailureMetadata(aes)
+	if metadata.class != "device_aes" || metadata.deviceAES == nil || metadata.deviceAES.Phase != "provider_call" || metadata.deviceAES.Purpose == nil || *metadata.deviceAES.Purpose != 0x89c || metadata.deviceAES.InputBytes != 592 || metadata.deviceAES.Operation != 1 || metadata.deviceAES.Errno == nil || *metadata.deviceAES.Errno != 5 {
+		t.Fatal("device-AES cause lost bounded context")
+	}
+}
+
+func TestExtendedDescriptorMetadataKeepsFailureWire(t *testing.T) {
+	for _, readable := range []bool{false, true} {
+		extended := &machine.ExtendedDescriptorUnsupportedError{Err: opaqueDiagnosticError{}, KeyWord: 0x80000080, IVPresent: true, Descriptor1Offset: 16, Descriptor2Offset: 32, ReadStatus: machine.DescriptorReadUnavailable}
+		if readable {
+			extended.ReadStatus = machine.DescriptorReadComplete
+			extended.ExtensionLength = 32
+			extended.HasExtensionLength = true
+		} else {
+			extended.ReadNativeCode = 6
+			extended.HasReadNativeCode = true
+		}
+		req := request{queue: 0, capacity: 4, body: []byte{1, 2, 3, 4}}
+		resp := exchange(testBackend{kernel: func([]byte) ([]byte, int32, error) { return []byte("PRIVATE-FIXTURE"), 0, extended }}, req)
+		fields := responseMetadata(req, resp, true)
+		if fields["error_class"] != "extended_descriptor_unsupported" || resp.kind != responseOFR1 || resp.stage != 4 || resp.status != 5 || len(resp.body) != 0 {
+			t.Fatal("extended diagnostic changed failure behavior")
+		}
+		metadata, ok := fields["extended_descriptor"].(*extendedDescriptorMetadata)
+		if !ok || metadata.KeyWord != 0x80000080 || metadata.Descriptor1Offset != 16 || metadata.Descriptor2Offset != 32 || !metadata.IVPresent || (metadata.ExtensionLength != nil) != readable || (metadata.ReadNativeCode != nil) == readable {
+			t.Fatal("wrong safe extended fields")
+		}
+		encoded, err := json.Marshal(fields)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if bytes.Contains(encoded, []byte("PRIVATE")) || bytes.Contains(encoded, []byte("pointer")) || bytes.Contains(encoded, []byte("payload")) || bytes.Contains(encoded, []byte("storage")) {
+			t.Fatal("unapproved descriptor data exposed")
+		}
+		var wire bytes.Buffer
+		if err := writeResponse(&wire, resp); err != nil || wire.Len() != 16 || string(wire.Bytes()[:4]) != "OFR1" || binary.LittleEndian.Uint32(wire.Bytes()[4:8]) != 4 || binary.LittleEndian.Uint32(wire.Bytes()[8:12]) != 5 || binary.LittleEndian.Uint32(wire.Bytes()[12:]) != 0 {
+			t.Fatal("wire frame changed")
+		}
+	}
+}
+
+func TestIOAESMethodSlotMetadataKeepsFailureWireAndPrivacy(t *testing.T) {
+	for _, test := range []struct {
+		offset uint32
+		valid  bool
+	}{
+		{0, true}, {0x28, true}, {0x888, true}, {0x898, true}, {0x8f8, true},
