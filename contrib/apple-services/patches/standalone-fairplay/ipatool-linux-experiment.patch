index 0000000..e7375e8
--- /dev/null
+++ b/internal/sap/deviceaes/device_linux_arm64_test.go
@@ -0,0 +1,102 @@
+//go:build linux && arm64
+
+package deviceaes
+
+import (
+	"errors"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestLinuxDeviceIdentityWithoutRealNode(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		mutate    func(*linuxCalls, *unix.Stat_t)
+		path      string
+		wantOpen  bool
+		wantClose bool
+		wantError bool
+	}{
+		{name: "valid explicit node", wantOpen: true},
+		{name: "wrong path", path: "/dev/null", wantError: true},
+		{name: "not root", mutate: func(c *linuxCalls, _ *unix.Stat_t) { c.geteuid = func() int { return 1000 } }, wantError: true},
+		{name: "symlink", mutate: func(_ *linuxCalls, s *unix.Stat_t) { s.Mode = unix.S_IFLNK | 0600 }, wantError: true},
+		{name: "regular file", mutate: func(_ *linuxCalls, s *unix.Stat_t) { s.Mode = unix.S_IFREG | 0600 }, wantError: true},
+		{name: "wrong owner", mutate: func(_ *linuxCalls, s *unix.Stat_t) { s.Uid = 1000 }, wantError: true},
+		{name: "wide permissions", mutate: func(_ *linuxCalls, s *unix.Stat_t) { s.Mode = unix.S_IFCHR | 0660 }, wantError: true},
+		{name: "wrong major", mutate: func(_ *linuxCalls, s *unix.Stat_t) { s.Rdev = unix.Mkdev(1, 42) }, wantError: true},
+		{name: "sysfs mismatch", mutate: func(c *linuxCalls, _ *unix.Stat_t) {
+			c.readSysfs = func() ([]byte, error) { return []byte("10:43\n"), nil }
+		}, wantError: true},
+		{name: "sysfs malformed", mutate: func(c *linuxCalls, _ *unix.Stat_t) {
+			c.readSysfs = func() ([]byte, error) { return []byte("10:42:0\n"), nil }
+		}, wantError: true},
+		{name: "inode changed", mutate: func(c *linuxCalls, s *unix.Stat_t) {
+			copy := *s
+			copy.Ino++
+			c.fstat = func(_ int, out *unix.Stat_t) error { *out = copy; return nil }
+		}, wantOpen: true, wantClose: true, wantError: true},
+		{name: "device changed", mutate: func(c *linuxCalls, s *unix.Stat_t) {
+			copy := *s
+			copy.Rdev = unix.Mkdev(10, 43)
+			c.fstat = func(_ int, out *unix.Stat_t) error { *out = copy; return nil }
+		}, wantOpen: true, wantClose: true, wantError: true},
+		{name: "fstat error", mutate: func(c *linuxCalls, _ *unix.Stat_t) { c.fstat = func(int, *unix.Stat_t) error { return unix.EIO } }, wantOpen: true, wantClose: true, wantError: true},
+		{name: "open EINTR", mutate: func(c *linuxCalls, _ *unix.Stat_t) {
+			old := c.open
+			c.open = func(path string, flags int, mode uint32) (int, error) {
+				_, _ = old(path, flags, mode)
+				return -1, unix.EINTR
+			}
+		}, wantOpen: true, wantError: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			st := unix.Stat_t{Dev: 1, Ino: 2, Rdev: unix.Mkdev(10, 42), Uid: 0, Gid: 0, Mode: unix.S_IFCHR | 0600}
+			opens, closes, ioctls := 0, 0, 0
+			calls := linuxCalls{
+				geteuid: func() int { return 0 }, lstat: func(_ string, out *unix.Stat_t) error { *out = st; return nil },
+				open: func(path string, flags int, mode uint32) (int, error) {
+					opens++
+					if path != DevicePath || flags != (unix.O_RDWR|unix.O_NOFOLLOW|unix.O_CLOEXEC) || mode != 0 {
+						t.Fatal("unsafe open flags or path")
+					}
+					return 7, nil
+				},
+				fstat: func(_ int, out *unix.Stat_t) error { *out = st; return nil }, close: func(fd int) error {
+					if fd != 7 {
+						t.Fatal("closed wrong fd")
+					}
+					closes++
+					return nil
+				},
+				ioctl: func(int, uintptr, []byte) error { ioctls++; return errors.New("unexpected ioctl") }, readSysfs: func() ([]byte, error) { return []byte("10:42\n"), nil },
+			}
+			if test.mutate != nil {
+				test.mutate(&calls, &st)
+			}
+			path := test.path
+			if path == "" {
+				path = DevicePath
+			}
+			dev, err := openLinuxDevice(path, calls)
+			if (err != nil) != test.wantError {
+				t.Fatalf("error=%v", err)
+			}
+			wantOpens := 0
+			if test.wantOpen {
+				wantOpens = 1
+			}
+			wantCloses := 0
+			if test.wantClose {
+				wantCloses = 1
+			}
+			if opens != wantOpens || closes != wantCloses || ioctls != 0 {
+				t.Fatal("unexpected retries, leaked failed fd, or implicit operation")
+			}
+			if dev != nil {
+				_ = dev.close()
+			}
+		})
+	}
+}
