diff --git a/internal/sap/deviceaes/dsb.go b/internal/sap/deviceaes/dsb.go
new file mode 100644
index 0000000..feb52d2
--- /dev/null
+++ b/internal/sap/deviceaes/dsb.go
@@ -0,0 +1,107 @@
+package deviceaes
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+)
+
+const (
+	ioctlCapability = uintptr(0x8040b704)
+	ioctlDSBDecrypt = uintptr(0xc058b705)
+	capabilitySize  = 64
+	dsbDecryptSize  = 88
+	dsbOutputOffset = 56
+)
+
+// Capability is returned only by an explicit powered administrative read.
+// It does not authorize a later transform; the kernel rechecks availability.
+type Capability struct {
+	ABIVersion   uint32 `json:"abi_version"`
+	DSBAvailable bool   `json:"dsb_available"`
+	Readiness    uint32 `json:"readiness"`
+}
+
+// Capability performs one explicit powered read. Open and Status never call it.
+func (c *Controller) Capability() (Capability, error) {
+	if c == nil || c.session == nil {
+		return Capability{}, errors.New("device-AES controller is unavailable")
+	}
+	s := c.session
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.failed {
+		return Capability{}, errors.New("device-AES session cannot accept work")
+	}
+	fail := func(err error) (Capability, error) { s.failed = true; return Capability{}, err }
+	var frame [capabilitySize]byte
+	if err := s.device.ioctl(ioctlCapability, frame[:]); err != nil {
+		return fail(fmt.Errorf("explicit device-AES CAPABILITY failed: %w", err))
+	}
+	abi, available := binary.LittleEndian.Uint32(frame[:4]), binary.LittleEndian.Uint32(frame[4:8])
+	if abi != ABIVersion || available > 1 || !allZero(frame[12:]) {
+		return fail(errors.New("device-AES CAPABILITY violated the frozen ABI"))
+	}
+	return Capability{ABIVersion: abi, DSBAvailable: available == 1, Readiness: binary.LittleEndian.Uint32(frame[8:12])}, nil
+}
+
+// TransformDeviceAESDSB is an explicit, distinct operation. It does not run
+// CAPABILITY, SELFTEST or INIT. A v2 device rejects the new ioctl; no fallback or
+// retry follows. The kernel owns all command headers and completion handling.
+func (p *Provider) TransformDeviceAESDSB(request machine.DeviceAESDSBRequest) (machine.DeviceAESResult, error) {
+	defer func() {
+		clear(request.DSBContext[:])
+		clear(request.KeyField[:])
+		clear(request.IV[:])
+		clear(request.Input[:])
+	}()
+	if p == nil || p.session == nil {
+		return machine.DeviceAESResult{}, errors.New("device-AES provider is unavailable")
+	}
+	s := p.session
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.failed {
+		return machine.DeviceAESResult{}, errors.New("device-AES session cannot accept work")
+	}
+	fail := func(err error) (machine.DeviceAESResult, error) {
+		s.failed = true
+		return machine.DeviceAESResult{}, err
+	}
+	before, err := s.statusLocked()
+	if err != nil {
+		return fail(err)
+	}
+	if err := requireReady(before); err != nil {
+		return fail(err)
+	}
+	var frame [dsbDecryptSize]byte
+	defer clear(frame[:])
+	binary.LittleEndian.PutUint32(frame[:4], ABIVersion)
+	copy(frame[8:40], request.DSBContext[:])
+	copy(frame[40:56], request.KeyField[:])
+	copy(frame[56:72], request.IV[:])
+	copy(frame[72:88], request.Input[:])
+	var immutable [dsbOutputOffset]byte
+	defer clear(immutable[:])
+	copy(immutable[:], frame[:dsbOutputOffset])
+	if err := s.device.ioctl(ioctlDSBDecrypt, frame[:]); err != nil {
+		// Even EFAULT may follow a completed result's partial copy_to_user.
+		// Discard the whole private frame and never retry any errno.
+		return fail(fmt.Errorf("device-AES DSB_DECRYPT failed: %w", err))
+	}
+	if !bytes.Equal(frame[:dsbOutputOffset], immutable[:]) {
+		return fail(errors.New("device-AES DSB_DECRYPT changed immutable fields"))
+	}
+	after, err := s.statusLocked()
+	if err != nil {
+		return fail(err)
+	}
+	if err := requireReady(after); err != nil {
+		return fail(err)
+	}
+	return machine.DeviceAESResult{Completed: true, Output: bytes.Clone(frame[72:88]), IV: bytes.Clone(frame[56:72])}, nil
+}
diff --git a/internal/sap/deviceaes/dsb_test.go b/internal/sap/deviceaes/dsb_test.go
new file mode 100644
index 0000000..ee45a76
--- /dev/null
+++ b/internal/sap/deviceaes/dsb_test.go
@@ -0,0 +1,218 @@
+package deviceaes
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"reflect"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+)
+
+func dsbFixture() machine.DeviceAESDSBRequest {
+	var r machine.DeviceAESDSBRequest
+	for i := range r.DSBContext {
+		r.DSBContext[i] = byte(i + 1)
+	}
+	for i := range r.Input {
+		r.KeyField[i] = byte(i + 40)
+		r.IV[i] = byte(i + 60)
+		r.Input[i] = byte(i + 80)
+	}
+	return r
+}
+
+func TestDSBSynchronousContract(t *testing.T) {
+	request := dsbFixture()
+	original := request
+	var commands []uintptr
+	var savedFrame []byte
+	p, err := newProvider(&fakeDevice{call: func(command uintptr, f []byte) error {
+		commands = append(commands, command)
+		if command == ioctlStatus {
+			putStatus(f, Ready)
+			return nil
+		}
+		if command != 0xc058b705 || len(f) != 88 || binary.LittleEndian.Uint32(f[:4]) != 1 || !allZero(f[4:8]) || !bytes.Equal(f[8:40], request.DSBContext[:]) || !bytes.Equal(f[40:56], request.KeyField[:]) || !bytes.Equal(f[56:72], request.IV[:]) || !bytes.Equal(f[72:88], request.Input[:]) {
+			t.Fatal("wrong DSB ioctl frame")
+		}
+		savedFrame = f
+		copy(f[56:72], request.Input[:])
+		copy(f[72:88], bytes.Repeat([]byte{0x91}, 16))
+		return nil
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := p.TransformDeviceAESDSB(request)
+	if err != nil || !r.Completed || !bytes.Equal(r.IV, request.Input[:]) || !bytes.Equal(r.Output, bytes.Repeat([]byte{0x91}, 16)) {
+		t.Fatal("incorrect completed DSB output")
+	}
+	if request != original || !allZero(savedFrame) {
+		t.Fatal("caller value mutated or private frame retained")
+	}
+	if !reflect.DeepEqual(commands, []uintptr{ioctlStatus, ioctlStatus, ioctlDSBDecrypt, ioctlStatus}) {
+		t.Fatal("implicit CAPABILITY/init/selftest or extra transform")
+	}
+	_ = p.Close()
+}
+
+func TestDSBFailureDiscardsOutputAndLatchesSharedSession(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		transform func([]byte) error
+		post      func([]byte) error
+	}{
+		{name: "EINTR", transform: func(f []byte) error { f[72] = 1; return syscall.EINTR }},
+		{name: "partial copy EFAULT", transform: func(f []byte) error { f[56] = 1; f[72] = 2; return syscall.EFAULT }},
+		{name: "old module ENOTTY", transform: func([]byte) error { return syscall.ENOTTY }},
+		{name: "ABI changed", transform: func(f []byte) error { f[0]++; return nil }},
+		{name: "reserved changed", transform: func(f []byte) error { f[4]++; return nil }},
+		{name: "DSB changed", transform: func(f []byte) error { f[39]++; return nil }},
+		{name: "key field changed", transform: func(f []byte) error { f[55]++; return nil }},
+		{name: "post status error", post: func([]byte) error { return syscall.EIO }},
+		{name: "post poisoned", post: func(f []byte) error { binary.LittleEndian.PutUint32(f[4:8], uint32(Poisoned)); return nil }},
+		{name: "post busy", post: func(f []byte) error { f[12] |= byte(FlagBusy); return nil }},
+		{name: "post malformed", post: func(f []byte) error { f[63] = 1; return nil }},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			calls, transforms := 0, 0
+			var saved []byte
+			p, err := newProvider(&fakeDevice{call: func(command uintptr, f []byte) error {
+				calls++
+				if command == ioctlStatus {
+					putStatus(f, Ready)
+					if transforms > 0 && test.post != nil {
+						return test.post(f)
+					}
+					return nil
+				}
+				if command != ioctlDSBDecrypt {
+					t.Fatal("unexpected command")
+				}
+				transforms++
+				saved = f
+				if test.transform != nil {
+					return test.transform(f)
+				}
+				return nil
+			}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			request := dsbFixture()
+			original := request
+			r, err := p.TransformDeviceAESDSB(request)
+			requireNoResult(t, r, err)
+			if test.name == "EINTR" && !errors.Is(err, syscall.EINTR) {
+				t.Fatal("lost errno")
+			}
+			if request != original || !allZero(saved) {
+				t.Fatal("request mutated or failed frame retained")
+			}
+			before := calls
+			r, err = p.TransformDeviceAESDSB(request)
+			requireNoResult(t, r, err)
+			r, err = p.TransformDeviceAES(testRequest(true))
+			requireNoResult(t, r, err)
+			if calls != before || transforms != 1 {
+				t.Fatal("failed session retried or accepted ordinary transform")
+			}
+			_ = p.Close()
+		})
+	}
+}
+
+func TestExplicitCapability(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		available uint32
+		mutate    func([]byte) error
+		fails     bool
+	}{
+		{name: "available", available: 1}, {name: "disabled", available: 0},
+		{name: "invalid bool", available: 2, fails: true},
+		{name: "invalid ABI", mutate: func(f []byte) error { f[0] = 2; return nil }, fails: true},
+		{name: "reserved", mutate: func(f []byte) error { f[63] = 1; return nil }, fails: true},
+		{name: "EINTR", mutate: func(f []byte) error { f[4] = 1; return syscall.EINTR }, fails: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			calls := 0
+			c := &Controller{session: &session{device: &fakeDevice{call: func(command uintptr, f []byte) error {
+				calls++
+				if command != 0x8040b704 || len(f) != 64 || !allZero(f) {
+					t.Fatal("unexpected capability command or initialization")
+				}
+				binary.LittleEndian.PutUint32(f[:4], 1)
+				binary.LittleEndian.PutUint32(f[4:8], test.available)
+				binary.LittleEndian.PutUint32(f[8:12], 0x3f80)
+				if test.mutate != nil {
+					return test.mutate(f)
+				}
+				return nil
+			}}}}
+			r, err := c.Capability()
+			if test.fails {
+				if err == nil || r != (Capability{}) {
+					t.Fatal("failed capability exposed data")
+				}
+				_, _ = c.Capability()
+				if calls != 1 {
+					t.Fatal("capability failure retried")
+				}
+			} else if err != nil || r.ABIVersion != 1 || r.Readiness != 0x3f80 || r.DSBAvailable != (test.available == 1) {
+				t.Fatal("invalid capability metadata")
+			}
+			_ = c.Close()
+		})
+	}
+}
+
+func TestDSBSerializesWithOrdinaryTransformAndClose(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	ordinaryEntered, closed := make(chan struct{}), make(chan struct{})
+	p, err := newProvider(&fakeDevice{call: func(command uintptr, frame []byte) error {
+		switch command {
+		case ioctlStatus:
+			putStatus(frame, Ready)
+		case ioctlDSBDecrypt:
+			close(entered)
+			<-release
+		case ioctlTransform:
+			close(ordinaryEntered)
+		default:
+			t.Error("unexpected ioctl")
+		}
+		return nil
+	}, closing: func() error { close(closed); return nil }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	dsbDone, ordinaryDone, closeDone := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(dsbDone)
+		r, err := p.TransformDeviceAESDSB(dsbFixture())
+		if err != nil || !r.Completed {
+			t.Error("DSB completion failed")
+		}
+	}()
+	<-entered
+	go func() { defer close(ordinaryDone); _, _ = p.TransformDeviceAES(testRequest(true)) }()
+	go func() { defer close(closeDone); _ = p.Close() }()
+	select {
+	case <-ordinaryEntered:
+		t.Error("ordinary transform raced DSB ioctl")
+	case <-closed:
+		t.Error("Close raced DSB ioctl")
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(release)
+	<-dsbDone
+	<-ordinaryDone
+	<-closeDone
+	r, err := p.TransformDeviceAESDSB(dsbFixture())
+	requireNoResult(t, r, err)
+}
