+package machine
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"math"
+	"testing"
+)
+
+func TestExtendedDescriptorOverflowDoesNotRead(t *testing.T) {
+	cause := errors.New("original unsupported cause")
+	metadata := (&shims{}).diagnoseExtendedDescriptor(math.MaxUint64-40, 128, false, 0, 0, cause)
+	if metadata.ReadStatus != DescriptorReadAddressOverflow || metadata.HasExtensionLength || metadata.HasReadNativeCode || !errors.Is(metadata, cause) || metadata.Error() != cause.Error() {
+		t.Fatal("overflow read or changed unsupported cause")
+	}
+}
+
+func TestExtendedDescriptorRealShimMetadataOnly(t *testing.T) {
+	for _, test := range []struct {
+		name                          string
+		handle, word, extensionLength uint32
+		present, truncated, guarded   bool
+		wantExtended                  bool
+		wantRead                      DescriptorReadStatus
+	}{
+		{"readable", 3000, 128, 32, true, false, false, true, DescriptorReadComplete},
+		{"raw first word and null IV", 3000, 0x80000080, 32, false, false, false, true, DescriptorReadComplete},
+		{"short declared extension still rejected", 3000, 128, 0, false, false, false, true, DescriptorReadComplete},
+		{"large declared extension does not expand read", 3000, 128, math.MaxUint32, true, false, false, true, DescriptorReadComplete},
+		{"prefix readable extension unmapped", 3000, 128, 32, true, true, false, true, DescriptorReadUnavailable},
+		{"memory capability denies extension", 3000, 128, 32, true, false, true, true, DescriptorReadUnavailable},
+		{"neighbor handle reads only prefix", 3001, 128, 32, true, true, false, false, DescriptorReadUnavailable},
+		{"flagged handle reads only prefix", 0x80000bb8, 128, 32, true, true, false, false, DescriptorReadUnavailable},
+		{"existing purpose reads only prefix", DeviceAESPurpose89C, 128, 32, true, true, false, false, DescriptorReadUnavailable},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			calls := 0
+			providerErr := errors.New("fixture provider rejects")
+			provider := deviceAESFixtureProvider(func(DeviceAESRequest) (DeviceAESResult, error) { calls++; return DeviceAESResult{}, providerErr })
+			m := newDeviceAESProviderTestMachine(t, provider)
+			entry, err := m.services.addFunction("test.ioaes.extended", m.services.ioAESPerform)
+			if err != nil {
+				t.Fatal(err)
+			}
+			const firstDesc, secondDesc = scratchBase, scratchBase + 0x100
+			const firstData, secondData, ivAddress = scratchBase + 0x200, scratchBase + 0x300, scratchBase + 0x500
+			keyAddress := uint64(scratchBase + 0x400)
+			if test.truncated {
+				if err := m.engine.MemMap(0x6000000, pageSize); err != nil {
+					t.Fatal(err)
+				}
+				keyAddress = 0x6000000 + pageSize - 40
+			}
+			for _, item := range []struct{ address, value uint64 }{{firstDesc + 8, firstData}, {firstDesc + 16, 96}, {secondDesc + 8, secondData}, {secondDesc + 16, 96}} {
+				if err := m.services.writeUint64(item.address, item.value); err != nil {
+					t.Fatal(err)
+				}
+			}
+			key := bytes.Repeat([]byte{0x6b}, 76)
+			binary.LittleEndian.PutUint32(key[:4], test.word)
+			binary.LittleEndian.PutUint32(key[36:40], test.handle)
+			binary.LittleEndian.PutUint32(key[40:44], test.extensionLength)
+			if test.truncated {
+				key = key[:40]
+			}
+			first, second, iv := bytes.Repeat([]byte{0x31}, 96), bytes.Repeat([]byte{0x52}, 96), bytes.Repeat([]byte{0x73}, 16)
+			for _, item := range []struct {
+				address uint64
+				data    []byte
+			}{{firstData, first}, {secondData, second}, {ivAddress, iv}, {keyAddress, key}} {
+				if err := m.engine.MemWrite(item.address, item.data); err != nil {
+					t.Fatal(err)
+				}
+			}
+			reads76 := 0
+			if err := m.engine.GuardMemory(func(address, size uint64) error {
+				if address == keyAddress && size == 76 {
+					reads76++
+					if test.guarded {
+						return errors.New("fixture capability denial")
+					}
+				}
+				return nil
+			}); err != nil {
+				t.Fatal(err)
+			}
+			ivPointer := uint64(0)
+			if test.present {
+				ivPointer = ivAddress
+			}
+			_, err = m.invoke(entry, 1, firstDesc, secondDesc, 16, ivPointer, 1, keyAddress, 16, 32, 0, 0)
+			if err == nil {
+				t.Fatal("unsupported descriptor became success")
+			}
+			var extended *ExtendedDescriptorUnsupportedError
+			if errors.As(err, &extended) != test.wantExtended {
+				t.Fatal("extended diagnostic applied to wrong handle")
+			}
+			if test.wantExtended {
+				if calls != 0 || reads76 != 1 || extended.KeyWord != test.word || extended.IVPresent != test.present || extended.Descriptor1Offset != 16 || extended.Descriptor2Offset != 32 || extended.ReadStatus != test.wantRead {
+					t.Fatal("wrong scalar metadata, read size or provider call")
+				}
+				readable := test.wantRead == DescriptorReadComplete
+				if extended.HasExtensionLength != readable || readable && extended.ExtensionLength != test.extensionLength {
+					t.Fatal("extension length exposed without complete bounded read")
+				}
+				if extended.HasReadNativeCode != test.truncated || test.truncated && extended.ReadNativeCode != 6 {
+					t.Fatal("read failure code lost or invented")
+				}
+				var old *DeviceAESError
+				if !errors.As(err, &old) || old.Phase != PhaseAESPurpose || old.Purpose != 3000 {
+					t.Fatal("old unsupported error chain lost")
+				}
+				want := fmt.Sprintf("test.ioaes.extended: IOAES operation 0x1, length 16, descriptor first word %#x, callback present false: unsupported IOAES key handle 0xbb8", test.word)
+				if err.Error() != want {
+					t.Fatal("original rejection text changed")
+				}
+			} else if reads76 != 0 || test.handle == DeviceAESPurpose89C && (calls != 1 || !errors.Is(err, providerErr)) || test.handle != DeviceAESPurpose89C && calls != 0 {
+				t.Fatal("other handle changed reads or provider behavior")
+			}
+			for _, item := range []struct {
+				address uint64
+				want    []byte
+			}{{firstData, first}, {secondData, second}, {ivAddress, iv}, {keyAddress, key}} {
+				// Avoid a second 76-byte read that would disturb the access count
+				// or hit the intentional capability denial.
+				for i, b := range item.want {
+					got, readErr := m.engine.MemRead(item.address+uint64(i), 1)
+					if readErr != nil || got[0] != b {
+						t.Fatal("diagnostic changed input, output, IV or descriptor")
+					}
+				}
+			}
+		})
+	}
+}
diff --git a/internal/sap/machine/failure_metadata.go b/internal/sap/machine/failure_metadata.go
new file mode 100644
index 0000000..d4df10b
--- /dev/null
+++ b/internal/sap/machine/failure_metadata.go
@@ -0,0 +1,141 @@
+package machine
+
+// FailurePhase names a fixed operation boundary, never guest data or an error
+// string. Unknown enum values deliberately produce a fixed fallback label.
+type FailurePhase uint8
+
+const (
+	PhaseUnknown FailurePhase = iota
+	PhaseInvokeEntry
+	PhaseInvokeArguments
+	PhaseInvokeStackArguments
+	PhaseInvokeFrame
+	PhaseInvokeEmulate
+	PhaseInvokeCompatibility
+	PhaseInvokeResume
+	PhaseInvokeCompletion
+	PhaseInvokeUnexpectedStop
+	PhaseInvokeResult
+	PhaseKernelSession
+	PhaseKernelInput
+	PhaseKernelProbeRead
+	PhaseKernelProbeValidate
+	PhaseKernelScratch
+	PhaseKernelInvoke
+	PhaseKernelReadback
+	PhaseAESParameters
+	PhaseAESAbsentIV
+	PhaseAESPurpose
+	PhaseAESKeyWidth
+	PhaseAESOperation
+	PhaseAESProviderUnavailable
+	PhaseAESProviderCall
+	PhaseAESCompletion
+	PhaseAESOutput
+)
+
+func (p FailurePhase) String() string {
+	switch p {
+	case PhaseInvokeEntry:
+		return "entry"
+	case PhaseInvokeArguments:
+		return "argument_registers"
+	case PhaseInvokeStackArguments:
+		return "stack_arguments"
+	case PhaseInvokeFrame:
+		return "call_frame"
+	case PhaseInvokeEmulate:
+		return "emulate"
+	case PhaseInvokeCompatibility:
+		return "instruction_compatibility"
+	case PhaseInvokeResume:
+		return "resume"
+	case PhaseInvokeCompletion:
+		return "completion_pc"
+	case PhaseInvokeUnexpectedStop:
+		return "unexpected_stop"
+	case PhaseInvokeResult:
+		return "result_register"
+	case PhaseKernelSession:
+		return "session"
+	case PhaseKernelInput:
+		return "input_bounds"
+	case PhaseKernelProbeRead:
+		return "stack_probe_read"
+	case PhaseKernelProbeValidate:
+		return "stack_probe_validation"
+	case PhaseKernelScratch:
+		return "scratch_input"
+	case PhaseKernelInvoke:
+		return "invoke"
+	case PhaseKernelReadback:
+		return "readback"
+	case PhaseAESParameters:
+		return "parameters"
+	case PhaseAESAbsentIV:
+		return "absent_iv"
+	case PhaseAESPurpose:
+		return "purpose"
+	case PhaseAESKeyWidth:
+		return "key_width"
+	case PhaseAESOperation:
+		return "operation"
+	case PhaseAESProviderUnavailable:
+		return "provider_unavailable"
+	case PhaseAESProviderCall:
+		return "provider_call"
+	case PhaseAESCompletion:
+		return "completion"
+	case PhaseAESOutput:
+		return "output_shape"
+	default:
+		return "unknown"
+	}
+}
+
+// FailureCause preserves the original human-readable error and errors.Is/As
+// chain. Logging must use the reviewed scalar metadata, never this error text.
+type FailureCause struct {
+	Phase FailurePhase
+	Err   error
+}
+
+func (e FailureCause) Error() string { return e.Err.Error() }
+func (e FailureCause) Unwrap() error { return e.Err }
+
+type ExecutionError struct{ FailureCause }
+type KernelExchangeError struct{ FailureCause }
+
+// ShimError is created only after lookup in the registered shim entries map.
+// Err retains the original symbol-prefixed error for existing callers.
+type ShimError struct {
+	Symbol     string
+	Err        error
+	registered bool // Set only by dispatch after its entries-map lookup.
+}
+
+func (e *ShimError) Error() string { return e.Err.Error() }
+func (e *ShimError) Unwrap() error { return e.Err }
+
+// MetadataSymbol excludes unbounded/unexpected names even if a future caller
+// accidentally registers one. Symbols originate from code or verified imports,
+// never from formatting error text, guest buffers, or runtime dlsym strings.
+func (e *ShimError) MetadataSymbol() string {
+	if !e.registered || len(e.Symbol) == 0 || len(e.Symbol) > 256 {
+		return "unavailable"
+	}
+	for _, c := range e.Symbol {
+		if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '$' || c == ':' || c == '+' || c == '-') {
+			return "unavailable"
+		}
+	}
+	return e.Symbol
+}
+
+type DeviceAESError struct {
+	FailureCause
+	Purpose    uint32
+	HasPurpose bool
+	Operation  uint32
+	InputBytes int
+}
