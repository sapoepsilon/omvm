--- /dev/null
+++ b/internal/sap/unicorn/native_error_test.go
@@ -0,0 +1,27 @@
+package unicorn
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+)
+
+func TestNativeErrorCodePreservesText(t *testing.T) {
+	engine := &Engine{api: api{strerror: func(code int32) string {
+		if code != 6 {
+			t.Fatal("wrong code")
+		}
+		return "Invalid memory read (UC_ERR_READ_UNMAPPED)"
+	}}}
+	if engine.err(0) != nil {
+		t.Fatal("success gained an error")
+	}
+	err := engine.err(6)
+	if err.Error() != "unicorn error 6: Invalid memory read (UC_ERR_READ_UNMAPPED)" {
+		t.Fatal("native error text changed")
+	}
+	var native *NativeError
+	if !errors.As(fmt.Errorf("memory read: %w", err), &native) || native.Code != 6 {
+		t.Fatal("wrapped native code was lost")
+	}
+}
diff --git a/tools/omvm-fairplay-linux/README.md b/tools/omvm-fairplay-linux/README.md
new file mode 100644
index 0000000..1a0caab
--- /dev/null
+++ b/tools/omvm-fairplay-linux/README.md
@@ -0,0 +1,289 @@
+# Experimental offline Linux FairPlay socket adapter
+
+This diagnostic adapter translates the OFP1/OFP2 Unix-socket protocol
+to the pinned, locally modified `ModernADI` emulator. Its v23 durable-state
+extension adds identity-bound checkpoints; guest/helper/host reboot recovery
+still requires integration validation. It never connects to a macOS relay,
+Apple account service, or alternate backend, and never substitutes output or a
+success status after a backend failure.
+
+The executable requires one explicit identity mode:
+
+- `-diagnostic-synthetic`: fixed synthetic 16-byte test identity and empty ADI
+  state. Use only for isolated protocol experiments, never account sign-in.
+- `-identifier-file PATH`: reads exactly 16 raw bytes from a regular, nonsymlink,
+  current-user-owned mode-0600 file. This prepares an owned VM identity boundary;
+  it does not establish identity correctness. Persistence is separately enabled.
+
+Without `-state-file`, both modes still initialize empty in-memory ADI state,
+which is lost at process exit. No automatic restart or migration is safe to
+assume. There is no account password, token or state-dump option. Logs contain
+fixed reason labels, queues, sizes and statuses only.
+
+## Explicit durable state
+
+`-state-file PATH` requires an existing checkpoint bound to the exact 16-byte
+identifier. The process and checkpoint directory must be root-owned, the
+directory mode 0700 and files mode 0600. Symlinks, hard links, wrong ownership,
+unsupported format, oversized/truncated/corrupt content and a different VM
+identifier fail startup. A private lock prevents concurrent backend owners.
+All file operations use a pinned directory descriptor. Checkpoints are bounded
+to 1 MiB and replaced only after writing and syncing a complete temporary file,
+followed by an atomic rename and directory sync. The SHA-256 envelope detects
+corruption; it is not a tamper-proof counter against root restoring old files.
+
+Create an empty checkpoint once, explicitly, in a new root-private directory:
+
+```sh
+backend -initialize-state -identifier-file /private/vm.identifier \
+  -state-file /private/vm-state/state.bin
+```
+
+This mode exits before loading assets, opening a hardware provider or a socket.
+It refuses existing state. Normal service startup omits `-initialize-state` and
+fails if the checkpoint is missing; it never silently creates empty state.
+
+Only the daemon's virtual `/var/db/fpsd/adi/adi.pb` is durable. Its missing,
+present-empty and populated forms remain distinct. Queue 3 reaches this daemon;
+queue 0 operates on the separate kernel runtime and cannot mutate the file in
+the implemented call graph. Before native initialization or a queue-3 request,
+the backend syncs a dirty marker. It snapshots completed native state, commits
+any change and clears/syncs the marker before acknowledging a successful call.
+A clean negative native status can continue only if the state is unchanged.
+An error, malformed reply, snapshot/write failure or changed state after a
+negative status stops the process and leaves recovery blocked. A surviving
+`.dirty` or `.next` file is never automatically removed or rolled back.
+
+This does not serialize transient emulator/kernel sessions or establish that a
+live guest can reconnect after helper loss. Use a cold guest boot for recovery
+tests and keep `Restart=no` until the complete lifecycle has been verified.
+There is no supported state export from a running v22 backend; retain that
+process for controlled migration/rollback instead of dumping its memory.
+
+The persistence tests use synthetic bytes, real root-owned temporary files and
+a Unix socket. They cover restart round trips, corrupt/wrong-VM state, ownership,
+exclusive locking, crash markers, actual short writes under a process-local
+file-size limit, and commit-before-acknowledgement. They perform no hardware
+operations or Apple network requests and do not prove account recovery.
+
+Build from the ipatool checkout containing the strict machine changes:
+
+```sh
+CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o /tmp/omvm-fairplay-linux ./tools/omvm-fairplay-linux
+```
+
+An isolated diagnostic launch, after verified pinned Apple assets and Unicorn
+have already been cached through the separate bounded probe:
+
+```sh
+install -d -m 0700 /tmp/omvm-fairplay-isolated
+XDG_CACHE_HOME=/path/to/existing/private/cache /tmp/omvm-fairplay-linux \
+  -socket /tmp/omvm-fairplay-isolated/relay.sock -diagnostic-synthetic
+```
+
+All HTTP requests are rejected, including cache misses. Asset hash verification
+still runs. The adapter exposes its socket only after backend initialization.
+Use a process supervisor with CPU/memory limits and a startup timeout for actual
+experiments; this directory does not install or modify a service or VM.
+
+The socket parent must be an owned nonsymlink directory with mode 0700; the
+socket uses mode 0600. An existing socket/file is never replaced. Requests are
+serialized through one `ModernADI` instance, preserving its session across both
+queues. A caller writes one frame, half-closes its write side, then reads the
+response until EOF. Trailing or incomplete request bytes are rejected before
+backend execution.
+
+- OFP1 selects queue 3; OFP2 permits only queues 0 and 3.
+- Nonzero input/output sizes are limited to 1 MiB. Queue 3 payloads are limited
+  to 1 MiB minus 16 bytes because the backend includes its wrapper in that limit.
+- Queue 0 sends the input bytes directly to `ExchangeKernelBuffer`. A completed
+  kernel call returns `OFR2`, stage 0, raw signed core-status bits, and the exact
+  same-length modified buffer, **including when core status is nonzero**. This
+  matches native queue-0 copy-back semantics; status is not converted to zero.
+  A missing or wrong-length returned buffer is a framing failure.
+- Queue 3 builds the verified 16-byte big-endian wrapper and decodes the native
+  status/length reply. It enforces output capacity before copying. Native-allowed
+  trailing XPC bytes are ignored, while trailing socket frame bytes are rejected.
+- All OFR1/OFR2 response words are little-endian. Queue 3 continues using OFR1:
+  backend errors use stage 0 and unchanged status bits without a body. An OFR1
+  error can never carry output. Framing/parser/capacity errors use body-free OFR1
+  stage 1; emulator errors use body-free OFR1 stage 4.
+- OFR2 is permitted **only** for queue-0 completions, with stage 0 and a nonempty
+  body exactly matching the request length within its output capacity. Its core
+  status is reported independently of the buffer copied back to the guest.
+  **This requires updated QEMU OFR2 support. Older QEMU intentionally rejects
+  OFR2; do not connect this adapter to an old frontend.** Queue 3 and generic
+  failures retain OFR1 compatibility.
+- The default whole-request deadline is 12 seconds (allowed range 1–12), below
+  the existing QEMU timeout. A backend timeout or emulator error terminates the
+  process so uncertain in-memory state is not reused. A forced exit deliberately
+  leaves the socket path: confirm the process is gone before removing it.
+
+`go test ./tools/omvm-fairplay-linux` tests native reply edge cases, status
+preservation, queue-0 error-buffer copy-back, response-version separation,
+framing rejection, queue wrapping/routing, a real Unix-socket
+session with half-close/EOF, permissions, and an unterminated-request timeout.
+The tests use a fake backend; they do not validate Apple code or authenticate an
+account. Run the separate isolated probe for strict backend runtime diagnosis.
+
+The IOAES descriptor shim preserves the pinned synchronous ABI's descriptor
+offsets. Operation 0 reads descriptor1+x7 and writes descriptor2+stack8;
+operation 1 reads descriptor2+stack8 and writes descriptor1+x7. Both directions
+retain each offset's association with its descriptor. The nullable 16-byte IV
+supplies zeros when absent and then has no copyback address. It rejects asynchronous callbacks explicitly and retains
+the smaller diagnostic allocation limit. Without an explicitly configured provider, device-key operations remain
+unavailable; these ABI corrections do not provide a hardware transform.
+`go test ./internal/sap/machine -run '^TestIOAESDescriptorABI$'` drives the real
+ARM64 shim with synthetic descriptors to check null/non-null IVs, argument
+locations, native early-error codes, address bounds, and unchanged output/IV
+on rejection. It requires the verified Unicorn runtime, but no Apple assets
+or hardware-key operation. Successful cryptographic completion is not covered.
+
+`ModernADIOptions` also accepts an explicit synchronous `DeviceAESProvider`.
+The default remains unavailable. The narrow interface accepts only the observed
+0x899/0x89c purposes, operation 0 (CBC encrypt) or 1 (CBC decrypt), and AES-128, preserving whether the native IV
+pointer was absent. It sends private copies rather than guest pointers or key
+storage, and requires completed, correctly sized output and IV before copyback.
+Focused provider tests exercise both purposes, failures, incomplete results,
+malformed outputs and buffer ownership through the real ARM64 shim. Their fixed
+result provider is test-only; it proves interface behavior, not hardware AES.
+No Linux device is selected or initialized by this API alone.
+
+## Optional Linux device provider
+
+Queue-0 emulator failures retain the existing empty OFR1 stage-4/EIO response
+and stop the backend. Logs additionally classify the concrete unsupported kernel
+Mach RPC guard as `mach_rpc_unsupported`, with only `request_bytes`,
+`receive_capacity`, and (for a complete 32-byte kernel header) integer
+`message_id` at offset 28. The native size word need not be initialized and is
+not logged. Other typed errors identify the registered shim (`guest_shim`),
+device-AES boundary (`device_aes`), emulator invocation (`guest_execution`), or
+outer kernel-call boundary (`kernel_boundary`). Logs include only fixed phase
+labels, a bounded registered shim symbol, and a numeric Unicorn API code when
+available. Device-AES failures include purpose, operation, input byte length
+and an underlying numeric errno when available. Unrecognized errors remain
+`kernel_unclassified`. Error strings, PC/LR, register values, pointers, ports,
+payloads and even code addresses/offsets are omitted. Typed wrappers preserve
+the original error text and cause for callers; the logging path never formats
+that text. These diagnostics do not start fairplayd, dispatch RPC, change device
+calls, or relax the unsupported guard.
+
+With no separate DSB provider selected, raw key handle 3000 retains the v19
+rejection: `extended_descriptor_unsupported` additionally
+reports the raw `key_word`, extension length at +0x28 when readable, IV presence,
+and `descriptor1_offset`/`descriptor2_offset` from the proven argument positions.
+It reads exactly the native minimum 76-byte descriptor after an address-overflow
+check and through the emulator memory guard; a larger claimed extension length
+does not cause a larger read. Temporary bytes are cleared, and no key-storage or
+DSB bytes/pointers are retained or logged. Failed reads report only a fixed status
+and optional numeric Unicorn code. The original unsupported error/cause remains,
+with no provider call or output/IV write. These scalars do not establish key width,
+descriptor validity, DSB semantics, hardware support, or successful execution.
+
+The adapter accepts `-device-aes /dev/omvm-uid1-provider` only as an explicit
+Linux ARM64 opt-in. Omitting it preserves the unavailable default. This client
+requires root and the exact nonsymlink, root-owned mode-0600 character device;
+it compares the opened inode/device identity and registered misc major/minor
+against `/sys/class/misc/omvm-uid1-provider/dev`. It requires idle READY status
+before backend initialization and before/after each transform. It never performs
+SELFTEST, loads seeds, initializes a device, discovers another node, or falls
+back to another provider.
+
+The frozen ABI accepts purposes 0x899/0x89c, operations 0/1, AES-128, and one
+16–4096-byte block-aligned payload. Larger operations fail; they are not split
+into guessed chunks. The client copies inline input and the 16-byte IV, preserves
+IV presence, zeroes reserved/tail bytes, and checks unchanged control fields,
+output bounds, zero absent IV, and idle READY status after synchronous ioctl
+success. It does not interpret `completed_ops` or `last_errno` as completion
+proof. Errors, including EINTR, are never retried and prevent further work on
+that client. Close waits for an in-flight ioctl; there is no asynchronous ioctl
+timeout or return while its buffers remain active. The existing adapter watchdog
+still terminates the process rather than returning a late successful response;
+the kernel must own and pin any outstanding DMA independently.
+
+Operation 1 uses the same generated purpose key and descriptor layout as
+operation 0; it changes only the CBC direction. The provider supplies the updated
+IV after completed success. For decrypt this state is the final original input
+ciphertext block, not the plaintext output. NULL IV still means a zero input IV
+with no guest IV copyback. This extension requires the operation-1-capable kernel
+provider (v2); ioctl numbers, structure sizes and ABI version 1 are unchanged.
+The older provider rejects decrypt explicitly. Fake-device and real-shim tests
+cover both directions and error copyback; they do not prove a hardware decrypt.
+
+When this root-only provider is selected, the existing socket and identifier-file
+ownership rules apply to root too. Use a root-owned private socket directory and
+identifier file; no permissions are relaxed automatically. The client code and
+fake-device tests are preparation, not evidence of a working hardware transform.
+
+A separate root diagnostic executable, `tools/omvm-uid1-diagnostic`, exposes only
+explicit `-action status`, `-action capability`, `-action selftest`, or
+`-action init` operations with
+`-device /dev/omvm-uid1-provider`. Initialization additionally requires
+`-seed-file PATH`: an explicit root-owned nonsymlink regular mode-0600 file,
+exactly 32 bytes, matching the frozen pinned-bundle hash. The file supplies no
+arbitrary key. The diagnostic prints cached status metadata and fixed errors,
+never seed, key, IV, or payload bytes. It does not perform a transform or chain
+selftest/init automatically. Do not run hardware operations before the separate
+kernel review and activation procedure is complete.
+
+
+## Separate extended-descriptor opt-in (v3)
+
+`-device-aes-dsb` additionally enables the separate `DeviceAESDSBProvider` API
+and requires an explicit `-device-aes` path. The older flag alone preserves the
+v19 handle-3000 rejection. Opening either provider reads only cached STATUS;
+there is no implicit CAPABILITY, SELFTEST, INIT, fallback, or alternate node.
+The diagnostic CLI's explicit `-action capability` is a powered read of readiness
+and availability, unlike cached STATUS. It does not submit an AES command.
+
+This path accepts only the observed unflagged raw word 128, handle 3000, extension
+length 32, CBC-decrypt operation 1, exactly 16 input bytes, present 16-byte IV, null
+callback, and zero descriptor offsets. The shim checks both descriptor ranges
+and reads the fixed 76-byte descriptor through its memory guard. Operation 1
+reads descriptor2 and writes descriptor1, including distinct buffers. It passes
+owned copies of the 32 opaque DSB bytes and the first 16 key-storage bytes; the
+remaining 16 storage bytes are ignored, not required to be zero. These inputs
+are not identified as plaintext keys or authenticated records and are never
+logged. Provider request arrays and temporary descriptor/transport buffers are
+cleared after the synchronous call.
+
+The frozen v3 `DSB_DECRYPT` ioctl is 0xc058b705 with 88 inline bytes: ABI/reserved,
+DSB32, key-field16, IV16, and data16. There are no caller-supplied selectors,
+command headers, pointers or variable sizes. The kernel owns hardware context,
+commands, availability recheck, completion and failure handling. The client
+serializes this operation with ordinary transforms and Close, requires cached
+idle READY before and after, verifies every immutable header/opaque input byte,
+and returns only the completed IV/data. Any errno (including EINTR or a partial
+completed-output EFAULT), malformed response, or bad post-status latches the
+shared session and returns no output. It never retries or returns while the
+ioctl is still running. Old v2 modules reject the new ioctl explicitly.
+
+The new explicit CAPABILITY ioctl is 0x8040b704 with 64 output bytes. The client
+checks ABI 1, boolean availability and zero reserved bytes. Capability results
+are metadata; each DSB submission independently rechecks the physical hardware.
+No claim of hardware DSB acceptance, record authentication, or Apple Account
+sign-in follows from these source changes or the fake-provider tests. Existing
+wire errors and backend-exit behavior remain unchanged.
+
+Unsupported IOAES virtual methods remain failures. V21 registers one distinct
+stub per unsupported entry in the existing 0x900-byte table and reports
+`ioaes_method_unsupported` with `ioaes_vtable_offset`, a byte offset aligned to 8
+and strictly below 0x900. The three existing implemented entries are excluded.
+The registered shim label also identifies this fixed slot. No caller, LR,
+argument register, guest pointer, or input buffer is read for this diagnostic;
+the error text is fixed and no longer contains a caller address. Retain and the
+two existing perform aliases keep their behavior. Failure responses remain empty
+OFR1 stage 4/EIO and stop the backend. This identifies a boundary only; it does
+not implement the missing method or infer its semantics from the slot number.
+
+V22 supports only the observed `getSupportedOptions` slot 0x8a0 when the ordinary
+`DeviceAESProvider` was explicitly injected. It returns uint32 baseline bitmap 1,
+with every other bit clear; it reports a restricted shim subset, not the full
+physical AppleS8000AES bitmap 0x1d. Baseline 1 occurs in all pinned native getter
+branches, and the resolved FairPlay caller's bit 5 decision is identical for 1 and
+the M1 physical bitmap. No unproved semantic names are assigned to the low bits.
+Known higher-bit operations/handles remain unsupported. The method reads no
+extra arguments or caller output pointer and performs no transform, MMIO,
+CAPABILITY, initialization, or readiness query; the native wrapper owns its
+output-pointer write and status. Without the ordinary provider (including with
+only a DSB provider), the original slot 0x8a0 failure and bounded diagnostic remain.
diff --git a/tools/omvm-fairplay-linux/diagnostics.go b/tools/omvm-fairplay-linux/diagnostics.go
new file mode 100644
index 0000000..b8686d5
--- /dev/null
+++ b/tools/omvm-fairplay-linux/diagnostics.go
@@ -0,0 +1,153 @@
+package main
+
+import (
+	"errors"
+	"syscall"
+
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+	"github.com/majd/ipatool/v2/internal/sap/unicorn"
+)
+
+type machRPCMetadata struct {
+	RequestBytes    int    `json:"request_bytes"`
+	ReceiveCapacity int    `json:"receive_capacity"`
+	MessageID       *int32 `json:"message_id,omitempty"`
+}
+
+type backendErrorMetadata struct {
+	class              string
+	machRPC            *machRPCMetadata
+	shim               string
+	executionPhase     string
+	kernelPhase        string
+	unicornCode        *int32
+	deviceAES          *deviceAESMetadata
+	extendedDescriptor *extendedDescriptorMetadata
+	ioAESVtableOffset  *uint16
+}
+
+type extendedDescriptorMetadata struct {
+	KeyWord           uint32  `json:"key_word"`
+	ExtensionLength   *uint32 `json:"extension_length,omitempty"`
+	IVPresent         bool    `json:"iv_present"`
+	Descriptor1Offset uint64  `json:"descriptor1_offset"`
+	Descriptor2Offset uint64  `json:"descriptor2_offset"`
+	ReadStatus        string  `json:"read_status"`
+	ReadNativeCode    *int32  `json:"read_unicorn_code,omitempty"`
+}
+
+type deviceAESMetadata struct {
+	Phase      string  `json:"phase"`
+	Purpose    *uint32 `json:"purpose,omitempty"`
+	Operation  uint32  `json:"operation"`
+	InputBytes int     `json:"input_bytes"`
+	Errno      *uint64 `json:"errno,omitempty"`
+}
+
+// Only a concrete reviewed error type exposes additional scalar metadata.
+// Never format, serialize, or inspect the text of an arbitrary backend error.
+func kernelFailureMetadata(err error) *backendErrorMetadata {
+	metadata := &backendErrorMetadata{class: "kernel_unclassified"}
+	var kernel *machine.KernelExchangeError
+	if errors.As(err, &kernel) && kernel != nil {
+		metadata.class = "kernel_boundary"
+		metadata.kernelPhase = kernel.Phase.String()
+	}
+	var execution *machine.ExecutionError
+	if errors.As(err, &execution) && execution != nil {
+		metadata.class = "guest_execution"
+		metadata.executionPhase = execution.Phase.String()
+	}
+	var native *unicorn.NativeError
+	if errors.As(err, &native) && native != nil {
+		code := native.Code
+		metadata.unicornCode = &code
+	}
+	var deviceAES *machine.DeviceAESError
+	if errors.As(err, &deviceAES) && deviceAES != nil {
+		metadata.class = "device_aes"
+		metadata.deviceAES = &deviceAESMetadata{Phase: deviceAES.Phase.String(), Operation: deviceAES.Operation, InputBytes: deviceAES.InputBytes}
+		if deviceAES.HasPurpose {
+			purpose := deviceAES.Purpose
+			metadata.deviceAES.Purpose = &purpose
+		}
+		var errno syscall.Errno
+		if errors.As(deviceAES, &errno) {
+			value := uint64(errno)
+			metadata.deviceAES.Errno = &value
+		}
+	}
+	var shim *machine.ShimError
+	if errors.As(err, &shim) && shim != nil {
+		metadata.class = "guest_shim"
+		metadata.shim = shim.MetadataSymbol()
+	}
+	var method *machine.IOAESUnsupportedMethodError
+	if errors.As(err, &method) && method != nil {
+		metadata.class = "ioaes_method_unsupported"
+		if offset, ok := method.MetadataSlot(); ok {
+			metadata.ioAESVtableOffset = &offset
+		}
+	}
+	var unsupported *machine.MachRPCUnsupportedError
+	if errors.As(err, &unsupported) && unsupported != nil {
+		metadata.class = "mach_rpc_unsupported"
+		metadata.machRPC = &machRPCMetadata{
+			RequestBytes: unsupported.RequestBytes, ReceiveCapacity: unsupported.ReceiveCapacity,
+		}
+		if unsupported.HasMessageID {
+			id := unsupported.MessageID
+			metadata.machRPC.MessageID = &id
+		}
+	}
+	var extended *machine.ExtendedDescriptorUnsupportedError
+	if errors.As(err, &extended) && extended != nil {
+		metadata.class = "extended_descriptor_unsupported"
+		metadata.extendedDescriptor = &extendedDescriptorMetadata{KeyWord: extended.KeyWord, IVPresent: extended.IVPresent, Descriptor1Offset: extended.Descriptor1Offset, Descriptor2Offset: extended.Descriptor2Offset, ReadStatus: extended.ReadStatus.String()}
+		if extended.HasExtensionLength {
+			value := extended.ExtensionLength
+			metadata.extendedDescriptor.ExtensionLength = &value
+		}
+		if extended.HasReadNativeCode {
+			value := extended.ReadNativeCode
+			metadata.extendedDescriptor.ReadNativeCode = &value
+		}
+	}
+	return metadata
+}
+
+func responseMetadata(req request, resp response, written bool) map[string]any {
+	fields := map[string]any{
+		"queue": req.queue, "input_length": len(req.body), "output_length": len(resp.body),
+		"stage": resp.stage, "status": int32(resp.status), "reason": resp.reason,
+		"response_written": written,
+	}
+	if resp.errorMetadata != nil {
+		fields["error_class"] = resp.errorMetadata.class
+		if resp.errorMetadata.kernelPhase != "" {
+			fields["kernel_phase"] = resp.errorMetadata.kernelPhase
+		}
+		if resp.errorMetadata.executionPhase != "" {
+			fields["execution_phase"] = resp.errorMetadata.executionPhase
+		}
+		if resp.errorMetadata.shim != "" {
+			fields["shim"] = resp.errorMetadata.shim
+		}
+		if resp.errorMetadata.unicornCode != nil {
+			fields["unicorn_code"] = *resp.errorMetadata.unicornCode
+		}
+		if resp.errorMetadata.deviceAES != nil {
+			fields["device_aes"] = resp.errorMetadata.deviceAES
+		}
+		if resp.errorMetadata.machRPC != nil {
+			fields["mach_rpc"] = resp.errorMetadata.machRPC
+		}
+		if resp.errorMetadata.extendedDescriptor != nil {
+			fields["extended_descriptor"] = resp.errorMetadata.extendedDescriptor
+		}
+		if resp.errorMetadata.ioAESVtableOffset != nil {
+			fields["ioaes_vtable_offset"] = *resp.errorMetadata.ioAESVtableOffset
+		}
+	}
+	return fields
+}
diff --git a/tools/omvm-fairplay-linux/diagnostics_test.go b/tools/omvm-fairplay-linux/diagnostics_test.go
