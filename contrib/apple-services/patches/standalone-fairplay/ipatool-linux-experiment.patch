index 0000000..fbf5c06
--- /dev/null
+++ b/internal/sap/machine/persistent_state_test.go
@@ -0,0 +1,37 @@
+package machine
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestPersistentStateDistinguishesNativeFilePresence(t *testing.T) {
+	a := &ModernADI{runtime: &Machine{}, daemon: &Machine{services: &shims{adiFiles: map[string][]byte{}}}}
+	for _, want := range []struct {
+		present bool
+		data    []byte
+	}{{false, nil}, {true, nil}, {true, []byte("synthetic state")}} {
+		if want.present {
+			a.daemon.services.adiFiles[modernADIStatePath] = want.data
+		} else {
+			delete(a.daemon.services.adiFiles, modernADIStatePath)
+		}
+		got, present, err := a.PersistentState()
+		if err != nil || present != want.present || !bytes.Equal(got, want.data) {
+			t.Fatal("native file presence/data not preserved")
+		}
+		if len(got) > 0 {
+			got[0] ^= 1
+			if bytes.Equal(got, a.daemon.services.adiFiles[modernADIStatePath]) {
+				t.Fatal("caller can mutate native state through snapshot")
+			}
+		}
+	}
+	if _, _, err := (*ModernADI)(nil).PersistentState(); err == nil {
+		t.Fatal("unavailable runtime became empty state")
+	}
+	a.daemon.services.adiFiles[modernADIStatePath] = make([]byte, (1<<20)+1)
+	if _, _, err := a.PersistentState(); err == nil {
+		t.Fatal("oversized state exported")
+	}
+}
