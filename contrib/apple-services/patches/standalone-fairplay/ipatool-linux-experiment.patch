+++ b/internal/sap/machine/ioaes_shim_test.go
@@ -0,0 +1,88 @@
+package machine
+
+import (
+	"bytes"
+	"encoding/binary"
+	"math"
+	"strings"
+	"testing"
+)
+
+// Exercise the actual ARM64 argument registers/stack and production shim.
+// No Apple assets, credentials or hardware-key implementation are involved.
+func TestIOAESDescriptorABI(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		modify func(*testing.T, []uint64, *Machine)
+		status uint64
+		err    string
+	}{
+		{name: "null IV reaches unavailable provider", err: "device-key IOAES handle 0x89c"},
+		{name: "non-null IV reaches unavailable provider", modify: func(_ *testing.T, args []uint64, _ *Machine) { args[4] = scratchBase + 0x500 }, err: "device-key IOAES handle 0x89c"},
+		{name: "nonzero offsets reach unavailable provider", modify: func(_ *testing.T, args []uint64, _ *Machine) { args[7], args[8] = 16, 32 }, err: "device-key IOAES handle 0x89c"},
+		{name: "missing source", modify: func(_ *testing.T, args []uint64, _ *Machine) { args[1] = 0 }, status: 0xe00002c2},
+		{name: "missing key", modify: func(_ *testing.T, args []uint64, _ *Machine) { args[6] = 0 }, status: 0xe00002c2},
+		{name: "partial block", modify: func(_ *testing.T, args []uint64, _ *Machine) { args[3] = 17 }, status: 0xe00002c2},
+		{name: "destination offset is stack argument zero", modify: func(_ *testing.T, args []uint64, _ *Machine) { args[8] = 49 }, err: "IOAES transfer exceeds descriptor capacity"},
+		{name: "callback is stack argument one", modify: func(_ *testing.T, args []uint64, _ *Machine) { args[9] = 1 }, err: "asynchronous IOAES completion is unsupported"},
+		{name: "wrapped descriptor metadata", modify: func(_ *testing.T, args []uint64, _ *Machine) { args[1] = math.MaxUint64 - 3 }, err: "IOAES descriptor metadata address wraps"},
+		{name: "wrapped source address", modify: func(t *testing.T, args []uint64, machine *Machine) {
+			if err := machine.services.writeUint64(args[1]+8, math.MaxUint64-7); err != nil {
+				t.Fatal(err)
+			}
+			args[7] = 16
+		}, err: "IOAES descriptor address wraps"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			machine := newServiceTestMachine(t)
+			shim, err := machine.services.addFunction("test.ioaes.descriptor", machine.services.ioAESPerform)
+			if err != nil {
+				t.Fatal(err)
+			}
+			const srcDesc, dstDesc = scratchBase, scratchBase + 0x100
+			const srcData, dstData, keyData = scratchBase + 0x200, scratchBase + 0x300, scratchBase + 0x400
+			for _, item := range []struct{ address, value uint64 }{
+				{srcDesc + 8, srcData}, {srcDesc + 16, 64},
+				{dstDesc + 8, dstData}, {dstDesc + 16, 64},
+			} {
+				if err := machine.services.writeUint64(item.address, item.value); err != nil {
+					t.Fatal(err)
+				}
+			}
+			key := make([]byte, 40)
+			binary.LittleEndian.PutUint32(key, 128)
+			binary.LittleEndian.PutUint32(key[36:], commerceAESHandle)
+			before := bytes.Repeat([]byte{0x5a}, 64)
+			beforeIV := bytes.Repeat([]byte{0xa5}, 16)
+			if err := machine.engine.MemWrite(keyData, key); err != nil {
+				t.Fatal(err)
+			}
+			if err := machine.engine.MemWrite(dstData, before); err != nil {
+				t.Fatal(err)
+			}
+			if err := machine.engine.MemWrite(scratchBase+0x500, beforeIV); err != nil {
+				t.Fatal(err)
+			}
+			args := []uint64{1, srcDesc, dstDesc, 16, 0, 0, keyData, 0, 0, 0, 0}
+			if test.modify != nil {
+				test.modify(t, args, machine)
+			}
+			status, err := machine.invoke(shim, args...)
+			if test.err != "" {
+				if err == nil || !strings.Contains(err.Error(), test.err) {
+					t.Fatalf("error = %v, want containing %q", err, test.err)
+				}
+			} else if err != nil || status != test.status {
+				t.Fatalf("status = %#x, error = %v; want %#x", status, err, test.status)
+			}
+			after, err := machine.engine.MemRead(dstData, 64)
+			if err != nil || !bytes.Equal(after, before) {
+				t.Fatalf("failed or unsupported operation changed destination: %v", err)
+			}
+			afterIV, err := machine.engine.MemRead(scratchBase+0x500, 16)
+			if err != nil || !bytes.Equal(afterIV, beforeIV) {
+				t.Fatalf("failed or unsupported operation changed IV: %v", err)
+			}
+		})
+	}
+}
diff --git a/internal/sap/machine/mach_rpc_error.go b/internal/sap/machine/mach_rpc_error.go
new file mode 100644
index 0000000..124b1d2
--- /dev/null
+++ b/internal/sap/machine/mach_rpc_error.go
@@ -0,0 +1,29 @@
+package machine
+
+import "encoding/binary"
+
+// MachRPCUnsupportedError identifies the existing unsupported kernel Mach RPC
+// boundary without retaining a request, pointer, port, token, or payload.
+// MessageID is available only when the frozen 32-byte kernel header is present.
+type MachRPCUnsupportedError struct {
+	RequestBytes    int
+	ReceiveCapacity int
+	MessageID       int32
+	HasMessageID    bool
+}
+
+func (*MachRPCUnsupportedError) Error() string {
+	return "FairPlay Mach RPC requires daemon support; nested kernel execution is not implemented"
+}
+
+func newMachRPCUnsupportedError(request []byte, receiveSize int) *MachRPCUnsupportedError {
+	err := &MachRPCUnsupportedError{RequestBytes: len(request), ReceiveCapacity: receiveSize}
+	// This constructor is used only at the pinned kernel Mach RPC boundary:
+	// its 32-byte header places msgh_id at +28, not user Mach's +20. The native
+	// caller need not initialize msgh_size; real Mach transport normalizes it.
+	if len(request) >= 32 {
+		err.MessageID = int32(binary.LittleEndian.Uint32(request[28:32]))
+		err.HasMessageID = true
+	}
+	return err
+}
diff --git a/internal/sap/machine/mach_rpc_error_test.go b/internal/sap/machine/mach_rpc_error_test.go
new file mode 100644
index 0000000..9889c55
--- /dev/null
+++ b/internal/sap/machine/mach_rpc_error_test.go
@@ -0,0 +1,44 @@
+package machine
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"testing"
+)
+
+func TestMachRPCUnsupportedMetadataPreservesGuard(t *testing.T) {
+	for _, length := range []int{0, 31, 32, 88} {
+		request := bytes.Repeat([]byte{0x5a}, length)
+		if length >= 32 {
+			// msgh_size is deliberately zero: the native kernel caller may
+			// leave it for Mach transport to normalize. User offset +20 is
+			// deliberately different from the pinned kernel ID at +28.
+			binary.LittleEndian.PutUint32(request[4:8], 0)
+			binary.LittleEndian.PutUint32(request[20:24], 999)
+			binary.LittleEndian.PutUint32(request[28:32], 502)
+		}
+		var adi *ModernADI // The guard must not dereference or start a runtime.
+		reply, err := adi.handleFairPlayMachRPC(request, 400)
+		if reply != nil || err == nil {
+			t.Fatal("unsupported RPC returned output or success")
+		}
+		// Match the real invoke/dispatch wrapping: metadata survives %w.
+		wrapped := fmt.Errorf("kernel invoke: %w", fmt.Errorf("shim: %w", err))
+		var diagnostic *MachRPCUnsupportedError
+		if !errors.As(wrapped, &diagnostic) || diagnostic.RequestBytes != length || diagnostic.ReceiveCapacity != 400 {
+			t.Fatal("wrapped error lost bounded call metadata")
+		}
+		if diagnostic.HasMessageID != (length >= 32) || diagnostic.HasMessageID && diagnostic.MessageID != 502 {
+			t.Fatal("message ID did not use the complete kernel header at +28")
+		}
+		clear(request)
+		if diagnostic.HasMessageID && diagnostic.MessageID != 502 {
+			t.Fatal("diagnostic retained a mutable request")
+		}
+		if err.Error() != "FairPlay Mach RPC requires daemon support; nested kernel execution is not implemented" {
+			t.Fatal("unsupported guard error text changed or included payload")
+		}
+	}
+}
