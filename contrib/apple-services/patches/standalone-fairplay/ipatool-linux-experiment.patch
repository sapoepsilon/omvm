+package machine
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"math"
+)
+
+// DeviceAESDSBRequest is a separate, fixed native operation: unflagged handle
+// 3000, AES128 CBC decrypt, one block, supplied IV and zero descriptor offsets.
+// Arrays are owned value copies. DSBContext and KeyField are opaque native
+// operands, not software keys or authenticated records. They must never be
+// logged, retained after return, or used in a fallback implementation.
+type DeviceAESDSBRequest struct {
+	DSBContext [32]byte
+	KeyField   [16]byte
+	IV         [16]byte
+	Input      [16]byte
+}
+
+// DeviceAESDSBProvider is independently opt-in. The ordinary DeviceAESProvider
+// does not imply support. Success means synchronous, completed output and IV.
+type DeviceAESDSBProvider interface {
+	TransformDeviceAESDSB(DeviceAESDSBRequest) (DeviceAESResult, error)
+}
+
+func (s *shims) emulateIOAESDSB(source, iv []byte, operation uint32, keyAddress uint64, keyWord uint32, ivPresent bool, firstOffset, secondOffset uint64) (output, updatedIV []byte, resultErr error) {
+	phase := PhaseAESParameters
+	defer func() {
+		if resultErr != nil {
+			resultErr = &DeviceAESError{FailureCause: FailureCause{Phase: phase, Err: resultErr}, Purpose: extendedDescriptorHandle, HasPurpose: true, Operation: operation, InputBytes: len(source)}
+		}
+	}()
+	if keyWord != 128 || operation != 1 || len(source) != 16 || len(iv) != 16 || !ivPresent || firstOffset != 0 || secondOffset != 0 {
+		return nil, nil, errors.New("extended IOAES request exceeds the observed operation bounds")
+	}
+	if keyAddress > math.MaxUint64-extendedDescriptorMinimum {
+		return nil, nil, errors.New("extended IOAES descriptor address wraps")
+	}
+	var descriptor [extendedDescriptorMinimum]byte
+	defer clear(descriptor[:])
+	if err := s.engine.MemReadInto(descriptor[:], keyAddress); err != nil {
+		return nil, nil, fmt.Errorf("read extended IOAES descriptor: %w", err)
+	}
+	if binary.LittleEndian.Uint32(descriptor[0:4]) != 128 || binary.LittleEndian.Uint32(descriptor[36:40]) != extendedDescriptorHandle || binary.LittleEndian.Uint32(descriptor[40:44]) != 32 {
+		return nil, nil, errors.New("extended IOAES descriptor exceeds the observed field bounds")
+	}
+	phase = PhaseAESProviderUnavailable
+	if s.deviceAESDSBProvider == nil {
+		return nil, nil, errors.New("extended IOAES provider is unavailable")
+	}
+	var request DeviceAESDSBRequest
+	defer func() {
+		clear(request.DSBContext[:])
+		clear(request.KeyField[:])
+		clear(request.IV[:])
+		clear(request.Input[:])
+	}()
+	copy(request.DSBContext[:], descriptor[44:76])
+	// Native format2 emits only the first 16 bytes of its 32-byte storage.
+	// The remaining bytes are ignored, not required to be zero.
+	copy(request.KeyField[:], descriptor[4:20])
+	copy(request.IV[:], iv)
+	copy(request.Input[:], source)
+	phase = PhaseAESProviderCall
+	result, err := s.deviceAESDSBProvider.TransformDeviceAESDSB(request)
+	if err != nil {
+		return nil, nil, fmt.Errorf("extended IOAES provider failed: %w", err)
+	}
+	phase = PhaseAESCompletion
+	if !result.Completed {
+		return nil, nil, errors.New("extended IOAES provider did not complete the transform")
+	}
+	phase = PhaseAESOutput
+	if len(result.Output) != 16 || len(result.IV) != 16 {
+		return nil, nil, errors.New("extended IOAES provider returned invalid output")
+	}
+	return bytes.Clone(result.Output), bytes.Clone(result.IV), nil
+}
