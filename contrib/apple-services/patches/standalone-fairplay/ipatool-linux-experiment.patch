diff --git a/tools/omvm-fairplay-linux/main.go b/tools/omvm-fairplay-linux/main.go
new file mode 100644
index 0000000..c853827
--- /dev/null
+++ b/tools/omvm-fairplay-linux/main.go
@@ -0,0 +1,285 @@
+// Experimental offline backend. It has no macOS relay or account-login client.
+// A successful wire exchange does not establish valid provisioning or sign-in.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"os/signal"
+	"path/filepath"
+	"syscall"
+	"time"
+
+	"github.com/majd/ipatool/v2/internal/sap/assets"
+	"github.com/majd/ipatool/v2/internal/sap/deviceaes"
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+	"golang.org/x/sys/unix"
+)
+
+type offlineTransport struct{}
+
+func (offlineTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, errors.New("offline backend refuses network access")
+}
+
+func report(event string, fields map[string]any) {
+	fields["event"] = event
+	_ = json.NewEncoder(os.Stderr).Encode(fields)
+}
+
+func privateIdentity(path string) ([]byte, error) {
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, errors.New("cannot open private identifier file")
+	}
+	f := os.NewFile(uintptr(fd), path)
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return nil, errors.New("cannot inspect identifier file")
+	}
+	owner, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || owner.Uid != uint32(os.Getuid()) || !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Size() != 16 {
+		return nil, errors.New("identifier file must be owned, regular, mode 0600, exactly 16 bytes")
+	}
+	value, err := io.ReadAll(io.LimitReader(f, 17))
+	if err != nil || len(value) != 16 {
+		return nil, errors.New("cannot read bounded identifier")
+	}
+	return value, nil
+}
+
+func privateListener(path string) (*net.UnixListener, func(), error) {
+	if !filepath.IsAbs(path) || len(path) > 100 {
+		return nil, nil, errors.New("socket requires a short absolute path")
+	}
+	parent, err := os.Lstat(filepath.Dir(path))
+	if err != nil {
+		return nil, nil, errors.New("socket parent is unavailable")
+	}
+	owner, ok := parent.Sys().(*syscall.Stat_t)
+	if !ok || owner.Uid != uint32(os.Getuid()) || !parent.IsDir() || parent.Mode().Perm() != 0700 {
+		return nil, nil, errors.New("socket parent must be owned, nonsymlink directory mode 0700")
+	}
+	if _, err := os.Lstat(path); err == nil || !os.IsNotExist(err) {
+		return nil, nil, errors.New("socket path already exists or cannot be inspected")
+	}
+	previousMask := syscall.Umask(0077)
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+	syscall.Umask(previousMask)
+	if err != nil {
+		return nil, nil, errors.New("cannot bind private socket")
+	}
+	listener.SetUnlinkOnClose(false)
+	identity, err := os.Lstat(path)
+	if err != nil {
+		_ = listener.Close()
+		return nil, nil, errors.New("cannot inspect bound socket")
+	}
+	cleanup := func() {
+		_ = listener.Close()
+		if current, err := os.Lstat(path); err == nil && os.SameFile(identity, current) {
+			_ = os.Remove(path)
+		}
+	}
+	if err := os.Chmod(path, 0600); err != nil {
+		cleanup()
+		return nil, nil, errors.New("cannot restrict socket permissions")
+	}
+	return listener, cleanup, nil
+}
+
+// No concurrent ModernADI calls are allowed: requests are served synchronously.
+// On a backend overrun, the process must stop rather than reuse uncertain state.
+func serveConnection(conn net.Conn, b backend, timeout time.Duration, fatal func(string)) {
+	defer conn.Close()
+	deadline := time.Now().Add(timeout)
+	_ = conn.SetDeadline(deadline)
+	req, err := readRequest(conn)
+	if err != nil {
+		_ = writeResponse(conn, response{stage: stageFrame, status: statusProtocol})
+		report("request_rejected", map[string]any{"reason": "framing"})
+		return
+	}
+	remaining := time.Until(deadline)
+	if remaining <= 0 {
+		return
+	}
+	watchdog := time.AfterFunc(remaining, func() { fatal("backend_deadline") })
+	resp := exchange(b, req)
+	if !watchdog.Stop() {
+		// The fatal handler owns shutdown; never write a late success reply.
+		return
+	}
+	err = writeResponse(conn, resp)
+	report("request_completed", responseMetadata(req, resp, err == nil))
+	if resp.stage == stageInternal {
+		fatal("backend_error")
+	}
+}
+
+func serve(ctx context.Context, listener *net.UnixListener, b backend, timeout time.Duration, fatal func(string)) error {
+	done := make(chan struct{})
+	defer close(done)
+	go func() {
+		select {
+		case <-ctx.Done():
+			_ = listener.Close()
+		case <-done:
+		}
+	}()
+	for {
+		conn, err := listener.AcceptUnix()
+		if err != nil {
+			if ctx.Err() != nil {
+				return nil
+			}
+			return errors.New("private listener failed")
+		}
+		serveConnection(conn, b, timeout, fatal)
+		if ctx.Err() != nil {
+			return nil
+		}
+	}
+}
+
+func run() error {
+	socket := flag.String("socket", "", "private absolute Unix socket path")
+	synthetic := flag.Bool("diagnostic-synthetic", false, "explicit isolated test identity; never submit an account")
+	identifierFile := flag.String("identifier-file", "", "owned private 16-byte VM identifier file; experimental, not sign-in validated")
+	stateFile := flag.String("state-file", "", "root-private per-VM durable ADI checkpoint; must already exist")
+	initializeState := flag.Bool("initialize-state", false, "create a new empty checkpoint and exit; requires identifier-file and state-file only")
+	deviceAESPath := flag.String("device-aes", "", "explicit Linux ARM64 device-AES path; must already be READY")
+	deviceAESDSB := flag.Bool("device-aes-dsb", false, "explicit fixed one-block extended-descriptor decrypt; requires device-aes and v3 provider")
+	timeout := flag.Duration("timeout", 12*time.Second, "whole-request deadline, 1–12 seconds")
+	flag.Parse()
+	if *initializeState {
+		if *identifierFile == "" || *stateFile == "" || *socket != "" || *synthetic || *deviceAESPath != "" || *deviceAESDSB || flag.NArg() != 0 {
+			return errors.New("state initialization requires only identifier-file and state-file")
+		}
+		identifier, err := privateIdentity(*identifierFile)
+		if err != nil {
+			return err
+		}
+		store, err := openStateStore(*stateFile, identifier, true)
+		if err != nil {
+			return err
+		}
+		store.close()
+		report("state_initialized", map[string]any{"present": false})
+		return nil
+	}
+	if *socket == "" || (*synthetic == (*identifierFile != "")) || *timeout < time.Second || *timeout > 12*time.Second || flag.NArg() != 0 {
+		return errors.New("require socket and exactly one identity mode; timeout must be 1–12 seconds")
+	}
+	if *deviceAESDSB && *deviceAESPath == "" {
+		return errors.New("device-aes-dsb requires an explicit device-aes path")
+	}
+	identifier := make([]byte, 16)
+	identifier[15] = 1
+	mode := "synthetic_diagnostic"
+	if *identifierFile != "" {
+		var err error
+		identifier, err = privateIdentity(*identifierFile)
+		if err != nil {
+			return err
+		}
+		mode = "explicit_identifier_experimental"
+	}
+	var store *stateStore
+	var restored []byte
+	if *stateFile != "" {
+		var err error
+		store, err = openStateStore(*stateFile, identifier, false)
+		if err != nil {
+			return err
+		}
+		defer store.close()
+		if store.last.present {
+			restored = make([]byte, len(store.last.data))
+			copy(restored, store.last.data)
+		}
+	}
+	options := machine.ModernADIOptions{}
+	if *deviceAESPath != "" {
+		provider, err := deviceaes.Open(*deviceAESPath)
+		if err != nil {
+			return err
+		}
+		defer provider.Close()
+		options.DeviceAESProvider = provider
+		if *deviceAESDSB {
+			options.DeviceAESDSBProvider = provider
+		}
+	}
+	// Every HTTP client in the pinned asset/Unicorn loaders uses this transport.
+	// Verified cached assets are mandatory; missing/corrupt assets fail startup.
+	http.DefaultTransport = offlineTransport{}
+	http.DefaultClient = &http.Client{Transport: offlineTransport{}}
+	ctx, cancel := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
+	defer cancel()
+	initCtx, initCancel := context.WithTimeout(ctx, time.Minute)
+	defer initCancel()
+	bundle, err := assets.Load(initCtx)
+	if err != nil {
+		return errors.New("verified offline assets unavailable")
+	}
+	if store != nil {
+		if err := store.begin(); err != nil {
+			return err
+		}
+	}
+	adi, err := machine.OpenModernADIWithOptions(initCtx, bundle, identifier, restored, options)
+	if err != nil {
+		// Avoid printing opaque library error text in a long-lived service.
+		return errors.New("strict backend initialization failed; use isolated probe for diagnostic metadata")
+	}
+	defer adi.Close()
+	var service backend = adi
+	stateMode := "empty_at_start_in_memory_only"
+	if store != nil {
+		// Native initialization can create or update its file. Commit that
+		// completed operation before serving, using the same crash boundary.
+		data, present, err := adi.PersistentState()
+		if err != nil {
+			return stateError()
+		}
+		if err := store.commit(adiCheckpoint{present: present, data: data}, true); err != nil {
+			return err
+		}
+		service = &checkpointBackend{backend: adi, store: store, snapshot: adi.PersistentState}
+		stateMode = "durable_identity_bound_checkpoint"
+	}
+	initCancel()
+	listener, cleanup, err := privateListener(*socket)
+	if err != nil {
+		return err
+	}
+	defer cleanup()
+	report("ready", map[string]any{
+		"identity_mode": mode, "network_enabled": false, "macOS_relay_used": false,
+		"device_aes_enabled":     *deviceAESPath != "",
+		"device_aes_dsb_enabled": *deviceAESDSB,
+		"state":                  stateMode, "sign_in_validated": false,
+	})
+	fatal := func(reason string) {
+		report("stopped", map[string]any{"reason": reason, "state_reuse": false})
+		// An in-flight native emulator call cannot be cancelled safely. Exiting
+		// is deliberate; a supervisor must not auto-restart with fresh state.
+		os.Exit(2)
+	}
+	return serve(ctx, listener, service, *timeout, fatal)
+}
+
+func main() {
+	if err := run(); err != nil {
+		report("stopped", map[string]any{"reason": err.Error()})
+		os.Exit(1)
+	}
+}
diff --git a/tools/omvm-fairplay-linux/protocol.go b/tools/omvm-fairplay-linux/protocol.go
new file mode 100644
index 0000000..ea925ca
--- /dev/null
+++ b/tools/omvm-fairplay-linux/protocol.go
@@ -0,0 +1,200 @@
+package main
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+	"math"
+)
+
+const (
+	maxBuffer     = 1 << 20
+	stageCall     = uint32(0)
+	stageFrame    = uint32(1)
+	stageInternal = uint32(4)
+	// Wire values are Linux errno values, independent of the build/test host.
+	statusIO       = uint32(5)
+	statusInvalid  = uint32(22)
+	statusProtocol = uint32(71)
+)
+
+type backend interface {
+	ExchangeXPC([]byte) ([]byte, error)
+	ExchangeKernelBuffer([]byte) ([]byte, int32, error)
+}
+
+type request struct {
+	queue    uint32
+	capacity uint32
+	body     []byte
+}
+
+type responseKind uint8
+
+const (
+	responseOFR1 responseKind = iota
+	responseKernelOFR2
+)
+
+type response struct {
+	kind          responseKind
+	queue         uint32 // OFR2 is valid only for queue-0 kernel completions.
+	inputLength   int    // OFR2 copies exactly this many bytes back to the guest.
+	stage         uint32
+	status        uint32
+	body          []byte
+	reason        string                // fixed metadata label; never an upstream error or payload
+	errorMetadata *backendErrorMetadata // logging only; never included in wire output
+}
+
+func readRequest(r io.Reader) (request, error) {
+	var header [16]byte
+	if _, err := io.ReadFull(r, header[:12]); err != nil {
+		return request{}, errors.New("truncated request header")
+	}
+	queue := uint32(3)
+	switch string(header[:4]) {
+	case "OFP1":
+	case "OFP2":
+		if _, err := io.ReadFull(r, header[12:]); err != nil {
+			return request{}, errors.New("truncated queue field")
+		}
+		queue = binary.LittleEndian.Uint32(header[12:])
+	default:
+		return request{}, errors.New("invalid request magic")
+	}
+	length := binary.LittleEndian.Uint32(header[4:8])
+	capacity := binary.LittleEndian.Uint32(header[8:12])
+	if (queue != 0 && queue != 3) || length == 0 || length > maxBuffer || capacity == 0 || capacity > maxBuffer {
+		return request{}, errors.New("invalid request bounds or queue")
+	}
+	// ExchangeXPC bounds its entire request, including our 16-byte wrapper.
+	if queue == 3 && length > maxBuffer-16 {
+		return request{}, errors.New("ADI request exceeds wrapped message limit")
+	}
+	body := make([]byte, int(length))
+	if _, err := io.ReadFull(r, body); err != nil {
+		return request{}, errors.New("truncated request body")
+	}
+	var trailing [1]byte
+	if n, err := r.Read(trailing[:]); n != 0 || err != io.EOF {
+		return request{}, errors.New("request must end at declared length")
+	}
+	return request{queue: queue, capacity: capacity, body: body}, nil
+}
+
+func exchange(b backend, req request) response {
+	if req.queue == 0 {
+		if uint64(len(req.body)) > uint64(req.capacity) {
+			return response{stage: stageFrame, status: statusInvalid, reason: "kernel_capacity"}
+		}
+		body, status, err := b.ExchangeKernelBuffer(req.body)
+		if err != nil {
+			return response{stage: stageInternal, status: statusIO, reason: "kernel_error", errorMetadata: kernelFailureMetadata(err)}
+		}
+		if len(body) != len(req.body) || len(body) > int(req.capacity) {
+			return response{stage: stageFrame, status: statusProtocol, reason: "kernel_length"}
+		}
+		// Native queue 0 returns the same modified buffer even when the core
+		// status is nonzero. OFR2 distinguishes that completion from OFR1
+		// errors, whose payload must always be empty.
+		return response{kind: responseKernelOFR2, queue: 0, inputLength: len(req.body),
+			stage: stageCall, status: uint32(status), body: body, reason: "kernel_completion"}
+	}
+	if req.queue != 3 {
+		return response{stage: stageFrame, status: statusInvalid, reason: "unsupported_queue"}
+	}
+	checkpoint, persistent := b.(checkpointBoundary)
+	if persistent {
+		if err := checkpoint.beginCheckpoint(); err != nil {
+			return response{stage: stageInternal, status: statusIO, reason: "state_begin_failed"}
+		}
+	}
+	wrapped := make([]byte, 16+len(req.body))
+	for i, value := range [...]uint32{1, 0xA8471CAD, 1, uint32(len(req.body))} {
+		binary.BigEndian.PutUint32(wrapped[i*4:], value)
+	}
+	copy(wrapped[16:], req.body)
+	reply, err := b.ExchangeXPC(wrapped)
+	if err != nil {
+		return response{stage: stageInternal, status: statusIO, reason: "adi_error"}
+	}
+	resp := parseADIReply(reply, len(req.body), req.capacity)
+	if persistent {
+		if resp.stage != stageCall {
+			return response{stage: stageInternal, status: statusIO, reason: "state_reply_unconfirmed"}
+		}
+		if err := checkpoint.commitCheckpoint(resp.status == 0); err != nil {
+			return response{stage: stageInternal, status: statusIO, reason: "state_commit_failed"}
+		}
+	}
+	return resp
+}
+
+func parseADIReply(reply []byte, inputLength int, capacity uint32) response {
+	invalid := func(reason string) response {
+		return response{stage: stageFrame, status: statusProtocol, reason: reason}
+	}
+	if len(reply) < 4 {
+		return invalid("adi_short_status")
+	}
+	status := binary.BigEndian.Uint32(reply[:4])
+	if status != 0 {
+		return response{stage: stageCall, status: status, reason: "adi_status"}
+	}
+	if len(reply) < 8 {
+		return invalid("adi_short_header")
+	}
+	length := binary.BigEndian.Uint32(reply[4:8])
+	if uint64(length) < uint64(inputLength) || length > math.MaxUint32-8 || length > capacity || uint64(length) > uint64(len(reply)-8) {
+		return invalid("adi_length")
+	}
+	// Native accepts trailing XPC bytes. Copy only the declared bounded output.
+	return response{body: append([]byte(nil), reply[8:8+int(length)]...), reason: "adi_reply"}
+}
+
+func writeResponse(w io.Writer, resp response) error {
+	if len(resp.body) > maxBuffer {
+		return errors.New("response exceeds limit")
+	}
+	magic := "OFR1"
+	switch resp.kind {
+	case responseOFR1:
+		if (resp.stage != 0 || resp.status != 0) && len(resp.body) != 0 {
+			return errors.New("OFR1 error response cannot carry output")
+		}
+	case responseKernelOFR2:
+		if resp.queue != 0 || resp.stage != stageCall || resp.inputLength <= 0 || len(resp.body) != resp.inputLength {
+			return errors.New("OFR2 requires a same-length queue-0 kernel completion")
+		}
+		magic = "OFR2"
+	default:
+		return errors.New("unknown response type")
+	}
+	var header [16]byte
+	copy(header[:4], magic)
+	binary.LittleEndian.PutUint32(header[4:8], resp.stage)
+	binary.LittleEndian.PutUint32(header[8:12], resp.status)
+	binary.LittleEndian.PutUint32(header[12:], uint32(len(resp.body)))
+	if err := writeAll(w, header[:]); err != nil {
+		return err
+	}
+	return writeAll(w, resp.body)
+}
+
+func writeAll(w io.Writer, p []byte) error {
+	for len(p) != 0 {
+		n, err := w.Write(p)
+		if n < 0 || n > len(p) {
+			return io.ErrShortWrite
+		}
+		p = p[n:]
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+	}
+	return nil
+}
diff --git a/tools/omvm-fairplay-linux/protocol_test.go b/tools/omvm-fairplay-linux/protocol_test.go
new file mode 100644
