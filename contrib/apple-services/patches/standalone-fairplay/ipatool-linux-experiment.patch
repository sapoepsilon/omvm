new file mode 100644
index 0000000..733295b
--- /dev/null
+++ b/internal/sap/deviceaes/client.go
@@ -0,0 +1,323 @@
+// Package deviceaes is an explicit client for the experimental kernel-owned
+// device-AES provider. It supplies no software key or discovery/fallback path.
+package deviceaes
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"sync"
+
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+)
+
+const (
+	DevicePath          = "/dev/omvm-uid1-provider"
+	ABIVersion          = uint32(1)
+	MaxPayload          = 4096
+	BlockSize           = 16
+	SeedBundleSize      = 32
+	ioctlSelfTest       = uintptr(0x0000b700)
+	ioctlInit           = uintptr(0x4028b701)
+	ioctlTransform      = uintptr(0xd028b702)
+	ioctlStatus         = uintptr(0x8040b703)
+	transformSize       = 4136
+	statusSize          = 64
+	initSize            = 40
+	transformHeaderSize = 24
+	transformDataOffset = 40
+)
+
+type State uint32
+
+const (
+	Untested State = iota
+	SelfTestPassed
+	Ready
+	Poisoned
+)
+
+const (
+	FlagBusy      = uint32(1 << 0)
+	FlagPinned    = uint32(1 << 1)
+	FlagPowerHeld = uint32(1 << 2)
+	knownFlags    = FlagBusy | FlagPinned | FlagPowerHeld
+)
+
+// Status contains cached metadata only. CompletedOps is not a payload-transform
+// counter; LastErrno can describe another client's most recent operation.
+type Status struct {
+	ABIVersion     uint32 `json:"abi_version"`
+	State          State  `json:"state"`
+	LastErrno      int32  `json:"last_errno"`
+	Flags          uint32 `json:"flags"`
+	HardwareStatus uint32 `json:"hw_status"`
+	HardwareTag    uint32 `json:"hw_tag"`
+	CompletedOps   uint32 `json:"completed_ops"`
+}
+
+type device interface {
+	ioctl(uintptr, []byte) error
+	close() error
+}
+
+type session struct {
+	mu     sync.Mutex
+	device device
+	closed bool
+	failed bool
+}
+
+// Provider implements the existing synchronous machine provider API. It is
+// opened only by an explicit device path and never runs SELFTEST or INIT.
+type Provider struct{ session *session }
+
+// Controller exposes explicit administrative operations separately from the
+// adapter's Provider API. No work is performed merely by opening a controller.
+type Controller struct {
+	session      *session
+	readSeedFile func(string) ([]byte, error)
+}
+
+// Open validates the Linux node and requires cached READY status before return.
+func Open(path string) (*Provider, error) {
+	dev, err := openDevice(path)
+	if err != nil {
+		return nil, err
+	}
+	return newProvider(dev)
+}
+
+func newProvider(dev device) (*Provider, error) {
+	s := &session{device: dev}
+	status, err := s.statusLocked()
+	if err == nil {
+		err = requireReady(status)
+	}
+	if err != nil {
+		_ = s.close()
+		return nil, fmt.Errorf("device-AES provider is not ready: %w", err)
+	}
+	return &Provider{session: s}, nil
+}
+
+// OpenController performs only node validation. The caller must explicitly
+// invoke Status, SelfTest, or InitializeFromFile.
+func OpenController(path string) (*Controller, error) {
+	dev, err := openDevice(path)
+	if err != nil {
+		return nil, err
+	}
+	return &Controller{session: &session{device: dev}, readSeedFile: readPrivateSeeds}, nil
+}
+
+func (s *session) statusLocked() (Status, error) {
+	if s.closed {
+		return Status{}, errors.New("device-AES client is closed")
+	}
+	var frame [statusSize]byte
+	if err := s.device.ioctl(ioctlStatus, frame[:]); err != nil {
+		return Status{}, fmt.Errorf("device-AES STATUS failed: %w", err)
+	}
+	status := Status{
+		ABIVersion:     binary.LittleEndian.Uint32(frame[0:4]),
+		State:          State(binary.LittleEndian.Uint32(frame[4:8])),
+		LastErrno:      int32(binary.LittleEndian.Uint32(frame[8:12])),
+		Flags:          binary.LittleEndian.Uint32(frame[12:16]),
+		HardwareStatus: binary.LittleEndian.Uint32(frame[16:20]),
+		HardwareTag:    binary.LittleEndian.Uint32(frame[20:24]),
+		CompletedOps:   binary.LittleEndian.Uint32(frame[24:28]),
+	}
+	if status.ABIVersion != ABIVersion || status.State > Poisoned || status.LastErrno > 0 || status.Flags & ^knownFlags != 0 || !allZero(frame[28:]) {
+		return Status{}, errors.New("device-AES STATUS violated the frozen ABI")
+	}
+	return status, nil
+}
+
+func requireReady(status Status) error {
+	if status.State != Ready || status.Flags&FlagBusy != 0 {
+		return fmt.Errorf("device-AES state %d flags %#x is not idle READY", status.State, status.Flags)
+	}
+	return nil
+}
+
+func allZero(data []byte) bool {
+	for _, b := range data {
+		if b != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+func validateRequest(request machine.DeviceAESRequest) error {
+	if request.Purpose != machine.DeviceAESPurpose899 && request.Purpose != machine.DeviceAESPurpose89C {
+		return errors.New("device-AES purpose is unsupported")
+	}
+	if request.Operation > 1 || request.KeyBits != 128 || len(request.Input) < BlockSize || len(request.Input) > MaxPayload || len(request.Input)%BlockSize != 0 || len(request.IV) != BlockSize {
+		return errors.New("device-AES request exceeds the frozen operation bounds")
+	}
+	if !request.IVPresent && !allZero(request.IV) {
+		return errors.New("absent device-AES IV must contain zero bytes")
+	}
+	return nil
+}
+
+// TransformDeviceAES issues exactly one synchronous TRANSFORM. A syscall error,
+// including EINTR, is never retried. Close waits for this call to return; there
+// is no goroutine timeout that can release buffers while the ioctl still runs.
+func (p *Provider) TransformDeviceAES(request machine.DeviceAESRequest) (machine.DeviceAESResult, error) {
+	if p == nil || p.session == nil {
+		return machine.DeviceAESResult{}, errors.New("device-AES provider is unavailable")
+	}
+	if err := validateRequest(request); err != nil {
+		return machine.DeviceAESResult{}, err
+	}
+	s := p.session
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.failed {
+		return machine.DeviceAESResult{}, errors.New("device-AES session cannot accept work")
+	}
+	fail := func(err error) (machine.DeviceAESResult, error) {
+		s.failed = true
+		return machine.DeviceAESResult{}, err
+	}
+	before, err := s.statusLocked()
+	if err != nil {
+		return fail(err)
+	}
+	if err := requireReady(before); err != nil {
+		return fail(err)
+	}
+	var frame [transformSize]byte
+	defer clear(frame[:])
+	binary.LittleEndian.PutUint32(frame[0:4], ABIVersion)
+	binary.LittleEndian.PutUint32(frame[4:8], request.Purpose)
+	binary.LittleEndian.PutUint32(frame[8:12], request.Operation)
+	if request.IVPresent {
+		binary.LittleEndian.PutUint32(frame[12:16], 1)
+	}
+	binary.LittleEndian.PutUint32(frame[16:20], uint32(len(request.Input)))
+	copy(frame[24:40], request.IV)
+	copy(frame[transformDataOffset:], request.Input)
+	var immutable [transformHeaderSize]byte
+	copy(immutable[:], frame[:transformHeaderSize])
+	if err := s.device.ioctl(ioctlTransform, frame[:]); err != nil {
+		return fail(fmt.Errorf("device-AES TRANSFORM failed: %w", err))
+	}
+	if !bytes.Equal(frame[:transformHeaderSize], immutable[:]) || !allZero(frame[transformDataOffset+len(request.Input):]) || (!request.IVPresent && !allZero(frame[24:40])) {
+		return fail(errors.New("device-AES TRANSFORM changed immutable fields, tail, or absent IV"))
+	}
+	after, err := s.statusLocked()
+	if err != nil {
+		return fail(err)
+	}
+	if err := requireReady(after); err != nil {
+		return fail(err)
+	}
+	// The frozen ioctl copies output only after completed synchronous success.
+	// The counter and last_errno are metadata, not completion proof.
+	return machine.DeviceAESResult{
+		Completed: true,
+		Output:    bytes.Clone(frame[transformDataOffset : transformDataOffset+len(request.Input)]),
+		IV:        bytes.Clone(frame[24:40]),
+	}, nil
+}
+
+func (s *session) close() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return nil
+	}
+	s.closed = true
+	// Do not retry close after EINTR: the fd might already have been released.
+	return s.device.close()
+}
+
+func (p *Provider) Close() error {
+	if p == nil || p.session == nil {
+		return nil
+	}
+	return p.session.close()
+}
+
+func (c *Controller) Close() error {
+	if c == nil || c.session == nil {
+		return nil
+	}
+	return c.session.close()
+}
+
+func (c *Controller) Status() (Status, error) {
+	if c == nil || c.session == nil {
+		return Status{}, errors.New("device-AES controller is unavailable")
+	}
+	c.session.mu.Lock()
+	defer c.session.mu.Unlock()
+	return c.session.statusLocked()
+}
+
+func (c *Controller) SelfTest() (Status, error) {
+	if c == nil || c.session == nil {
+		return Status{}, errors.New("device-AES controller is unavailable")
+	}
+	s := c.session
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.failed {
+		return Status{}, errors.New("device-AES session cannot accept work")
+	}
+	if err := s.device.ioctl(ioctlSelfTest, nil); err != nil {
+		s.failed = true
+		return Status{}, fmt.Errorf("explicit device-AES SELFTEST failed: %w", err)
+	}
+	status, err := s.statusLocked()
+	if err == nil && (status.State != SelfTestPassed || status.Flags&FlagBusy != 0) {
+		err = errors.New("SELFTEST did not enter idle SELFTEST_PASSED")
+	}
+	if err != nil {
+		s.failed = true
+	}
+	return status, err
+}
+
+// InitializeFromFile reads only the explicit root-owned, private, pinned seed
+// bundle. The bundle is cleared after the synchronous ioctl and never logged.
+func (c *Controller) InitializeFromFile(path string) (Status, error) {
+	if c == nil || c.session == nil {
+		return Status{}, errors.New("device-AES controller is unavailable")
+	}
+	s := c.session
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.failed {
+		return Status{}, errors.New("device-AES session cannot accept work")
+	}
+	seeds, err := c.readSeedFile(path)
+	if err != nil {
+		return Status{}, err
+	}
+	defer clear(seeds)
+	if len(seeds) != SeedBundleSize {
+		return Status{}, errors.New("invalid private seed-bundle size")
+	}
+	var frame [initSize]byte
+	defer clear(frame[:])
+	binary.LittleEndian.PutUint32(frame[:4], ABIVersion)
+	copy(frame[8:], seeds)
+	if err := s.device.ioctl(ioctlInit, frame[:]); err != nil {
+		s.failed = true
+		return Status{}, fmt.Errorf("explicit device-AES INIT failed: %w", err)
+	}
+	status, err := s.statusLocked()
+	if err == nil {
+		err = requireReady(status)
+	}
+	if err != nil {
+		s.failed = true
+	}
+	return status, err
+}
diff --git a/internal/sap/deviceaes/client_test.go b/internal/sap/deviceaes/client_test.go
new file mode 100644
index 0000000..008ecb3
--- /dev/null
+++ b/internal/sap/deviceaes/client_test.go
@@ -0,0 +1,381 @@
+package deviceaes
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"reflect"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+)
+
+type fakeDevice struct {
+	call    func(uintptr, []byte) error
+	closing func() error
+}
+
+func (f *fakeDevice) ioctl(command uintptr, data []byte) error { return f.call(command, data) }
+func (f *fakeDevice) close() error {
+	if f.closing != nil {
+		return f.closing()
+	}
+	return nil
+}
+
+func putStatus(frame []byte, state State) {
+	clear(frame)
+	binary.LittleEndian.PutUint32(frame[0:4], ABIVersion)
+	binary.LittleEndian.PutUint32(frame[4:8], uint32(state))
+	binary.LittleEndian.PutUint32(frame[12:16], FlagPinned|FlagPowerHeld)
+	binary.LittleEndian.PutUint32(frame[24:28], 3)
+}
+func testRequest(present bool) machine.DeviceAESRequest {
+	iv := make([]byte, BlockSize)
+	if present {
+		for i := range iv {
+			iv[i] = byte(i + 1)
+		}
+	}
+	return machine.DeviceAESRequest{Purpose: machine.DeviceAESPurpose899, Operation: 0, KeyBits: 128, Input: bytes.Repeat([]byte{0x31}, 32), IV: iv, IVPresent: present}
+}
+func requireNoResult(t *testing.T, result machine.DeviceAESResult, err error) {
+	t.Helper()
+	if err == nil || result.Completed || result.Output != nil || result.IV != nil {
+		t.Fatal("failed operation exposed a result")
+	}
+}
+
+func TestProviderSynchronousContract(t *testing.T) {
+	for _, present := range []bool{false, true} {
+		for _, purpose := range []uint32{machine.DeviceAESPurpose899, machine.DeviceAESPurpose89C} {
+			for _, operation := range []uint32{0, 1} {
+				t.Run(fmt.Sprintf("purpose_%x_operation_%d_iv_%t", purpose, operation, present), func(t *testing.T) {
+					request := testRequest(present)
+					request.Purpose = purpose
+					request.Operation = operation
+					originalInput, originalIV := bytes.Clone(request.Input), bytes.Clone(request.IV)
+					wantIV := make([]byte, BlockSize)
+					if present {
+						if operation == 1 {
+							// Decrypt returns the final original ciphertext state, not
+							// the final plaintext output, even with inline copyback.
+							copy(wantIV, originalInput[len(originalInput)-BlockSize:])
+						} else {
+							copy(wantIV, bytes.Repeat([]byte{0x72}, BlockSize))
+						}
+					}
+					var commands []uintptr
+					var ioctlFrame []byte
+					dev := &fakeDevice{call: func(command uintptr, frame []byte) error {
+						commands = append(commands, command)
+						if command == ioctlStatus {
+							if len(frame) != 64 || !allZero(frame) {
+								t.Fatal("STATUS input is not a zeroed frozen frame")
+							}
+							putStatus(frame, Ready)
+							// Neither a historical errno nor an unchanged counter makes
+							// a completed synchronous transform invalid.
+							value := int32(-5)
+							binary.LittleEndian.PutUint32(frame[8:12], uint32(value))
+							return nil
+						}
+						if command != 0xd028b702 || len(frame) != 4136 {
+							t.Fatal("unexpected operation or TRANSFORM size")
+						}
+						expectedPresent := uint32(0)
+						if present {
+							expectedPresent = 1
+						}
+						for i, value := range []uint32{1, purpose, operation, expectedPresent, 32, 0} {
+							if binary.LittleEndian.Uint32(frame[4*i:4*i+4]) != value {
+								t.Fatal("incorrect frozen control field")
+							}
+						}
+						if !bytes.Equal(frame[24:40], originalIV) || !bytes.Equal(frame[40:72], originalInput) || !allZero(frame[72:]) {
+							t.Fatal("incorrect IV/data offsets or uncleared tail")
+						}
+						copy(frame[40:72], bytes.Repeat([]byte{0x91}, 32))
+						copy(frame[24:40], wantIV)
+						ioctlFrame = frame
+						return nil
+					}}
+					provider, err := newProvider(dev)
+					if err != nil {
+						t.Fatal(err)
+					}
+					result, err := provider.TransformDeviceAES(request)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !result.Completed || !bytes.Equal(result.Output, bytes.Repeat([]byte{0x91}, 32)) || len(result.IV) != 16 {
+						t.Fatal("invalid completed output")
+					}
+					if !bytes.Equal(result.IV, wantIV) {
+						t.Fatal("incorrect output IV")
+					}
+					if !bytes.Equal(request.Input, originalInput) || !bytes.Equal(request.IV, originalIV) || !allZero(ioctlFrame) {
+						t.Fatal("caller buffers changed or ioctl frame retained")
+					}
+					if !reflect.DeepEqual(commands, []uintptr{0x8040b703, 0x8040b703, 0xd028b702, 0x8040b703}) {
+						t.Fatal("implicit work or unexpected command sequence")
+					}
+					_ = provider.Close()
+				})
+			}
+		}
+	}
+}
+
+func TestProviderFailureNeverReturnsOrRetriesOutput(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		transform func([]byte) error
+		post      func([]byte)
+	}{
+		{"errno", func(frame []byte) error { frame[40] = 9; return syscall.EIO }, nil},
+		{"EINTR", func(frame []byte) error { frame[40] = 9; return syscall.EINTR }, nil},
+		{"ABI", func(frame []byte) error { frame[0] ^= 1; return nil }, nil},
+		{"purpose", func(frame []byte) error { frame[4] ^= 1; return nil }, nil},
+		{"operation", func(frame []byte) error { frame[8] ^= 1; return nil }, nil},
+		{"IV presence", func(frame []byte) error { frame[12] = 1; return nil }, nil},
+		{"length", func(frame []byte) error { frame[16] = 16; return nil }, nil},
+		{"reserved", func(frame []byte) error { frame[20] = 1; return nil }, nil},
+		{"tail", func(frame []byte) error { frame[len(frame)-1] = 1; return nil }, nil},
+		{"absent IV", func(frame []byte) error { frame[24] = 1; return nil }, nil},
+		{"post poisoned", nil, func(frame []byte) { binary.LittleEndian.PutUint32(frame[4:8], uint32(Poisoned)) }},
+		{"post busy", nil, func(frame []byte) { binary.LittleEndian.PutUint32(frame[12:16], FlagBusy) }},
+		{"post reserved", nil, func(frame []byte) { frame[63] = 1 }},
+	} {
+		for _, operation := range []uint32{0, 1} {
+			t.Run(fmt.Sprintf("%s_operation_%d", test.name, operation), func(t *testing.T) {
+				calls, transforms := 0, 0
+				dev := &fakeDevice{call: func(command uintptr, frame []byte) error {
+					calls++
+					if command == ioctlStatus {
+						putStatus(frame, Ready)
+						if transforms != 0 && test.post != nil {
+							test.post(frame)
+						}
+						return nil
+					}
+					if command != ioctlTransform {
+						t.Fatal("unexpected implicit operation")
+					}
+					transforms++
+					if test.transform != nil {
+						return test.transform(frame)
+					}
+					return nil
+				}}
+				provider, err := newProvider(dev)
+				if err != nil {
+					t.Fatal(err)
+				}
+				request := testRequest(false)
+				request.Operation = operation
+				originalInput, originalIV := bytes.Clone(request.Input), bytes.Clone(request.IV)
+				result, err := provider.TransformDeviceAES(request)
+				requireNoResult(t, result, err)
+				if !bytes.Equal(request.Input, originalInput) || !bytes.Equal(request.IV, originalIV) {
+					t.Fatal("failed transform changed caller input or IV")
+				}
+				if test.name == "EINTR" && !errors.Is(err, syscall.EINTR) {
+					t.Fatal("lost EINTR cause")
+				}
+				before := calls
+				result, err = provider.TransformDeviceAES(request)
+				requireNoResult(t, result, err)
+				if calls != before || transforms != 1 {
+					t.Fatal("failed session retried work")
+				}
+				_ = provider.Close()
+			})
+		}
+	}
+}
+
+func TestProviderRejectsRequestBeforeIoctl(t *testing.T) {
+	for _, mutate := range []func(*machine.DeviceAESRequest){
+		func(r *machine.DeviceAESRequest) { r.Purpose = 1 }, func(r *machine.DeviceAESRequest) { r.Operation = 2 }, func(r *machine.DeviceAESRequest) { r.KeyBits = 256 },
+		func(r *machine.DeviceAESRequest) { r.Input = nil }, func(r *machine.DeviceAESRequest) { r.Input = make([]byte, 17) }, func(r *machine.DeviceAESRequest) { r.Input = make([]byte, 4112) },
+		func(r *machine.DeviceAESRequest) { r.IV = make([]byte, 15) }, func(r *machine.DeviceAESRequest) { r.IV[0] = 1 },
+	} {
+		calls := 0
+		provider, err := newProvider(&fakeDevice{call: func(command uintptr, frame []byte) error { calls++; putStatus(frame, Ready); return nil }})
+		if err != nil {
+			t.Fatal(err)
+		}
+		request := testRequest(false)
+		mutate(&request)
+		result, err := provider.TransformDeviceAES(request)
+		requireNoResult(t, result, err)
+		if calls != 1 {
+			t.Fatal("invalid request touched device")
+		}
+		_ = provider.Close()
+	}
+}
+
+func TestProviderRequiresReadyBeforeAccept(t *testing.T) {
+	for _, mutate := range []func([]byte){
+		func(f []byte) { binary.LittleEndian.PutUint32(f[4:8], uint32(Untested)) },
+		func(f []byte) { binary.LittleEndian.PutUint32(f[4:8], uint32(SelfTestPassed)) },
+		func(f []byte) { binary.LittleEndian.PutUint32(f[4:8], uint32(Poisoned)) },
+		func(f []byte) { f[12] |= byte(FlagBusy) }, func(f []byte) { f[0] = 2 }, func(f []byte) { f[28] = 1 }, func(f []byte) { f[12] |= 0x80 },
+	} {
+		closed, calls := 0, 0
+		provider, err := newProvider(&fakeDevice{call: func(command uintptr, frame []byte) error {
+			calls++
+			if command != ioctlStatus {
+				t.Fatal("startup initialized device")
+			}
+			putStatus(frame, Ready)
+			mutate(frame)
+			return nil
+		}, closing: func() error { closed++; return nil }})
+		if provider != nil || err == nil || closed != 1 || calls != 1 {
+			t.Fatal("unready device accepted or startup retried")
+		}
+	}
+}
+
+func TestProviderCloseWaitsForSynchronousCall(t *testing.T) {
+	entered, release, finished, closed := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var closeCalls atomic.Int32
+	provider, err := newProvider(&fakeDevice{call: func(command uintptr, frame []byte) error {
+		if command == ioctlStatus {
+			putStatus(frame, Ready)
+			return nil
+		}
+		close(entered)
+		<-release
+		return nil
+	}, closing: func() error { closeCalls.Add(1); close(closed); return syscall.EINTR }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	go func() {
+		defer close(finished)
+		result, err := provider.TransformDeviceAES(testRequest(false))
+		if err != nil || !result.Completed {
+			t.Error("synchronous operation failed")
+		}
+	}()
+	<-entered
+	closeDone := make(chan error, 1)
+	go func() { closeDone <- provider.Close() }()
+	select {
+	case <-closed:
+		t.Fatal("close raced outstanding ioctl")
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(release)
+	<-finished
+	if err := <-closeDone; !errors.Is(err, syscall.EINTR) {
+		t.Fatal("close error lost")
+	}
+	if err := provider.Close(); err != nil || closeCalls.Load() != 1 {
+		t.Fatal("close was retried after EINTR")
+	}
+	result, err := provider.TransformDeviceAES(testRequest(false))
+	requireNoResult(t, result, err)
+}
+
+func TestControllerRunsOnlyExplicitActionsAndClearsSeeds(t *testing.T) {
+	var commands []uintptr
+	state := Untested
+	var seedFrame []byte
+	fixture := bytes.Repeat([]byte{0x41}, SeedBundleSize)
+	controller := &Controller{session: &session{device: &fakeDevice{call: func(command uintptr, frame []byte) error {
+		commands = append(commands, command)
+		switch command {
+		case ioctlStatus:
+			putStatus(frame, state)
+		case ioctlSelfTest:
+			if frame != nil {
+				t.Fatal("SELFTEST has payload")
+			}
+			state = SelfTestPassed
+		case ioctlInit:
+			if len(frame) != 40 || binary.LittleEndian.Uint32(frame[:4]) != 1 || !allZero(frame[4:8]) || !bytes.Equal(frame[8:], bytes.Repeat([]byte{0x41}, 32)) {
+				t.Fatal("invalid INIT layout")
+			}
+			seedFrame = frame
+			state = Ready
+		default:
+			t.Fatal("diagnostic issued a transform")
+		}
+		return nil
+	}}}, readSeedFile: func(path string) ([]byte, error) {
+		if path != "explicit-test-file" {
+			t.Fatal("unrequested seed path")
+		}
+		return fixture, nil
+	}}
+	if len(commands) != 0 {
+		t.Fatal("controller auto-initialized")
+	}
+	if _, err := controller.Status(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := controller.SelfTest(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := controller.InitializeFromFile("explicit-test-file"); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(commands, []uintptr{0x8040b703, 0xb700, 0x8040b703, 0x4028b701, 0x8040b703}) {
+		t.Fatal("actions were chained or retried")
+	}
+	if !allZero(fixture) || !allZero(seedFrame) {
+		t.Fatal("seed buffers were retained")
+	}
+	_ = controller.Close()
+}
+
+func TestStatusErrnoDoesNotRetryOrExposeTransformOutput(t *testing.T) {
+	for _, failedStatus := range []int{1, 2, 3} {
+		statuses, transforms, closes := 0, 0, 0
+		dev := &fakeDevice{call: func(command uintptr, frame []byte) error {
+			if command == ioctlStatus {
+				statuses++
+				if statuses == failedStatus {
+					return syscall.EINTR
+				}
+				putStatus(frame, Ready)
+				return nil
+			}
+			if command != ioctlTransform {
+				t.Fatal("unexpected operation after status failure")
+			}
+			transforms++
+			return nil
+		}, closing: func() error { closes++; return nil }}
+		provider, err := newProvider(dev)
+		if failedStatus == 1 {
+			if provider != nil || !errors.Is(err, syscall.EINTR) || closes != 1 || statuses != 1 || transforms != 0 {
+				t.Fatal("startup status errno was retried or accepted")
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		result, err := provider.TransformDeviceAES(testRequest(false))
+		requireNoResult(t, result, err)
+		if !errors.Is(err, syscall.EINTR) || statuses != failedStatus || transforms != failedStatus-2 {
+			t.Fatal("status errno changed work or retry count")
+		}
+		result, err = provider.TransformDeviceAES(testRequest(false))
+		requireNoResult(t, result, err)
+		if statuses != failedStatus {
+			t.Fatal("failed status caused later retry")
+		}
+		_ = provider.Close()
+	}
+}
diff --git a/internal/sap/deviceaes/device_linux_arm64.go b/internal/sap/deviceaes/device_linux_arm64.go
new file mode 100644
index 0000000..06f58de
--- /dev/null
+++ b/internal/sap/deviceaes/device_linux_arm64.go
@@ -0,0 +1,150 @@
+//go:build linux && arm64
+
+package deviceaes
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"runtime"
+	"strconv"
+	"strings"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+const sysfsDevicePath = "/sys/class/misc/omvm-uid1-provider/dev"
+const pinnedSeedSHA256 = "1c6a5cc41f941e0788e436148f280dd5a875caf57929811b802aadca9e253c8d"
+
+type linuxCalls struct {
+	geteuid   func() int
+	lstat     func(string, *unix.Stat_t) error
+	open      func(string, int, uint32) (int, error)
+	fstat     func(int, *unix.Stat_t) error
+	close     func(int) error
+	ioctl     func(int, uintptr, []byte) error
+	readSysfs func() ([]byte, error)
+}
+
+func realLinuxCalls() linuxCalls {
+	return linuxCalls{
+		geteuid: os.Geteuid, lstat: unix.Lstat, open: unix.Open, fstat: unix.Fstat, close: unix.Close,
+		ioctl: func(fd int, command uintptr, frame []byte) error {
+			var pointer unsafe.Pointer
+			if len(frame) != 0 {
+				pointer = unsafe.Pointer(&frame[0])
+			}
+			result, _, errno := unix.Syscall(unix.SYS_IOCTL, uintptr(fd), command, uintptr(pointer))
+			runtime.KeepAlive(frame)
+			if errno != 0 {
+				return errno
+			}
+			if result != 0 {
+				return errors.New("device-AES ioctl returned an unexpected nonzero result")
+			}
+			return nil
+		},
+		readSysfs: func() ([]byte, error) {
+			f, err := os.Open(sysfsDevicePath)
+			if err != nil {
+				return nil, err
+			}
+			defer f.Close()
+			return io.ReadAll(io.LimitReader(f, 65))
+		},
+	}
+}
+
+type linuxDevice struct {
+	fd    int
+	calls linuxCalls
+}
+
+func (d *linuxDevice) ioctl(command uintptr, frame []byte) error {
+	return d.calls.ioctl(d.fd, command, frame)
+}
+func (d *linuxDevice) close() error { return d.calls.close(d.fd) }
+
+func validDeviceStat(st *unix.Stat_t) bool {
+	return st.Uid == 0 && st.Mode&unix.S_IFMT == unix.S_IFCHR && st.Mode&07777 == 0600 && unix.Major(uint64(st.Rdev)) == 10
+}
+
+func sameNode(a, b *unix.Stat_t) bool {
+	return a.Dev == b.Dev && a.Ino == b.Ino && a.Rdev == b.Rdev && a.Uid == b.Uid && a.Gid == b.Gid && a.Mode == b.Mode
+}
+
+func openDevice(path string) (device, error) { return openLinuxDevice(path, realLinuxCalls()) }
+
+func openLinuxDevice(path string, calls linuxCalls) (device, error) {
+	if path != DevicePath || calls.geteuid() != 0 {
+		return nil, errors.New("device-AES requires explicit fixed device path and root")
+	}
+	var before unix.Stat_t
+	if err := calls.lstat(path, &before); err != nil {
+		return nil, errors.New("cannot inspect device-AES node")
+	}
+	if !validDeviceStat(&before) {
+		return nil, errors.New("device-AES node must be root-owned mode-0600 misc character device, not a symlink")
+	}
+	text, err := calls.readSysfs()
+	if err != nil || len(text) == 0 || len(text) > 64 {
+		return nil, errors.New("cannot verify device-AES sysfs identity")
+	}
+	parts := strings.Split(strings.TrimSpace(string(text)), ":")
+	if len(parts) != 2 {
+		return nil, errors.New("invalid device-AES sysfs identity")
+	}
+	major, err := strconv.ParseUint(parts[0], 10, 32)
+	if err != nil || major != 10 {
+		return nil, errors.New("invalid device-AES misc major")
+	}
+	minor, err := strconv.ParseUint(parts[1], 10, 32)
+	if err != nil || uint64(unix.Minor(uint64(before.Rdev))) != minor {
+		return nil, errors.New("device-AES node does not match registered misc device")
+	}
+	fd, err := calls.open(path, unix.O_RDWR|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, fmt.Errorf("open device-AES node: %w", err)
+	}
+	var after unix.Stat_t
+	if err := calls.fstat(fd, &after); err != nil || !validDeviceStat(&after) || !sameNode(&before, &after) {
+		_ = calls.close(fd)
+		return nil, errors.New("device-AES node identity changed during open")
+	}
+	return &linuxDevice{fd: fd, calls: calls}, nil
+}
+
+func readPrivateSeeds(path string) ([]byte, error) {
+	if os.Geteuid() != 0 || path == "" {
+		return nil, errors.New("private seed loading requires root and an explicit file")
+	}
+	var before unix.Stat_t
+	if err := unix.Lstat(path, &before); err != nil || before.Uid != 0 || before.Mode&unix.S_IFMT != unix.S_IFREG || before.Mode&07777 != 0600 || before.Size != SeedBundleSize {
+		return nil, errors.New("seed file must be root-owned, nonsymlink, regular, mode 0600, and exactly 32 bytes")
+	}
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, errors.New("cannot open private seed file")
+	}
+	f := os.NewFile(uintptr(fd), path)
+	defer f.Close()
+	var after unix.Stat_t
+	if err := unix.Fstat(fd, &after); err != nil || !sameNode(&before, &after) || after.Size != SeedBundleSize {
+		return nil, errors.New("private seed file changed during open")
+	}
+	seeds, err := io.ReadAll(io.LimitReader(f, SeedBundleSize+1))
+	if err != nil || len(seeds) != SeedBundleSize {
+		clear(seeds)
+		return nil, errors.New("cannot read bounded private seed bundle")
+	}
+	digest := sha256.Sum256(seeds)
+	if hex.EncodeToString(digest[:]) != pinnedSeedSHA256 {
+		clear(seeds)
+		return nil, errors.New("private seed bundle does not match the pinned build")
+	}
+	return seeds, nil
+}
diff --git a/internal/sap/deviceaes/device_linux_arm64_test.go b/internal/sap/deviceaes/device_linux_arm64_test.go
