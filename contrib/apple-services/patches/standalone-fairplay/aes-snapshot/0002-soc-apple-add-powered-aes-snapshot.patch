diff --git a/drivers/soc/apple/apple-sio-aes-snapshot.c b/drivers/soc/apple/apple-sio-aes-snapshot.c
new file mode 100644
index 0000000..4103e75
--- /dev/null
+++ b/drivers/soc/apple/apple-sio-aes-snapshot.c
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * One powered-probe snapshot of the T6000 SIO AES readiness and disable bits.
+ * No engine initialization, reset, interrupt, FIFO, DMA or key operations.
+ */
+
+#include <linux/debugfs.h>
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/iommu.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+
+#define APPLE_AES_READINESS_OFFSET	0x0c
+#define APPLE_AES_V3_READY_MASK		0x3f80
+#define APPLE_AES_DISABLE_MASK		0x07
+
+struct apple_aes_snapshot {
+	u32 readiness;
+	u32 disable;
+	bool disable_valid;
+};
+
+static int apple_aes_snapshot_show(struct seq_file *s, void *unused)
+{
+	const struct apple_aes_snapshot *snapshot = s->private;
+
+	seq_puts(s, "phase: powered-probe\n");
+	seq_printf(s, "readiness_raw: %#010x\n", snapshot->readiness);
+	seq_printf(s, "readiness_required_mask: %#010x\n",
+		   APPLE_AES_V3_READY_MASK);
+	if (!snapshot->disable_valid) {
+		seq_puts(s, "disable_state: unavailable\n");
+		seq_puts(s, "uid1_disable_bit: unavailable\n");
+		seq_puts(s, "gid0_disable_bit: unavailable\n");
+		seq_puts(s, "gid1_disable_bit: unavailable\n");
+		return 0;
+	}
+
+	seq_puts(s, "disable_state: sampled\n");
+	seq_printf(s, "uid1_disable_bit: %s\n",
+		   snapshot->disable & 0x01 ? "set" : "clear");
+	seq_printf(s, "gid0_disable_bit: %s\n",
+		   snapshot->disable & 0x02 ? "set" : "clear");
+	seq_printf(s, "gid1_disable_bit: %s\n",
+		   snapshot->disable & 0x04 ? "set" : "clear");
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(apple_aes_snapshot);
+
+static void apple_aes_snapshot_remove_debugfs(void *directory)
+{
+	debugfs_remove_recursive(directory);
+}
+
+static void __iomem *apple_aes_snapshot_map(struct platform_device *pdev,
+					  unsigned int index, const char *name,
+					  resource_size_t expected_size)
+{
+	struct resource *resource, *named;
+
+	resource = platform_get_resource(pdev, IORESOURCE_MEM, index);
+	named = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+	if (!resource || resource != named ||
+	    resource_size(resource) != expected_size)
+		return IOMEM_ERR_PTR(-EINVAL);
+
+	return devm_ioremap_resource(&pdev->dev, resource);
+}
+
+static int apple_aes_snapshot_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct apple_aes_snapshot *snapshot;
+	struct dentry *directory, *state;
+	void __iomem *engine, *disable;
+	char *name;
+	int ret;
+
+	/* The ordinary platform/PM/IOMMU paths own power and both SIO DARTs. */
+	if (!dev->pm_domain ||
+	    of_count_phandle_with_args(dev->of_node, "power-domains",
+				       "#power-domain-cells") != 1)
+		return dev_err_probe(dev, -EINVAL, "Missing AES power domain\n");
+	if (of_count_phandle_with_args(dev->of_node, "iommus",
+				       "#iommu-cells") != 2 ||
+	    !iommu_get_domain_for_dev(dev))
+		return dev_err_probe(dev, -ENODEV, "Missing paired SIO DART domain\n");
+	if (platform_get_resource(pdev, IORESOURCE_MEM, 2))
+		return dev_err_probe(dev, -EINVAL, "Unexpected register bank\n");
+
+	engine = apple_aes_snapshot_map(pdev, 0, "engine", 0x4000);
+	if (IS_ERR(engine))
+		return dev_err_probe(dev, PTR_ERR(engine), "Invalid engine bank\n");
+	disable = apple_aes_snapshot_map(pdev, 1, "key-disable", 0x8000);
+	if (IS_ERR(disable))
+		return dev_err_probe(dev, PTR_ERR(disable), "Invalid disable bank\n");
+
+	snapshot = devm_kzalloc(dev, sizeof(*snapshot), GFP_KERNEL);
+	if (!snapshot)
+		return -ENOMEM;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to power AES for snapshot\n");
+
+	/*
+	 * At most two AES register reads; no polling or register writes.
+	 * Revision 3 requires every readiness bit, not just a nonzero word.
+	 * Reject all-ones reads conservatively as unavailable as well.
+	 */
+	snapshot->readiness = readl(engine + APPLE_AES_READINESS_OFFSET);
+	if (snapshot->readiness != ~0U &&
+	    (snapshot->readiness & APPLE_AES_V3_READY_MASK) ==
+						APPLE_AES_V3_READY_MASK) {
+		u32 value = readl(disable);
+
+		if (value != ~0U) {
+			snapshot->disable = value & APPLE_AES_DISABLE_MASK;
+			snapshot->disable_valid = true;
+		}
+	}
+
+	ret = pm_runtime_put_sync_suspend(dev);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to release AES power\n");
+
+	name = devm_kasprintf(dev, GFP_KERNEL, "apple-sio-aes-snapshot-%s",
+			     dev_name(dev));
+	if (!name)
+		return -ENOMEM;
+	directory = debugfs_create_dir(name, NULL);
+	if (IS_ERR(directory))
+		return PTR_ERR(directory);
+	ret = devm_add_action_or_reset(dev, apple_aes_snapshot_remove_debugfs,
+				       directory);
+	if (ret)
+		return ret;
+	state = debugfs_create_file("state", 0400, directory, snapshot,
+				    &apple_aes_snapshot_fops);
+	return PTR_ERR_OR_ZERO(state);
+}
+
+static const struct of_device_id apple_aes_snapshot_match[] = {
+	{ .compatible = "apple,t6000-aes" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, apple_aes_snapshot_match);
+
+static struct platform_driver apple_aes_snapshot_driver = {
+	.probe = apple_aes_snapshot_probe,
+	.driver = {
+		.name = "apple-sio-aes-snapshot",
+		.of_match_table = apple_aes_snapshot_match,
+	},
+};
+module_platform_driver(apple_aes_snapshot_driver);
+
+MODULE_DESCRIPTION("Apple T6000 AES powered-probe status snapshot");
+MODULE_LICENSE("GPL");
