--- a/hw/vmapple/apple-fairplay.c
+++ b/hw/vmapple/apple-fairplay.c
@@ -85,6 +85,24 @@
     fp_fail(opaque, "relay deadline exceeded");
 }
 
+/* OFR2 explicitly distinguishes a completed queue-0 operation from a
+ * transport/emulator failure. Native queue 0 returns its modified buffer even
+ * when the backend's raw status is nonzero. OFR1 retains its legacy contract.
+ */
+static bool fp_valid_reply_header(const unsigned char *header, bool queue0,
+                                  uint32_t input_length, uint32_t capacity)
+{
+    uint32_t length = ldl_le_p(header + 12);
+
+    if (ldl_le_p(header + 4) || length > capacity) {
+        return false;
+    }
+    if (!memcmp(header, "OFR2", 4)) {
+        return queue0 && input_length && length == input_length;
+    }
+    return !memcmp(header, "OFR1", 4) && !ldl_le_p(header + 8);
+}
+
 static void fp_read(void *opaque)
 {
     AppleFairPlay *s = opaque;
@@ -112,9 +130,9 @@
