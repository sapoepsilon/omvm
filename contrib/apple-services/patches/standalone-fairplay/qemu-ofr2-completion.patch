             length = ldl_le_p(s->rx + 12);
-            if (memcmp(s->rx, "OFR1", 4) ||
-                ldl_le_p(s->rx + 4) || ldl_le_p(s->rx + 8) ||
-                length > s->capacity || s->rx_len > length + 16) {
