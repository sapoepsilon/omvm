+// independently opened device file description. No deadline releases ownership
+// while a synchronous ioctl is still running. Kernel state remains authoritative:
+// acquiring a lock after another process exits does not establish hardware safety.
+func transaction[T any](s *session, operation func() (T, error)) (result T, err error) {
+	s.mu.Lock()
