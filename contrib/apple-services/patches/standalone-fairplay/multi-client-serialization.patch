+// Wait only for advisory lock contention, never for/retry a work ioctl. An
+// unsupported flock or any other locking error fails closed without a fallback.
+func (d *linuxDevice) lock() error {
+	deadline := d.calls.now().Add(transactionLockWait)
+	for {
+		err := d.calls.flock(d.fd, unix.LOCK_EX|unix.LOCK_NB)
+		if err == nil {
+			return nil
+		}
+		if !errors.Is(err, unix.EWOULDBLOCK) && !errors.Is(err, unix.EAGAIN) {
+			return err
+		}
+		remaining := deadline.Sub(d.calls.now())
+		if remaining <= 0 {
+			return fmt.Errorf("device-AES transaction lock wait expired: %w", unix.ETIMEDOUT)
+		}
+		d.calls.sleep(min(remaining, transactionLockPoll))
+		if !d.calls.now().Before(deadline) {
+			return fmt.Errorf("device-AES transaction lock wait expired: %w", unix.ETIMEDOUT)
+		}
+	}
+}
+
+func (d *linuxDevice) unlock() error { return d.calls.flock(d.fd, unix.LOCK_UN) }
+
