+	"golang.org/x/sys/unix"
+)
+
+func TestFlockWaitIsBoundedBeforeAnyIoctl(t *testing.T) {
+	for _, lockErr := range []error{unix.EWOULDBLOCK, unix.EOPNOTSUPP, unix.EINTR} {
+		now := time.Unix(0, 0)
+		attempts, closes := 0, 0
+		calls := realLinuxCalls()
+		calls.now = func() time.Time { return now }
+		calls.sleep = func(d time.Duration) { now = now.Add(d) }
+		calls.flock = func(fd, operation int) error {
+			if fd != 42 || operation != unix.LOCK_EX|unix.LOCK_NB {
+				t.Fatal("unexpected flock operation")
+			}
+			attempts++
+			return lockErr
+		}
+		calls.ioctl = func(int, uintptr, []byte) error { t.Fatal("lock wait issued an ioctl"); return nil }
+		calls.close = func(int) error { closes++; return nil }
+		p, err := newProvider(&linuxDevice{fd: 42, calls: calls})
+		want := lockErr
+		if errors.Is(lockErr, unix.EWOULDBLOCK) {
+			want = unix.ETIMEDOUT
+		}
+		if p != nil || !errors.Is(err, want) || closes != 1 {
+			t.Fatal("lock failure accepted or lost")
+		}
+		if errors.Is(lockErr, unix.EWOULDBLOCK) {
+			if now.Sub(time.Unix(0, 0)) != transactionLockWait || attempts < 2 {
+				t.Fatal("unbounded or absent contention wait")
+			}
+		} else if attempts != 1 {
+			t.Fatal("non-contention flock error retried")
+		}
+	}
+}
+
+// Synthetic files supply a common inode for real flock tests. The ioctl is
+// always replaced; production openDevice still accepts only the validated
+// fixed misc character device. These tests never open a hardware device.
+func TestFlockProcessHelper(t *testing.T) {
+	mode := os.Getenv("OMVM_FLOCK_TEST_MODE")
+	if mode == "" {
+		return
+	}
+	f, err := os.OpenFile(os.Getenv("OMVM_FLOCK_TEST_INODE"), os.O_RDWR, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if mode == "hold" {
+		if err := unix.Flock(int(f.Fd()), unix.LOCK_EX); err != nil {
+			t.Fatal(err)
+		}
+		fmt.Println("held")
+		var b [1]byte
+		_, _ = os.Stdin.Read(b[:])
+		return
+	}
+	log, err := os.OpenFile(os.Getenv("OMVM_FLOCK_TEST_LOG"), os.O_WRONLY|os.O_APPEND, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer log.Close()
+	id := os.Getenv("OMVM_FLOCK_TEST_ID")
+	record := func(event string) {
+		if _, err := fmt.Fprintln(log, id+" "+event); err != nil {
+			t.Fatal(err)
+		}
+	}
+	calls := realLinuxCalls()
+	calls.close = func(int) error { return nil } // f owns the synthetic descriptor.
+	calls.flock = func(fd, operation int) error {
+		if operation == unix.LOCK_UN {
+			record("unlock")
+		}
+		err := unix.Flock(fd, operation)
+		if err == nil && operation != unix.LOCK_UN {
+			record("lock")
+		}
+		return err
+	}
+	calls.ioctl = func(_ int, command uintptr, frame []byte) error {
+		if command == ioctlStatus {
+			record("status")
+			putStatus(frame, Ready)
+		} else if command == ioctlTransform || command == ioctlDSBDecrypt {
+			record("work")
+			// Give the competing process an opportunity to seek ownership.
+			time.Sleep(time.Millisecond)
+		} else {
+			t.Fatal("unexpected synthetic ioctl")
+		}
+		return nil
+	}
+	fmt.Println("ready")
+	p, err := newProvider(&linuxDevice{fd: int(f.Fd()), calls: calls})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	for i := 0; i < 5; i++ {
+		if _, err := p.TransformDeviceAES(testRequest(true)); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := p.TransformDeviceAESDSB(dsbFixture()); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestIndependentProcessesSerializeWholeTransactions(t *testing.T) {
+	dir := t.TempDir()
+	inode, logPath := filepath.Join(dir, "device-inode"), filepath.Join(dir, "events")
+	if err := os.WriteFile(inode, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(logPath, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	owner, err := os.OpenFile(inode, os.O_RDWR, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer owner.Close()
+	if err := unix.Flock(int(owner.Fd()), unix.LOCK_EX); err != nil {
+		t.Fatal(err)
+	}
+	var children []*exec.Cmd
+	for _, id := range []string{"one", "two"} {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestFlockProcessHelper$")
+		cmd.Env = append(os.Environ(), "OMVM_FLOCK_TEST_MODE=work", "OMVM_FLOCK_TEST_INODE="+inode,
+			"OMVM_FLOCK_TEST_LOG="+logPath, "OMVM_FLOCK_TEST_ID="+id)
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			t.Fatal(err)
+		}
+		cmd.Stderr = os.Stderr
+		if err := cmd.Start(); err != nil {
+			t.Fatal(err)
+		}
+		children = append(children, cmd)
+		t.Cleanup(func() { _ = cmd.Process.Kill() })
+		scanner := bufio.NewScanner(stdout)
+		if !scanner.Scan() || scanner.Text() != "ready" {
+			t.Fatal("child failed before arbitration")
+		}
+	}
+	if data, err := os.ReadFile(logPath); err != nil || len(data) != 0 {
+		t.Fatal("child operated before cross-process lock release")
+	}
+	if err := unix.Flock(int(owner.Fd()), unix.LOCK_UN); err != nil {
+		t.Fatal(err)
+	}
+	for _, cmd := range children {
+		if err := cmd.Wait(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	data, err := os.ReadFile(logPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	active := ""
+	var sequence []string
+	counts := map[string]int{}
+	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) != 2 {
+			t.Fatal("malformed synthetic event")
+		}
+		id, event := fields[0], fields[1]
+		if event == "lock" {
+			if active != "" {
+				t.Fatal("independent process transactions overlapped")
+			}
+			active, sequence = id, nil
+		} else {
+			if active != id {
+				t.Fatal("ioctl escaped the owning process transaction")
+			}
+			if event == "unlock" {
+				joined := strings.Join(sequence, ",")
+				if joined != "status" && joined != "status,work,status" {
+					t.Fatalf("partial transaction: %s", joined)
+				}
+				counts[id]++
+				active = ""
+			} else {
+				sequence = append(sequence, event)
+			}
+		}
+	}
+	if active != "" || counts["one"] != 11 || counts["two"] != 11 {
+		t.Fatal("missing completed transactions")
+	}
+}
+
+func TestProcessDeathReleasesLockButDoesNotEstablishReady(t *testing.T) {
+	inode := filepath.Join(t.TempDir(), "device-inode")
+	if err := os.WriteFile(inode, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command(os.Args[0], "-test.run=^TestFlockProcessHelper$")
+	cmd.Env = append(os.Environ(), "OMVM_FLOCK_TEST_MODE=hold", "OMVM_FLOCK_TEST_INODE="+inode)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stdin.Close()
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = cmd.Process.Kill() })
+	scanner := bufio.NewScanner(stdout)
+	if !scanner.Scan() || scanner.Text() != "held" {
+		t.Fatal("child did not acquire lock")
+	}
+	if err := cmd.Process.Kill(); err != nil {
+		t.Fatal(err)
+	}
+	_ = cmd.Wait()
+	f, err := os.OpenFile(inode, os.O_RDWR, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	calls, statuses := realLinuxCalls(), 0
+	calls.close = func(int) error { return nil }
+	calls.ioctl = func(_ int, command uintptr, frame []byte) error {
+		if command != ioctlStatus {
+			t.Fatal("dead owner's lock authorized hardware work")
+		}
+		statuses++
+		putStatus(frame, Poisoned)
+		return nil
+	}
+	p, err := newProvider(&linuxDevice{fd: int(f.Fd()), calls: calls})
+	if p != nil || err == nil || statuses != 1 {
+		t.Fatal("lock release was mistaken for hardware recovery")
+	}
+}
diff --git c/internal/sap/deviceaes/transaction_test.go i/internal/sap/deviceaes/transaction_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e55b25d9f156050bae2d4a7b313f087d34862b96
--- /dev/null
+++ i/internal/sap/deviceaes/transaction_test.go
@@ -0,0 +1,186 @@
+package deviceaes
+
+import (
+	"bytes"
+	"errors"
+	"reflect"
+	"syscall"
+	"testing"
+
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+)
+
+func TestEveryProviderOperationOwnsTransaction(t *testing.T) {
+	var events []string
+	held := false
+	state := Ready
+	dev := &fakeDevice{
+		locking: func() error {
+			if held {
+				t.Fatal("nested device lock")
+			}
+			held = true
+			events = append(events, "lock")
+			return nil
+		},
+		unlocking: func() error {
+			if !held {
+				t.Fatal("unlock without ownership")
+			}
+			held = false
+			events = append(events, "unlock")
+			return nil
+		},
+		call: func(command uintptr, frame []byte) error {
+			if !held {
+				t.Fatal("ioctl outside transaction")
+			}
+			switch command {
+			case ioctlStatus:
+				events = append(events, "status")
+				putStatus(frame, state)
+			case ioctlTransform, ioctlDSBDecrypt:
+				events = append(events, "work")
+			case ioctlSelfTest:
+				events = append(events, "selftest")
+				state = SelfTestPassed
+			case ioctlInit:
+				events = append(events, "init")
+				state = Ready
+			case ioctlCapability:
+				events = append(events, "capability")
+				frame[0] = byte(ABIVersion)
+			default:
+				t.Fatal("unexpected ioctl")
+			}
+			return nil
+		},
+	}
+	check := func(want ...string) {
+		t.Helper()
+		if held || !reflect.DeepEqual(events, want) {
+			t.Fatalf("transaction events: %v, want %v", events, want)
+		}
+		events = nil
+	}
+	p, err := newProvider(dev)
+	if err != nil {
+		t.Fatal(err)
+	}
+	check("lock", "status", "unlock")
+	if _, err := p.TransformDeviceAES(testRequest(true)); err != nil {
+		t.Fatal(err)
+	}
+	check("lock", "status", "work", "status", "unlock")
+	if _, err := p.TransformDeviceAESDSB(dsbFixture()); err != nil {
+		t.Fatal(err)
+	}
+	check("lock", "status", "work", "status", "unlock")
+	c := &Controller{session: p.session, readSeedFile: func(string) ([]byte, error) {
+		if !held {
+			t.Fatal("private seed read outside transaction")
+		}
+		return bytes.Repeat([]byte{1}, SeedBundleSize), nil
+	}}
+	if _, err := c.Status(); err != nil {
+		t.Fatal(err)
+	}
+	check("lock", "status", "unlock")
+	if _, err := c.SelfTest(); err != nil {
+		t.Fatal(err)
+	}
+	check("lock", "selftest", "status", "unlock")
+	if _, err := c.InitializeFromFile("synthetic"); err != nil {
+		t.Fatal(err)
+	}
+	check("lock", "init", "status", "unlock")
+	if _, err := c.Capability(); err != nil {
+		t.Fatal(err)
+	}
+	check("lock", "capability", "unlock")
+}
+
+func TestTransactionUnlockFailureDiscardsAndWipesOutput(t *testing.T) {
+	output, iv := bytes.Repeat([]byte{3}, 16), bytes.Repeat([]byte{4}, 16)
+	locks, unlocks, calls := 0, 0, 0
+	s := &session{device: &fakeDevice{
+		locking:   func() error { locks++; return nil },
+		unlocking: func() error { unlocks++; return syscall.EIO },
+	}}
+	work := func() (machine.DeviceAESResult, error) {
+		calls++
+		return machine.DeviceAESResult{Completed: true, Output: output, IV: iv}, nil
+	}
+	result, err := transaction(s, work)
+	requireNoResult(t, result, err)
+	if !errors.Is(err, syscall.EIO) || !allZero(output) || !allZero(iv) {
+		t.Fatal("unlock failure retained completed bytes")
+	}
+	result, err = transaction(s, work)
+	requireNoResult(t, result, err)
+	if locks != 1 || unlocks != 1 || calls != 1 {
+		t.Fatal("failed transaction was retried")
+	}
+}
+
+func TestAdvisoryLockFailureDoesNotIssueAnIoctl(t *testing.T) {
+	for _, lockErr := range []error{syscall.ETIMEDOUT, syscall.EOPNOTSUPP, syscall.EINTR} {
+		closes, locks := 0, 0
+		dev := &fakeDevice{
+			locking:   func() error { locks++; return lockErr },
+			unlocking: func() error { t.Fatal("unowned lock released"); return nil },
+			call:      func(uintptr, []byte) error { t.Fatal("lock failure submitted an ioctl"); return nil },
+			closing:   func() error { closes++; return nil },
+		}
+		p, err := newProvider(dev)
+		if p != nil || !errors.Is(err, lockErr) || locks != 1 || closes != 1 {
+			t.Fatal("failed open retained or retried session")
+		}
+	}
+}
+
+func TestWorkBusyNeverRetriesAndPoisonedResultIsEmpty(t *testing.T) {
+	for _, dsb := range []bool{false, true} {
+		for _, busy := range []bool{false, true} {
+			workCalls, unlocks := 0, 0
+			dev := &fakeDevice{
+				unlocking: func() error { unlocks++; return nil },
+				call: func(command uintptr, frame []byte) error {
+					if command == ioctlStatus {
+						state := Ready
+						if workCalls > 0 {
+							state = Poisoned
+						}
+						putStatus(frame, state)
+						return nil
+					}
+					workCalls++
+					if busy {
+						return syscall.EBUSY
+					}
+					return nil
+				},
+			}
+			p, err := newProvider(dev)
+			if err != nil {
+				t.Fatal(err)
+			}
+			invoke := func() (machine.DeviceAESResult, error) {
+				if dsb {
+					return p.TransformDeviceAESDSB(dsbFixture())
+				}
+				return p.TransformDeviceAES(testRequest(true))
+			}
+			result, err := invoke()
+			requireNoResult(t, result, err)
+			if busy && !errors.Is(err, syscall.EBUSY) {
+				t.Fatal("work errno lost")
+			}
+			result, err = invoke()
+			requireNoResult(t, result, err)
+			if workCalls != 1 || unlocks != 2 {
+				t.Fatal("work retried or transaction not released")
+			}
+		}
+	}
+}
