+			// validation or unlock failed. Wipe any copied payload before return.
+			if payload, ok := any(result).(machine.DeviceAESResult); ok {
+				clear(payload.Output)
+				clear(payload.IV)
+			}
+			var zero T
+			result = zero
+		}
+	}()
