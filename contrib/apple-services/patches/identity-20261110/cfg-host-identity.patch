+/* Native AVP offsets 0x560 and 0x670 contain a SHA-256 build digest and
+ * the first32 build bytes. The hash covers the FULL unpadded build string. */
+static bool vmapple_cfg_apply_host_identity(VMAppleCfg *cfg,
+                                            const char *build, size_t build_len,
+                                            const uint8_t *serial, size_t serial_len,
+                                            Error **errp)
+{
+    uint8_t digest[32];
+    gsize digest_len = sizeof(digest);
+    g_autoptr(GChecksum) hash = NULL;
+
+    if (!cfg || !build || !build_len || memchr(build, 0, build_len) || !serial) {
+        error_setg(errp, "vmapple cfg: invalid physical host identity input");
+        return false;
+    }
+    while (serial_len && !serial[serial_len - 1]) {
+        serial_len--;
+    }
+    if (!serial_len || serial_len > sizeof(cfg->host_serial)) {
+        error_setg(errp, "vmapple cfg: physical host serial must contain 1..32 bytes");
+        return false;
+    }
+    for (size_t i = 0; i < serial_len; i++) {
+        if (serial[i] < 0x21 || serial[i] > 0x7e) {
+            error_setg(errp, "vmapple cfg: physical host serial is not printable ASCII");
+            return false;
+        }
+    }
+    hash = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(hash, (const uint8_t *)build, build_len);
+    g_checksum_get_digest(hash, digest, &digest_len);
+    memcpy(cfg->host_build_digest, digest, sizeof(digest));
+    memset(cfg->host_serial, 0, sizeof(cfg->host_serial));
+    memcpy(cfg->host_serial, serial, serial_len);
+    memset(cfg->host_build, 0, sizeof(cfg->host_build));
+    memcpy(cfg->host_build, build, MIN(build_len, sizeof(cfg->host_build)));
+    return true;
+}
+
+static bool vmapple_cfg_load_host_identity(VMAppleCfg *cfg, Error **errp)
+{
+    struct utsname host;
+    g_autofree char *serial = NULL;
+    gsize serial_len;
+
+    /* Match the strict external identity loader's explicit opt-in. Legacy
+     * configurations retain their existing bytes and command-line behavior. */
+    if (!getenv("OMVM_IDENTITY_CERT_CHAIN")) {
+        return true;
+    }
+    if (uname(&host) < 0) {
+        error_setg(errp, "vmapple cfg: cannot read Linux host build");
+        return false;
+    }
+    if (!g_file_get_contents("/sys/firmware/devicetree/base/serial-number",
+                             &serial, &serial_len, NULL)) {
+        error_setg(errp, "vmapple cfg: cannot read physical Linux DT serial");
+        return false;
+    }
+    return vmapple_cfg_apply_host_identity(cfg, host.release,
+                                           strnlen(host.release, sizeof(host.release)),
+                                           (const uint8_t *)serial, serial_len, errp);
+}
 
