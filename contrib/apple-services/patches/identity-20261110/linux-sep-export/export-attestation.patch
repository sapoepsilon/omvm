+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Export committed-UIK attestation and its existing target key's public point.
+
+Requires the matching SEP_BIO_EXPORT_ATTESTATION kernel ioctl. This does not
+request certificate issuance, create a key, or export private key material.
+"""
+
+import argparse
+import errno
+import fcntl
+import json
+import os
+import struct
+import sys
+from pathlib import Path
+
+DER_MAX = 4096
+HEADER = struct.Struct("=II65s7s")
+RESPONSE_SIZE = HEADER.size + DER_MAX
+# Linux generic _IOR: direction 2, sizeof(struct)=4176, magic 0xb1, nr 0x0c.
+EXPORT_ATTESTATION = (2 << 30) | (RESPONSE_SIZE << 16) | (0xB1 << 8) | 0x0C
+SYSTEM_HEADER = struct.Struct("=IIII")
+SYSTEM_RESPONSE_SIZE = SYSTEM_HEADER.size + DER_MAX
+SYSTEM_PUBLIC_KEY = (3 << 30) | (SYSTEM_RESPONSE_SIZE << 16) | (0xB1 << 8) | 0x0D
+
+
+def complete_der(data):
+    """Check complete canonical SEQUENCE framing without interpreting its body."""
+    if len(data) < 2 or data[0] != 0x30:
+        return False
+    first = data[1]
+    if first < 0x80:
+        header, length = 2, first
+    else:
+        count = first & 0x7F
+        if not 1 <= count <= 2 or len(data) < 2 + count or data[2] == 0:
+            return False
+        header = 2 + count
+        length = int.from_bytes(data[2:header], "big")
+        if length < 128:
+            return False
+    return length > 0 and header + length == len(data)
+
+
+def decode_response(response):
+    if len(response) != RESPONSE_SIZE:
+        raise ValueError("incorrect ioctl response size")
+    version, length, point, reserved = HEADER.unpack_from(response)
+    if version != 1 or reserved != bytes(7):
+        raise ValueError("unsupported response version or nonzero reserved bytes")
+    if not 0 < length <= DER_MAX:
+        raise ValueError("invalid attestation length")
+    if point[0] != 4:
+        raise ValueError("target public key is not an uncompressed P-256 point")
+    der = bytes(response[HEADER.size:HEADER.size + length])
+    if not complete_der(der):
+        raise ValueError("attestation is not a complete DER SEQUENCE")
+    if any(response[HEADER.size + length:]):
+        raise ValueError("nonzero unused response bytes")
+    return der, point
+
+
+def decode_system_key_response(response, system_key_type, generation):
+    if len(response) != SYSTEM_RESPONSE_SIZE:
+        raise ValueError("incorrect system public-key response size")
+    version, actual_type, actual_generation, length = SYSTEM_HEADER.unpack_from(response)
+    if (version, actual_type, actual_generation) != (1, system_key_type, generation):
+        raise ValueError("incorrect system public-key selector or response version")
+    if not 0 < length <= DER_MAX:
+        raise ValueError("invalid system public-key length")
+    if any(response[SYSTEM_HEADER.size + length:]):
+        raise ValueError("nonzero unused system public-key bytes")
+    return bytes(response[SYSTEM_HEADER.size:SYSTEM_HEADER.size + length])
+
+
+def export(device, include_system_public_keys=False):
+    fd = os.open(device, os.O_RDONLY | os.O_CLOEXEC)
+    try:
+        response = bytearray(RESPONSE_SIZE)
+        fcntl.ioctl(fd, EXPORT_ATTESTATION, response, True)
+        der, point = decode_response(response)
+        system_keys = {}
+        if include_system_public_keys:
+            for name, system_key_type, generation in [("SIKPub", 1, 1), ("UIKPub", 2, 2)]:
+                public_response = bytearray(SYSTEM_RESPONSE_SIZE)
+                SYSTEM_HEADER.pack_into(public_response, 0, 1, system_key_type, generation, 0)
+                fcntl.ioctl(fd, SYSTEM_PUBLIC_KEY, public_response, True)
+                system_keys[name] = decode_system_key_response(
+                    public_response, system_key_type, generation)
+    finally:
+        os.close(fd)
+    return der, point, system_keys
+
+
+def save_bundle(directory, der, point, system_keys=None):
+    # Refuse every existing destination, including symlinks. All artifacts are
+    # private by default even though no private key is present.
+    directory.mkdir(mode=0o700, parents=False, exist_ok=False)
+    created = []
+    try:
+        metadata = {
+            "format_version": 1,
+            "system_key_type": 2,
+            "system_key_generation": 2,
+            "attestation_bytes": len(der),
+            "public_key_format": "uncompressed-P256-X9.63",
+            "public_key_bytes": len(point),
+            "private_key_exported": False,
+        }
+        contents = {
+            "attestation.der": der,
+            "public-key.x963": point,
+        }
+        if system_keys:
+            if set(system_keys) != {"SIKPub", "UIKPub"}:
+                raise ValueError("both SIKPub and UIKPub are required")
+            for name, data in system_keys.items():
+                contents[f"{name}.bin"] = data
+            metadata["system_public_keys"] = {
+                name: {"bytes": len(data), "format": "opaque-oskgp-public-data"}
+                for name, data in system_keys.items()
+            }
+        contents["metadata.json"] = (json.dumps(metadata, indent=2) + "\n").encode()
+        for name, data in contents.items():
+            path = directory / name
+            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
+            created.append(path)
+            with os.fdopen(fd, "wb") as output:
+                output.write(data)
+                output.flush()
+                os.fsync(output.fileno())
+    except BaseException:
+        for path in reversed(created):
+            path.unlink()
+        directory.rmdir()
+        raise
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--device", default="/dev/sep-bio")
+    parser.add_argument("--include-system-public-keys", action="store_true",
+                        help="also export opaque SIKPub (1,1) and committed UIKPub (2,2)")
+    parser.add_argument("--output-dir", required=True, type=Path,
+                        help="new private directory; an existing path is never overwritten")
+    args = parser.parse_args()
+    try:
+        if args.output_dir.exists() or args.output_dir.is_symlink():
+            raise FileExistsError(errno.EEXIST, "output path already exists", str(args.output_dir))
+        der, point, system_keys = export(args.device, args.include_system_public_keys)
+        save_bundle(args.output_dir, der, point, system_keys)
+    except (OSError, ValueError) as error:
+        if isinstance(error, OSError) and error.errno == errno.ENOTTY:
+            print("export failed: the running SEP driver lacks the export ioctl", file=sys.stderr)
+        else:
+            print(f"export failed: {error}", file=sys.stderr)
+        return 1
+    print(f"Exported {len(der)} attestation bytes and {len(point)} public-key bytes to {args.output_dir}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
