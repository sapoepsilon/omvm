--- /dev/null
+++ b/tools/aurora-sep/tests/test_export_attestation.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Exercise the attestation ABI boundary without touching a SEP or key store."""
+
+import importlib.machinery
+import importlib.util
+import os
+from pathlib import Path
+import tempfile
+import unittest
+
+SCRIPT = Path(__file__).resolve().parents[1] / "aurora-sep-export-attestation"
+LOADER = importlib.machinery.SourceFileLoader("export_attestation", str(SCRIPT))
+SPEC = importlib.util.spec_from_loader(LOADER.name, LOADER)
+EXPORT = importlib.util.module_from_spec(SPEC)
+LOADER.exec_module(EXPORT)
+
+# Public NIST P-256 generator; no private key or device identity is used.
+POINT = bytes.fromhex(
+    "04"
+    "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"
+    "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"
+)
+# A version-2 envelope is deliberately accepted as opaque DER, not decoded as
+# a supposed plaintext X.509 certificate. This was misidentified in old notes.
+ENVELOPE = bytes.fromhex("300a02010230050403616263")
+
+
+def response(der=ENVELOPE, length=None):
+    if length is None:
+        length = len(der)
+    return bytearray(EXPORT.HEADER.pack(1, length, POINT, bytes(7))
+                     + der.ljust(EXPORT.DER_MAX, b"\0"))
+
+
+class ExportBoundaryTest(unittest.TestCase):
+    def test_preserves_encrypted_der_and_matching_public_point(self):
+        der, point = EXPORT.decode_response(response())
+        self.assertEqual(der, ENVELOPE)
+        self.assertEqual(point, POINT)
+        self.assertEqual(EXPORT.RESPONSE_SIZE, 4176)
+        self.assertEqual(EXPORT.EXPORT_ATTESTATION, 0x9050B10C)
+
+    def test_rejects_transport_framing_instead_of_silently_exporting_it(self):
+        framed = (0).to_bytes(4, "little") + len(ENVELOPE).to_bytes(4, "little") + ENVELOPE
+        with self.assertRaisesRegex(ValueError, "complete DER"):
+            EXPORT.decode_response(response(framed))
+
+    def test_system_public_data_is_opaque_but_selector_and_bounds_are_checked(self):
+        data = b"opaque public data, no point or DER assumption"
+        reply = bytearray(EXPORT.SYSTEM_HEADER.pack(1, 2, 2, len(data))
+                          + data.ljust(EXPORT.DER_MAX, b"\0"))
+        self.assertEqual(EXPORT.decode_system_key_response(reply, 2, 2), data)
+        self.assertEqual(EXPORT.SYSTEM_PUBLIC_KEY, 0xD010B10D)
+        with self.assertRaisesRegex(ValueError, "selector"):
+            EXPORT.decode_system_key_response(reply, 1, 1)
+        reply[-1] = 1
+        with self.assertRaisesRegex(ValueError, "unused"):
+            EXPORT.decode_system_key_response(reply, 2, 2)
+
+    def test_rejects_length_and_initialisation_failures(self):
+        invalid = [response(length=0), response(length=4097), response()[:-1]]
+        reserved = response()
+        reserved[73] = 1
+        invalid.append(reserved)
+        tail = response()
+        tail[-1] = 1
+        invalid.append(tail)
+        for data in invalid:
+            with self.subTest(length=len(data)):
+                with self.assertRaises(ValueError):
+                    EXPORT.decode_response(data)
+
+    def test_rejects_truncation_padding_and_noncanonical_der(self):
+        for data in [ENVELOPE[:-1], ENVELOPE + b"\0", b"\x30\x80\0\0",
+                     b"\x30\x81\x01\0", b"\x30\x82\0\x80" + bytes(128)]:
+            with self.subTest(data_length=len(data)):
+                with self.assertRaisesRegex(ValueError, "complete DER"):
+                    EXPORT.decode_response(response(data))
+
+    def test_saves_privately_and_never_overwrites_an_existing_bundle(self):
+        with tempfile.TemporaryDirectory() as root:
+            directory = Path(root) / "bundle"
+            EXPORT.save_bundle(directory, ENVELOPE, POINT)
+            self.assertEqual((directory / "attestation.der").read_bytes(), ENVELOPE)
+            self.assertEqual((directory / "public-key.x963").read_bytes(), POINT)
+            self.assertEqual(os.stat(directory).st_mode & 0o777, 0o700)
+            for path in directory.iterdir():
+                self.assertEqual(os.stat(path).st_mode & 0o777, 0o600)
+            with self.assertRaises(FileExistsError):
+                EXPORT.save_bundle(directory, b"replacement", POINT)
+            self.assertEqual((directory / "attestation.der").read_bytes(), ENVELOPE)
+
+
+if __name__ == "__main__":
+    unittest.main()
