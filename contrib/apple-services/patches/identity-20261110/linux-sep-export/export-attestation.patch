+/*
+ * Committed-UIK (system type 2, generation 2) attestation of the existing
+ * machine ref-key. Requires CAP_SYS_ADMIN in addition to device permissions.
+ * No key is created or replaced: an existing persisted reference is loaded
+ * read-only if needed; ENOKEY means it is absent. The 65-byte public point
+ * belongs to the exact target key
+ * passed to the enclave. DER is returned verbatim, without SEP IPC framing;
+ * encrypted attestation envelopes are valid results. No private key is exported.
+ * version is 1; all reserved bytes and unused DER bytes are zero on success.
+ * EOVERFLOW means the complete DER exceeds this API's fixed bound.
+ */
+#define SEP_BIO_EXPORT_ATTESTATION_MAX 4096
+struct sep_bio_export_attestation {
+	__u32 version;
+	__u32 der_len;
+	__u8 public_key[SEP_BIO_ATTEST_PUB_LEN];
+	__u8 reserved[7];
+	__u8 der[SEP_BIO_EXPORT_ATTESTATION_MAX];
+};
+
+/*
+ * Read-only system public data, requiring CAP_SYS_ADMIN. Input version=1,
+ * key_len=0, and only (system_key_type,generation)=(1,1) for SIK or (2,2)
+ * for committed UIK. Output key_len bytes are verbatim oskgp public data,
+ * stripped of SKS status/blob framing; no EC-point/DER encoding is implied.
+ * Unused data bytes are zero. This operation never creates or commits a key.
+ */
+struct sep_bio_system_public_key {
+	__u32 version;
+	__u32 system_key_type;
+	__u32 generation;
+	__u32 key_len;
+	__u8 data[SEP_BIO_EXPORT_ATTESTATION_MAX];
+};
