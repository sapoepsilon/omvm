 pub(crate) const REFKEY_ENVELOPE_VERSION: u32 = 2;
 
+// Validate only the envelope's DER framing. Its content may be encrypted and
+// must remain byte-for-byte intact for the attestation consumer.
+fn complete_attestation_der(der: &[u8]) -> bool {
+    if der.len() < 2 || der[0] != 0x30 {
+        return false;
+    }
+    let first = der[1];
+    let (header, len) = if first < 0x80 {
+        (2, usize::from(first))
+    } else {
+        let n = usize::from(first & 0x7f);
+        // The export is bounded to 4096 bytes; longer DER length fields cannot
+        // be canonical here. Also reject indefinite and overlong encodings.
+        if n == 0 || n > 2 || der.len() < 2 + n || der[2] == 0 {
+            return false;
+        }
+        let mut len = 0usize;
+        for byte in &der[2..2 + n] {
+            len = (len << 8) | usize::from(*byte);
+        }
+        if len < 128 {
+            return false;
+        }
+        (2 + n, len)
+    };
+    len != 0 && header + len == der.len()
+}
