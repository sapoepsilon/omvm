+impl<F: ListFile> Guard<F> {
+    /// Uses this boot’s window if it is open for `key`: a rewrite of a
+    /// kind-4 record at level 1, at most once.
+    fn take_window_for(&mut self, key: &Key) -> bool {
+        if key.kind != KIND_LOCKER || self.window_used {
+            return false;
+        }
+        if open_window().is_none() {
+            return false;
+        }
+        self.window_used = true;
+        true
+    }
+
+    /// How many records Linux's list holds now.
+    pub(crate) fn owned_len(&self) -> u64 {
+        self.owned.len() as u64
+    }
+
+    /// Why the write just allowed rewrites an existing record, if it does.
+    pub(crate) fn take_save_previous(&mut self) -> Option<Rewrite> {
+        self.save_previous.take()
+    }
+
+    /// The previous value could not be saved: the rewrite is refused after
+    /// all.
+    pub(crate) fn refuse_unsaved(&mut self, key: &Key, e: Error) {
+        crate::diag::xart_guard_refused();
+        self.refused += 1;
+        pr_warn!(
+            "xART guard: could not save kind-{} record {} before rewriting it ({:?}); refusing it\n",
+            key.kind,
+            Id(&key.uuid),
+            e
+        );
+    }
+}
